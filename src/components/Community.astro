---
import { Image } from "astro:assets";
import { getLangFromUrl, getTranslatedPath, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Import horizontal community images for the preview
import img1 from "@/assets/img/gente-afroin/gente-afroin-h-22.jpg";
import img2 from "@/assets/img/gente-afroin/gente-afroin-h-30.jpg";
import img3 from "@/assets/img/gente-afroin/gente-afroin-h-5.jpg";
import img4 from "@/assets/img/gente-afroin/gente-afroin-h-10.jpg";
import img5 from "@/assets/img/gente-afroin/gente-afroin-h-15.jpg";
import img6 from "@/assets/img/gente-afroin/gente-afroin-h-20.jpg";

const previewImages = [img1, img2, img3, img4, img5, img6];
---

<section class="hm-section community-section" id="comunidad" aria-labelledby="community-title">
  <div class="fz-wrap">
    <header class="hm-head">
      <p class="fz-display hm-kicker">{t("community.badge")}</p>
      <h2 id="community-title" class="fz-display hm-title">{t("community.title")}</h2>
      <p class="hm-sub">{t("community.desc")}</p>
    </header>

    <div class="preview-grid">
      {
        previewImages.map((img, i) => (
          <Image
            src={img}
            alt={`${t("community.alt")} ${i + 1}`}
            widths={[400, 800]}
            sizes="(max-width: 900px) 50vw, 380px"
            class="preview-img"
            loading="lazy"
          />
        ))
      }
    </div>

    <div class="hm-actions">
      <a href={getTranslatedPath("/comunidad", lang)} class="fz-button">{t("community.cta")}</a>
    </div>
  </div>
</section>

<style>
  .preview-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .preview-grid :global(.preview-img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .preview-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
  }
</style>
