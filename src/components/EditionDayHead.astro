---
// Heading of one day: "2 / 3", heart + weekday, big date.
interface Props {
  index: number;
  total: number;
  weekdayLong: string;
  dayMonth: string;
  headingLevel?: "h2" | "h3";
}

const { index, total, weekdayLong, dayMonth, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
const heart = index % 2 === 0 ? "var(--fz-red)" : "var(--fz-teal)";
---

<header class="fz-dayhead">
  <p class="fz-day-count">{index + 1} / {total}</p>
  <div class="fz-day-weekday">
    <svg width="24" height="22" viewBox="0 0 24 22" aria-hidden="true">
      <path d="M12 21s-9-5.6-9-12a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 6.4-9 12-9 12z" fill={heart}></path>
    </svg>
    <span class="fz-display fz-gold">{weekdayLong}</span>
  </div>
  <Heading class="fz-display fz-day-date">{dayMonth}</Heading>
</header>
