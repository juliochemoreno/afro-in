---
// "Dos territorios": the edition's stops as two full-width photo cards side by side (stacked below
// 1024px). Used by the edition listing and by the home page; needs the `.fz` tokens around it.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Pin from "@/components/Pin.astro";
import { useTranslations } from "@/i18n/utils";
import type { Lang } from "@/lib/programacion";

interface Props {
  stops: { href: string; name: string; range: string; place: string; comingSoon: boolean; cardImage: ImageMetadata; cardPosition: string }[];
  lang: Lang;
}

const { stops, lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="edition-stops">
  {stops.map((stop) => (
    <a class="edition-stop" href={stop.href}>
      <Image src={stop.cardImage} alt="" widths={[480, 960]} sizes="(max-width: 1023px) 100vw, 50vw" class="edition-stop-photo" style={`object-position: ${stop.cardPosition}`} />
      <span class="edition-stop-bottom">
        <span class="edition-stop-range">{stop.range}</span>
        <span class="fz-display edition-stop-name">{stop.name}</span>
        <span class="edition-stop-place"><Pin /><span>{stop.place}</span></span>
        <span class="edition-stop-cta">
          {stop.comingSoon ? t("edition.comingSoon") : t("edition.viewProgram")}
          <span class="edition-stop-arrow" aria-hidden="true">→</span>
        </span>
      </span>
    </a>
  ))}
</div>

<style>
.edition-stop-photo {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 10%, #000 90%, transparent 100%);
  mask-image: linear-gradient(to bottom, transparent 0, #000 10%, #000 90%, transparent 100%);
}

.edition-stops {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

/* Full screen width: two photos side by side with a small gap, faded only at the top and the
   bottom; the outer screen edges stay sharp. Text scales with the cards. */
.edition-stop {
  position: relative;
  display: block;
  height: clamp(480px, 70svh, 85svh);
  overflow: hidden;
  background: transparent;
  border: 0;
  box-shadow: none;
  text-decoration: none;
}

.fz .edition-stop {
  color: var(--fz-text);
}

.edition-stop::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(transparent 45%, rgba(14, 10, 8, 0.85));
  -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 10%, #000 90%, transparent 100%);
  mask-image: linear-gradient(to bottom, transparent 0, #000 10%, #000 90%, transparent 100%);
}

.edition-stop-bottom {
  position: absolute;
  z-index: 2;
  bottom: 10%;
  left: var(--fz-bleed);
  right: 24px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.edition-stop:last-child .edition-stop-bottom {
  left: clamp(24px, 4vw, 64px);
  right: clamp(24px, 3vw, 48px);
}

.edition-stop-range {
  color: #e6b84a;
  font-weight: 500;
  font-size: clamp(15px, 1.4vw, 18px);
}

.edition-stop-name {
  font-size: clamp(32px, 4vw, 64px);
  line-height: 1.05;
  white-space: nowrap;
  color: #ffffff;
}

.edition-stop-place {
  display: flex;
  align-items: center;
  font-size: clamp(14px, 1.25vw, 16px);
  color: #bfb39c;
  min-width: 0;
}

.edition-stop-place span {
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* The visible "open" cue: a square cream button that turns gold on hover. */
.edition-stop-cta {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-top: 10px;
  padding: 10px 16px;
  border: 1px solid rgba(255, 255, 255, 0.7);
  background: rgba(14, 10, 8, 0.45);
  color: #ffffff;
  font-weight: 600;
  font-size: clamp(14px, 1.2vw, 16px);
  transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
}

.edition-stop-arrow {
  line-height: 1;
  transition: transform 0.2s ease;
}

.edition-stop:hover .edition-stop-cta,
.edition-stop:focus-visible .edition-stop-cta {
  background: #e6b84a;
  border-color: #e6b84a;
  color: #161616;
}

.edition-stop:hover .edition-stop-arrow,
.edition-stop:focus-visible .edition-stop-arrow {
  transform: translateX(4px);
}

.edition-stop-photo {
  transition: transform 0.6s ease;
}

.edition-stop:hover .edition-stop-photo,
.edition-stop:focus-visible .edition-stop-photo {
  transform: scale(1.03);
}

.edition-stop:focus-visible {
  outline: 2px solid #e6b84a;
  outline-offset: 3px;
}

@media (prefers-reduced-motion: reduce) {
  .edition-stop-arrow,
  .edition-stop-cta,
  .edition-stop-photo {
    transition: none;
  }

  .edition-stop:hover .edition-stop-photo {
    transform: none;
  }
}

/* Stacked, edge to edge, below 1024px (side by side the halves would be too narrow and tall). */
@media (max-width: 1023px) {
  .edition-stops {
    grid-template-columns: minmax(0, 1fr);
  }

  .edition-stop {
    height: auto;
    aspect-ratio: 16 / 10;
  }

  .edition-stop .edition-stop-bottom,
  .edition-stop:last-child .edition-stop-bottom {
    left: var(--fz-bleed);
    right: var(--fz-bleed);
  }
}
</style>
