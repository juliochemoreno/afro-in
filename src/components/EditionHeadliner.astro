---
// The edition's star artist: big photo, name and every date.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { useTranslations } from "@/i18n/utils";
import { flagEmoji, type Lang } from "@/lib/programacion";

interface Props {
  artist: { name: string; countryCode: string; country: Record<Lang, string>; photo: ImageMetadata };
  appearances: { when: string; where: string; title: string; href: string }[];
  lang: Lang;
  moreHref?: string;
}

const { artist, appearances, lang, moreHref } = Astro.props;
const t = useTranslations(lang);
---

<section class="fz-frame fz-headliner" aria-labelledby="fz-headliner-name" style="scroll-margin-top: 100px">
  <div class="fz-frame-inner fz-headliner-inner">
    <Image
      src={artist.photo}
      alt={artist.name}
      widths={[480, 960]}
      sizes="(max-width: 720px) 100vw, 460px"
      class="fz-headliner-photo"
    />
    <div class="fz-headliner-body">
      <p class="fz-display fz-headliner-kicker">{t("edition.headliner")}</p>
      <h2 id="fz-headliner-name" class="fz-display fz-headliner-name">{artist.name}</h2>
      <p class="fz-headliner-country">
        <span class="fz-flag" aria-hidden="true">{flagEmoji(artist.countryCode)}</span>
        {artist.country[lang]}
      </p>
      {appearances.length > 0 && (
        <ul class="fz-headliner-dates">
          {appearances.map((a) => (
            <li>
              <a href={a.href}>
                <span class="fz-display fz-gold">{a.when}</span>
                <span>{a.where}</span>
                <span class="fz-muted">{a.title}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
      {moreHref && <a class="fz-button fz-headliner-more" href={moreHref}>{t("edition.seeAllArtists")}</a>}
    </div>
    {Astro.slots.has("default") && (
      <div class="fz-headliner-extra">
        <slot />
      </div>
    )}
  </div>
</section>
