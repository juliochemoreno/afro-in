---
// The edition's star artist: big photo, name and every date.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { useTranslations } from "@/i18n/utils";
import Pin from "@/components/Pin.astro";
import Flag from "@/components/Flag.astro";
import DayCalendar from "@/components/DayCalendar.astro";
import SpotifyPlayer from "@/components/SpotifyPlayer.astro";
import { dayLabel, type Lang } from "@/lib/programacion";

interface Props {
  artist: { name: string; countryCode?: string; country?: Record<Lang, string>; photo: ImageMetadata; photoMobile?: ImageMetadata; photoPosition?: string; spotifyArtistId?: string };
  // `date` (ISO) shows the gold calendar block; `when` stays as the readable date for screen readers.
  appearances: { date?: string; when: string; where: string; title: string; href: string }[];
  lang: Lang;
  // The artists page repeats this block for every artist: `star` shows the "Artista estrella" label,
  // `reverse` puts the photo on the right, `center` centres the text beside the photo, `id` keeps headings unique.
  star?: boolean;
  reverse?: boolean;
  center?: boolean;
  // Phones use the vertical portrait too (the artists page keeps it pinned while the text scrolls over it).
  portrait?: boolean;
  id?: string;
}

const { artist, appearances, lang, star = true, reverse = false, center = false, portrait = false, id = "fz-headliner-name" } = Astro.props;
const t = useTranslations(lang);

// A tall panel beside the text on desktop; on phones a 16:10 band on top (the horizontal photo, when there is one).
const desktop = await getImage({ src: artist.photo, widths: [480, 960, 1440], format: "webp" });
const mobile = await getImage({ src: artist.photoMobile ?? artist.photo, widths: [768, 1440], format: "webp" });
---

<section class:list={["fz-headliner", { "fz-headliner--reverse": reverse, "fz-headliner--center": center }]} aria-labelledby={id} style="scroll-margin-top: 100px">
  <div class="fz-headliner-inner">
    <div class="fz-headliner-media">
      <picture>
        {!portrait && <source media="(max-width: 1023px)" srcset={mobile.srcSet.attribute} sizes="100vw" />}
        <img
          src={desktop.src}
          srcset={desktop.srcSet.attribute}
          sizes="(max-width: 1023px) 100vw, 50vw"
          width={desktop.attributes.width}
          height={desktop.attributes.height}
          alt={artist.name}
          class="fz-headliner-photo"
          style={`object-position: ${artist.photoPosition ?? "50% 20%"}`}
          loading="lazy"
          decoding="async"
        />
      </picture>
      {artist.spotifyArtistId && <SpotifyPlayer artistId={artist.spotifyArtistId} name={artist.name} lang={lang} placement="photo" />}
    </div>
    <div class="fz-headliner-side">
    <div class="fz-headliner-body">
      {star && <p class="fz-display fz-headliner-kicker">{t("edition.headliner")}</p>}
      <h2 id={id} class="fz-display fz-headliner-name">{artist.name}</h2>
      {artist.countryCode && artist.country && (
        <p class="fz-headliner-country">
          <Flag code={artist.countryCode} name={artist.country[lang]} />{artist.country[lang]}
        </p>
      )}
      {appearances.length > 0 && (
        <ul class="fz-headliner-dates">
          {appearances.map((a) => (
            <li>
              <a href={a.href} class:list={{ "fz-headliner-date--cal": a.date }}>
                {a.date ? (
                  <span class="fz-headliner-cal">
                    <DayCalendar weekday={dayLabel(a.date, lang).weekdayShort} number={dayLabel(a.date, lang).dayNumber} />
                    <span class="sr-only">{a.when}</span>
                  </span>
                ) : (
                  <span class="fz-display fz-gold">{a.when}</span>
                )}
                <span class="fz-headliner-where"><Pin /><span>{a.where}</span></span>
                <span class="fz-muted">{a.title}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
      {artist.spotifyArtistId && <SpotifyPlayer artistId={artist.spotifyArtistId} name={artist.name} lang={lang} placement="text" />}
    </div>
    {Astro.slots.has("default") && (
      <div class="fz-headliner-extra">
        <slot />
      </div>
    )}
    </div>
  </div>
</section>
