---
// The edition's star artist: big photo, name and every date.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { useTranslations } from "@/i18n/utils";
import Pin from "@/components/Pin.astro";
import Flag from "@/components/Flag.astro";
import type { Lang } from "@/lib/programacion";

interface Props {
  artist: { name: string; countryCode: string; country: Record<Lang, string>; photo: ImageMetadata; photoMobile?: ImageMetadata; photoPosition?: string };
  appearances: { when: string; where: string; title: string; href: string }[];
  lang: Lang;
}

const { artist, appearances, lang } = Astro.props;
const t = useTranslations(lang);

// A tall panel beside the text on desktop; on phones a 16:10 band on top (the horizontal photo, when there is one).
const desktop = await getImage({ src: artist.photo, widths: [480, 960, 1440], format: "webp" });
const mobile = await getImage({ src: artist.photoMobile ?? artist.photo, widths: [768, 1440], format: "webp" });
---

<section class="fz-headliner" aria-labelledby="fz-headliner-name" style="scroll-margin-top: 100px">
  <div class="fz-headliner-inner">
    <div class="fz-headliner-media">
      <picture>
        <source media="(max-width: 1023px)" srcset={mobile.srcSet.attribute} sizes="100vw" />
        <img
          src={desktop.src}
          srcset={desktop.srcSet.attribute}
          sizes="(max-width: 1023px) 100vw, 50vw"
          width={desktop.attributes.width}
          height={desktop.attributes.height}
          alt={artist.name}
          class="fz-headliner-photo"
          style={`object-position: ${artist.photoPosition ?? "50% 20%"}`}
          loading="lazy"
          decoding="async"
        />
      </picture>
    </div>
    <div class="fz-headliner-side">
    <div class="fz-headliner-body">
      <p class="fz-display fz-headliner-kicker">{t("edition.headliner")}</p>
      <h2 id="fz-headliner-name" class="fz-display fz-headliner-name">{artist.name}</h2>
      <p class="fz-headliner-country">
        <Flag code={artist.countryCode} name={artist.country[lang]} />{artist.country[lang]}
      </p>
      {appearances.length > 0 && (
        <ul class="fz-headliner-dates">
          {appearances.map((a) => (
            <li>
              <a href={a.href}>
                <span class="fz-display fz-gold">{a.when}</span>
                <span class="fz-headliner-where"><Pin /><span>{a.where}</span></span>
                <span class="fz-muted">{a.title}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
    {Astro.slots.has("default") && (
      <div class="fz-headliner-extra">
        <slot />
      </div>
    )}
    </div>
  </div>
</section>
