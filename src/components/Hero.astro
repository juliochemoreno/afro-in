---
// Home hero in the festival language: the children photo as a tall panel bleeding to the left
// screen edge (same block as the /programacion headliner), the "1 Millón de Corazones" title,
// the hearts counter against the goal, and the join button. Needs the `.fz` tokens around it.
import { Image } from "astro:assets";
import heroMain from "../assets/img/hero-main.jpg";
import {
  getLangFromUrl,
  useTranslations,
  getTranslatedPath,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
  targetCount?: number;
}

const { targetCount = 12847 } = Astro.props;
const locale = lang === "en" ? "en-US" : lang === "fr" ? "fr-FR" : "es-CO";
---

<section
  class="fz-headliner fz-headliner--center hm-hero"
  id="inicio"
  aria-labelledby="hero-title"
>
  <div class="fz-wrap">
    <div class="fz-headliner-inner">
      <div class="fz-headliner-media">
        <picture>
          <Image
            src={heroMain}
            alt={t("hero.img.alt")}
            widths={[700, 1100, 1500]}
            sizes="(max-width: 1023px) 100vw, 50vw"
            class="fz-headliner-photo"
            style="object-position: 62% 40%"
            loading="eager"
            fetchpriority="high"
          />
        </picture>
      </div>
      <div class="fz-headliner-side">
        <div class="fz-headliner-body">
          <p class="fz-display fz-headliner-kicker">{t("hero.badge")}</p>
          <h1 id="hero-title" class="fz-display fz-headliner-name">
            {t("hero.title.part1")} {t("hero.title.part2")} {t("hero.title.part3")}
          </h1>
          <p class="hero-lead">{t("hero.description")}</p>

          <div class="hero-goal">
            <p class="hero-goal-count">
              <span class="fz-display counter-number" data-hero-count data-target={targetCount} data-locale={locale}>
                {targetCount.toLocaleString(locale)}
              </span>
              <span>{t("hero.counter.goal")}</span>
            </p>
            <div class="hero-goal-track" aria-hidden="true">
              <span class="hero-goal-bar" data-hero-bar style={`width: ${(targetCount / 1000000) * 100}%`}></span>
            </div>
          </div>

          <div class="hero-actions">
            <a class="fz-button fz-button-solid" href={getTranslatedPath("/#unirse", lang)}>
              {t("hero.cta.join")}
            </a>
            <a class="hm-textlink hero-more" href={getTranslatedPath("/#sobre", lang)}>
              {t("hero.cta.more")}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener("astro:page-load", () => {
      const counterElement = document.querySelector<HTMLElement>("[data-hero-count]");
      const progressBar = document.querySelector<HTMLElement>("[data-hero-bar]");

      if (counterElement) {
        const locale = counterElement.dataset.locale || "es-CO";

        // Count up from 0 to the real total (easeOutExpo, 2 s).
        const animateCounter = (target: number) => {
          const duration = 2000;
          const startTime = performance.now();

          function updateCounter(currentTime: number) {
            const progress = Math.min((currentTime - startTime) / duration, 1);
            const ease = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
            counterElement!.textContent = Math.floor(ease * target).toLocaleString(locale);
            if (progress < 1) requestAnimationFrame(updateCounter);
          }

          requestAnimationFrame(updateCounter);
        };

        fetch("/api/contador")
          .then((res) => res.json())
          .then((data: any) => {
            const total = data.total || 0;
            counterElement.setAttribute("data-target", total.toString());
            if (progressBar) {
              progressBar.style.width = `${Math.min((total / 1000000) * 100, 100)}%`;
            }
            animateCounter(total);
          })
          .catch((err) => {
            console.error("Error fetching counter:", err);
            animateCounter(parseInt(counterElement.getAttribute("data-target") || "0"));
          });
      }
    });
  </script>
</section>

<style>
  .hm-hero {
    padding: 12px 0 56px;
  }

  .hero-lead {
    max-width: 520px;
    margin: 18px 0 22px;
    font-size: 19px;
    line-height: 1.55;
    color: #e9e2d2;
  }

  .hero-goal {
    max-width: 460px;
    margin: 0 0 28px;
  }

  .hero-goal-count {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    margin: 0 0 10px;
    color: var(--fz-muted);
  }

  .hero-goal-count .fz-display {
    font-size: 44px;
    line-height: 1;
    color: var(--fz-gold);
  }

  .hero-goal-track {
    height: 6px;
    background: rgba(255, 255, 255, 0.18);
  }

  /* The real share is tiny (around 1 %): a minimum width keeps the bar visible. */
  .hero-goal-bar {
    display: block;
    height: 100%;
    min-width: 6px;
    max-width: 100%;
    background: var(--fz-gold);
    transition: width 2s ease-out;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 28px;
  }

  .hero-more {
    color: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-goal-bar {
      transition: none;
    }
  }
</style>
