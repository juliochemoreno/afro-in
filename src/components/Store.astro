---
import FeaturedProducts from "./FeaturedProducts.astro";
import {
  getLangFromUrl,
  useTranslations,
  getTranslatedPath,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hm-section hm-section--alt store" id="tienda" aria-labelledby="store-title">
  <div class="fz-wrap">
    <header class="hm-head">
      <p class="fz-display hm-kicker">{t("store.hero.badge")}</p>
      <h2 id="store-title" class="fz-display hm-title">{t("store.hero.title")}</h2>
      <p class="hm-sub">{t("store.hero.description")}</p>
    </header>

    <FeaturedProducts server:defer lang={lang}>
      <div slot="fallback" class="store-fallback"></div>
    </FeaturedProducts>

    <div class="hm-actions">
      <a class="fz-button fz-button-solid" href={getTranslatedPath("/tienda", lang)}>
        {t("store.home.all")}
      </a>
    </div>

    <p class="store-note">
      <strong>{t("store.note.title")}</strong>
      {t("store.note.description")}
      <a href={getTranslatedPath("/#contacto", lang)}>{t("store.note.contact")}</a>
    </p>
  </div>
</section>

<style>
  .store-fallback {
    min-height: 320px;
  }

  .store-note {
    max-width: 640px;
    margin: 32px auto 0;
    font-size: 15px;
    line-height: 1.55;
    text-align: center;
    color: #cfc8b6;
  }

  .store-note strong {
    color: #fff;
  }

  .store-note a {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
