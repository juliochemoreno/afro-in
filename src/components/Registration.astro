---
import { countries } from "../data/countries";
import CountryCombobox from "./CountryCombobox";
import PhoneField from "./checkout/PhoneField";
import User from "lucide-astro/User";
import Mail from "lucide-astro/Mail";
import "../styles/checkout-fields.css";
import {
  getLangFromUrl,
  useTranslations,
  getTranslatedPath,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
  currentCount?: number;
}

const { currentCount = 12847 } = Astro.props;
const thanksUrl = getTranslatedPath("/gracias", lang);
---

<section class="hm-section registration" id="unirse" aria-labelledby="join-title">
  <div class="fz-wrap">
    <div class="registration-wrapper">
      <div class="registration-content">
        <p class="fz-display hm-kicker">{t("join.badge")}</p>
        <h2 id="join-title" class="fz-display hm-title">
          {t("join.title.part1")} {t("join.title.part2")}
        </h2>

        <p class="registration-description" set:html={t("join.description")} />

        <ul class="hm-list benefits-list">
          <li>{t("join.benefit.1")}</li>
          <li>{t("join.benefit.2")}</li>
          <li>{t("join.benefit.3")}</li>
          <li>{t("join.benefit.4")}</li>
          <li>{t("join.benefit.5")}</li>
        </ul>
      </div>

      <div class="registration-form-wrapper">
        <div class="form-card">
          <form
            class="registration-form"
            id="registrationForm"
            data-t-country-error={t("join.country.error")}
            data-t-toast-success={t("join.toast.success")}
            data-t-toast-error={t("join.toast.error")}
            data-t-redirect-url={thanksUrl}
            data-t-amount-min={t("join.form.amount.min")}
            data-t-secure-paypal={t("join.form.secure.paypal")}
            data-t-secure-bold={t("join.form.secure.bold")}
            data-t-error-name={t("join.error.name")}
            data-t-error-email={t("join.error.email")}
            data-t-error-country={t("join.error.country")}
            data-t-error-phone={t("phone.err")}
            data-t-error-generic={t("join.error.generic")}
          >
            <!-- STEP 1: CONTACT INFO -->
            <div class="form-step active" id="step1">
              <div class="step-header">
                <span class="step-indicator">{t("join.step1")}</span>
                <h3>{t("join.form.title")}</h3>
              </div>

              <div class="form-group">
                <label for="name">{t("join.form.name")}</label>
                <span class="hm-input-icon">
                  <User size={18} aria-hidden="true" />
                  <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder={t("join.form.name.placeholder")}
                    required
                  />
                </span>
              </div>

              <div class="form-group">
                <label for="email">{t("join.form.email")}</label>
                <span class="hm-input-icon">
                  <Mail size={18} aria-hidden="true" />
                  <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder={t("join.form.email.placeholder")}
                    required
                  />
                </span>
              </div>

              <div class="form-group">
                <label for="phone-number">{t("join.form.phone")}</label>
                <PhoneField
                  client:visible
                  lang={lang}
                  countries={countries}
                  inputId="phone-number"
                  hiddenInputId="phone"
                  hiddenName="phone"
                  followCountryInputId="country"
                  placeholder={t("phone.ph")}
                  dialLabel={t("phone.dial.label")}
                  searchPlaceholder={t("phone.dial.search")}
                  emptyText={t("phone.dial.empty")}
                />
              </div>

              <div class="form-group">
                <label for="country">{t("join.form.country")}</label>
                <CountryCombobox
                  client:visible
                  lang={lang}
                  countries={countries}
                  placeholder={t("join.form.country.select")}
                  searchPlaceholder={t("join.country.search")}
                  emptyText={t("join.country.error")}
                />
              </div>

              <button
                type="button"
                class="btn btn-primary btn-block"
                id="btnNext"
              >
                {t("join.form.next")}
              </button>
            </div>

            <!-- STEP 2: DONATION -->
            <div class="form-step" id="step2">
              <div class="step-header">
                <button type="button" class="btn-back" id="btnBack"
                  >{t("join.form.back")}</button
                >
                <span class="step-indicator">{t("join.step2")}</span>
                <h3>{t("join.form.donate.title")}</h3>
              </div>

              <!-- Payment method selector -->
              <p class="form-question">{t("join.q.method")}</p>
              <div
                class="method-selector"
                role="tablist"
                aria-label={t("join.method.label")}
              >
                <button
                  type="button"
                  class="method-tab active"
                  data-method="bold"
                  role="tab"
                  aria-selected="true"
                >
                  <span class="method-logo">
                    <span class="method-logo-bold">bold</span>
                  </span>
                  <span class="method-text">
                    <span class="method-name">{t("join.method.bold")}</span>
                    <span class="method-hint">{t("join.method.bold.hint")}</span>
                  </span>
                </button>
                <button
                  type="button"
                  class="method-tab"
                  data-method="paypal"
                  role="tab"
                  aria-selected="false"
                >
                  <span class="method-logo">
                    <svg
                      viewBox="0 0 24 24"
                      width="26"
                      height="26"
                      aria-hidden="true"
                    >
                      <path
                        fill="#003087"
                        d="M7.076 21.337H2.47a.641.641 0 0 1-.633-.74L4.944.901C5.026.382 5.474 0 5.998 0h7.46c2.57 0 4.578.543 5.69 1.81 1.01 1.15 1.304 2.42 1.012 4.287-.023.143-.047.288-.077.437-.983 5.05-4.349 6.797-8.647 6.797h-2.19c-.524 0-.968.382-1.05.9l-1.12 7.106zm14.146-14.42a3.35 3.35 0 0 0-.607-.541c-.013.076-.026.175-.041.254-.93 4.778-4.005 7.201-9.138 7.201h-2.19a.563.563 0 0 0-.556.479l-1.187 7.527h-.506l-.24 1.516a.56.56 0 0 0 .554.647h3.882c.46 0 .85-.334.922-.788.06-.26.76-4.852.816-5.09a.932.932 0 0 1 .923-.788h.58c3.76 0 6.705-1.528 7.565-5.946.36-1.847.174-3.388-.777-4.471z"
                      ></path>
                    </svg>
                  </span>
                  <span class="method-text">
                    <span class="method-name">{t("join.method.paypal")}</span>
                    <span class="method-hint"
                      >{t("join.method.paypal.hint")}</span
                    >
                  </span>
                </button>
              </div>

              <!-- Amount question (shared across methods) -->
              <p class="form-question">{t("join.q.amount")}</p>

              <!-- BOLD amounts (COP) -->
              <div class="form-donation" data-method-panel="bold">
                <div class="donation-options">
                  <label class="donation-option">
                    <input type="radio" name="amount_bold" value="20000" checked />
                    <span class="option-content">
                      <span class="option-amount">$5 USD</span>
                      <span class="option-desc">≈ $20.000 COP</span>
                    </span>
                  </label>
                  <label class="donation-option">
                    <input type="radio" name="amount_bold" value="40000" />
                    <span class="option-content">
                      <span class="option-amount">$10 USD</span>
                      <span class="option-desc">≈ $40.000 COP</span>
                    </span>
                  </label>
                  <label class="donation-option">
                    <input type="radio" name="amount_bold" value="100000" />
                    <span class="option-content">
                      <span class="option-amount">$25 USD</span>
                      <span class="option-desc">≈ $100.000 COP</span>
                    </span>
                  </label>
                  <label class="donation-option custom">
                    <input type="radio" name="amount_bold" value="custom" />
                    <span class="option-content">
                      <span class="option-amount"
                        >{t("join.form.donate.other")}</span
                      >
                      <span class="amount-input-group">
                        <span class="amount-input-prefix">$</span>
                        <input
                          type="number"
                          class="custom-amount-bold"
                          inputmode="decimal"
                          placeholder="5"
                          min="5"
                          step="1"
                        />
                        <span class="amount-input-suffix">USD</span>
                      </span>
                      <span
                        class="option-desc custom-usd-hint"
                        id="boldCustomUsd"></span>
                    </span>
                  </label>
                </div>

                <label class="fee-cover">
                  <input type="checkbox" id="boldCoverFee" checked />
                  <span class="fee-cover-text">
                    {t("join.fee.cover")}
                    <span class="fee-cover-amount" id="boldFeeAmount"></span>
                  </span>
                </label>
              </div>

              <!-- PAYPAL amounts (USD) -->
              <div class="form-donation" data-method-panel="paypal" hidden>
                <div class="donation-options">
                  <label class="donation-option">
                    <input type="radio" name="amount" value="5" checked />
                    <span class="option-content">
                      <span class="option-amount">$5 USD</span>
                      <span class="option-desc">~20,000 COP</span>
                    </span>
                  </label>
                  <label class="donation-option">
                    <input type="radio" name="amount" value="10" />
                    <span class="option-content">
                      <span class="option-amount">$10 USD</span>
                      <span class="option-desc">~40,000 COP</span>
                    </span>
                  </label>
                  <label class="donation-option">
                    <input type="radio" name="amount" value="25" />
                    <span class="option-content">
                      <span class="option-amount">$25 USD</span>
                      <span class="option-desc">~100,000 COP</span>
                    </span>
                  </label>
                  <label class="donation-option custom">
                    <input type="radio" name="amount" value="custom" />
                    <span class="option-content">
                      <span class="option-amount"
                        >{t("join.form.donate.other")}</span
                      >
                      <span class="amount-input-group">
                        <span class="amount-input-prefix">$</span>
                        <input
                          type="number"
                          class="custom-amount"
                          inputmode="decimal"
                          placeholder="5"
                          min="5"
                          step="1"
                        />
                        <span class="amount-input-suffix">USD</span>
                      </span>
                    </span>
                  </label>
                </div>
              </div>

              <!-- Bold pay button (COP) -->
              <div id="bold-pay-container" data-method-panel="bold">
                <button
                  type="button"
                  class="btn btn-primary btn-block"
                  id="btnBoldPay"
                >
                  {t("join.method.bold")} →
                </button>
              </div>

              <!-- PayPal Donate Button Container (USD) -->
              <div id="paypal-donate-container" data-method-panel="paypal" hidden>
              </div>

              <p class="form-note" id="secureNote">
                {t("join.form.secure.bold")}
              </p>
            </div>
          </form>
        </div>
      </div>
    </div>

    <style>
      /* Two dark halves (as the old light/dark split): the text on the page colour, the form on a lighter one. */
      .registration {
        position: relative;
        overflow: hidden;
      }

      .registration::before {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 50%;
        height: 100%;
        background: #1b1b1b;
      }

      .registration-wrapper {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: clamp(32px, 6vw, 96px);
        align-items: center;
      }

      .registration-content .hm-title {
        margin-bottom: 18px;
      }

      .registration-description {
        margin: 0 0 22px;
        font-size: 18px;
        line-height: 1.55;
        color: #e9e2d2;
      }

      .registration-description :global(strong) {
        color: var(--fz-gold);
      }

      .form-card {
        display: flex;
        align-items: center;
        min-height: 400px;
        padding: 32px;
        background: #222;
        border: 1px solid #2e2e2e;
      }

      .registration-form {
        width: 100%;
      }

      .form-step {
        display: none;
        animation: fadeIn 0.3s ease-in-out;
      }

      .form-step.active {
        display: block;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .step-header {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 4px 12px;
        margin-bottom: 22px;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
      }

      .step-indicator {
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--fz-gold);
      }

      .step-header h3 {
        margin: 0;
        font-family: "Anton", sans-serif;
        font-weight: 400;
        font-size: 26px;
        color: #fff;
      }

      .btn-back {
        padding: 0;
        border: none;
        background: none;
        color: #cfc8b6;
        font-size: 14px;
        text-decoration: underline;
        cursor: pointer;
      }

      .btn-back:hover {
        color: var(--fz-gold);
      }

      .form-group {
        margin-bottom: 16px;
      }

      .form-group label {
        display: block;
        margin-bottom: 6px;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #cfc8b6;
      }

      .form-group input,
      .form-group select,
      .registration :global(.cc-trigger:not(.ph-dial)),
      .registration :global(.ph-field) {
        width: 100%;
        min-height: 48px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 0;
        background: rgba(0, 0, 0, 0.3);
        color: #fff;
        font-family: inherit;
        font-size: 16px;
      }

      .form-group input,
      .form-group select {
        padding: 0 14px;
      }

      .form-group .hm-input-icon input {
        padding-left: 42px;
      }

      .form-group input::placeholder,
      .registration :global(.cc-trigger .cc-placeholder) {
        color: #8f8878;
      }

      .form-group input:focus,
      .form-group select:focus,
      .registration :global(.cc-trigger:not(.ph-dial):focus-visible),
      .registration :global(.cc-trigger[aria-expanded="true"]:not(.ph-dial)),
      .registration :global(.ph-field:focus-within) {
        outline: none;
        border-color: var(--fz-gold);
        box-shadow: 0 0 0 3px rgba(242, 193, 78, 0.2);
      }

      .registration :global(.ph-field .cc-trigger.ph-dial) {
        border-radius: 0;
        border-right: 1px solid rgba(255, 255, 255, 0.3);
        background: transparent;
        color: #fff;
      }

      .registration :global(.ph-field .cc-trigger.ph-dial:hover),
      .registration :global(.ph-field .cc-trigger.ph-dial[aria-expanded="true"]) {
        background: rgba(255, 255, 255, 0.06);
      }

      .registration :global(.ph-field input.ph-number) {
        min-height: 46px;
        border: none;
        background: transparent;
        color: #fff;
        box-shadow: none;
      }

      .registration :global(.is-invalid .ph-field),
      .registration :global(.form-group.is-invalid input:not([type="hidden"]):not(.ph-number)) {
        border-color: #ff6b62;
        background-color: rgba(208, 52, 44, 0.12);
      }

      .registration :global(.field-error) {
        color: #ff8a82;
      }

      /* Primary actions ("Continuar", Bold pay): square red buttons. */
      .btn-block {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 52px;
        margin-top: 16px;
        border: 0;
        border-radius: 0;
        background: var(--fz-red);
        color: #fff;
        font-family: inherit;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: none;
        transition: filter 0.2s ease;
      }

      .btn-block:hover,
      .btn-block:focus-visible {
        filter: brightness(1.1);
        transform: none;
      }

      .form-donation {
        margin-bottom: 8px;
      }

      .form-question {
        margin: 20px 0 10px;
        font-size: 15px;
        font-weight: 600;
        color: #fff;
      }

      .form-question:first-of-type {
        margin-top: 0;
      }

      .method-selector {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
      }

      .method-tab {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 0;
        background: transparent;
        color: #fff;
        font-family: inherit;
        text-align: left;
        cursor: pointer;
        transition: border-color 0.2s ease, background-color 0.2s ease;
      }

      .method-tab:hover {
        border-color: rgba(255, 255, 255, 0.6);
      }

      .method-tab.active {
        border-color: var(--fz-gold);
        background: rgba(242, 193, 78, 0.08);
      }

      .method-logo {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 40px;
        height: 40px;
        background: #fff;
      }

      .method-logo-bold {
        font-size: 15px;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: #161616;
      }

      .method-text {
        display: grid;
        gap: 2px;
        min-width: 0;
      }

      .method-tab .method-name {
        font-size: 15px;
        font-weight: 600;
      }

      .method-tab .method-hint {
        font-size: 12px;
        line-height: 1.3;
        color: #cfc8b6;
      }

      #bold-pay-container {
        width: 100%;
        margin: 16px 0 8px;
      }

      .donation-options {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
      }

      .donation-option input[type="radio"] {
        display: none;
      }

      .option-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        min-height: 96px;
        padding: 14px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        cursor: pointer;
        transition: border-color 0.2s ease, background-color 0.2s ease;
      }

      .donation-option input:checked + .option-content {
        border-color: var(--fz-gold);
        background: rgba(242, 193, 78, 0.1);
      }

      .option-amount {
        font-family: "Anton", sans-serif;
        font-weight: 400;
        font-size: 24px;
        color: #fff;
      }

      .option-desc {
        font-size: 13px;
        color: #cfc8b6;
      }

      /* Custom amount input group (shared by PayPal & Bold "Otro") */
      .amount-input-group {
        display: flex;
        align-items: center;
        width: 100%;
        max-width: 180px;
        margin-top: 8px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        background: rgba(0, 0, 0, 0.3);
        overflow: hidden;
      }

      .amount-input-group:focus-within {
        border-color: var(--fz-gold);
      }

      .amount-input-prefix,
      .amount-input-suffix {
        display: flex;
        align-items: center;
        align-self: stretch;
        padding: 0 8px;
        font-size: 13px;
        font-weight: 600;
        color: #cfc8b6;
        background: rgba(255, 255, 255, 0.06);
      }

      .amount-input-group input {
        flex: 1;
        min-width: 0;
        padding: 7px 6px;
        border: none;
        outline: none;
        background: transparent;
        color: #fff;
        font-family: inherit;
        font-size: 16px;
        text-align: center;
      }

      /* Hide number input spinners for a cleaner look */
      .amount-input-group input::-webkit-outer-spin-button,
      .amount-input-group input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
      }

      .amount-input-group input[type="number"] {
        -moz-appearance: textfield;
        appearance: textfield;
      }

      .custom-usd-hint {
        margin-top: 4px;
        font-weight: 600;
        color: var(--fz-gold);
      }

      /* "Cover the processing fee" opt-in (Bold only) */
      .fee-cover {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-top: 14px;
        padding: 12px 14px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        cursor: pointer;
      }

      .fee-cover:hover {
        border-color: rgba(255, 255, 255, 0.6);
      }

      .fee-cover input[type="checkbox"] {
        flex-shrink: 0;
        width: 18px;
        height: 18px;
        margin-top: 2px;
        accent-color: var(--fz-red);
        cursor: pointer;
      }

      .fee-cover-text {
        font-size: 14px;
        line-height: 1.35;
        color: #e9e2d2;
      }

      .fee-cover-amount {
        font-weight: 700;
        color: var(--fz-gold);
        white-space: nowrap;
      }

      #paypal-donate-container {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        min-height: 50px;
        margin: 16px 0 8px;
      }

      #paypal-donate-container img {
        width: auto;
        max-width: 100%;
        height: 60px;
        cursor: pointer;
      }

      .form-note {
        margin-top: 14px;
        font-size: 13px;
        text-align: center;
        color: #cfc8b6;
      }

      @media (max-width: 968px) {
        .registration::before {
          display: none;
        }

        .registration-wrapper {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      @media (max-width: 600px) {
        .form-card {
          padding: 24px 18px;
        }

        .method-selector {
          grid-template-columns: minmax(0, 1fr);
        }

        .option-content {
          min-height: 84px;
          padding: 12px 8px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .form-step {
          animation: none;
        }
      }
    </style>

    <script>
      import { showToast } from "../lib/cart";
      import { buildCustomerData } from "../lib/boldPrefill";
      import { isValidEmail, normalizeStoredPhone } from "../lib/checkoutFields";

      declare global {
        interface Window {
          PayPal: any;
          BoldCheckout: any;
        }
      }

      document.addEventListener("astro:page-load", () => {
        // --- Live Counter ---
        const liveCounter = document.getElementById("live-counter");
        async function updateCounter() {
          if (!liveCounter) return;
          try {
            const response = await fetch("/api/contador");
            if (response.ok) {
              const data = (await response.json()) as { total: number };
              liveCounter.textContent = data.total.toLocaleString();
            }
          } catch (error) {}
        }
        updateCounter();
        setInterval(updateCounter, 30000);

        // --- Form Controls ---
        const form = document.getElementById(
          "registrationForm"
        ) as HTMLFormElement;
        const step1 = document.getElementById("step1");
        const step2 = document.getElementById("step2");
        const btnNext = document.getElementById("btnNext");
        const btnBack = document.getElementById("btnBack");
        let paypalButtonRendered = false;
        let currentMethod: "bold" | "paypal" = "bold";
        let boldSdkPromise: Promise<void> | null = null;
        const secureNote = document.getElementById("secureNote");

        // Country value comes from the CountryCombobox React island, which keeps
        // a hidden input (#country) in sync (localized names + search + geo).
        const getCountry = (): string =>
          (document.getElementById("country") as HTMLInputElement | null)
            ?.value || "";

        // Display-only USD<->COP approximation. We charge in COP via Bold, but
        // USD is shown as the primary figure.
        const COP_PER_USD = 4000;

        // Minimum contribution accepted in the "Otro" (custom) field.
        const MIN_USD = 5;
        const MIN_COP = MIN_USD * COP_PER_USD;

        type Step1Field = "name" | "email" | "phone" | "country";
        // Where each step-1 field takes the focus when it is invalid (the
        // phone and country pickers are React islands).
        const STEP1_FOCUS: Record<Step1Field, string> = {
          name: "#name",
          email: "#email",
          phone: "#phone-number",
          country: "#country ~ .cc-trigger",
        };
        const STEP1_HIDDEN: Record<Step1Field, string> = {
          name: "name",
          email: "email",
          phone: "phone",
          country: "country",
        };
        let step1Attempted = false;

        // Shared step-1 validation: the invalid fields in screen order, each
        // with its localized message.
        const validateStep1 = (): { field: Step1Field; message: string }[] => {
          const value = (id: string) =>
            (document.getElementById(id) as HTMLInputElement | null)?.value ||
            "";
          const errors: { field: Step1Field; message: string }[] = [];
          if (!value("name").trim())
            errors.push({ field: "name", message: form.dataset.tErrorName || "" });
          if (!isValidEmail(value("email")))
            errors.push({ field: "email", message: form.dataset.tErrorEmail || "" });
          if (!normalizeStoredPhone(value("phone")))
            errors.push({ field: "phone", message: form.dataset.tErrorPhone || "" });
          if (!getCountry())
            errors.push({
              field: "country",
              message: form.dataset.tErrorCountry || "",
            });
          return errors;
        };

        // Marks each step-1 field's .form-group and writes its message.
        const showStep1Errors = (
          errors: { field: Step1Field; message: string }[]
        ) => {
          (Object.keys(STEP1_HIDDEN) as Step1Field[]).forEach((field) => {
            const group = document
              .getElementById(STEP1_HIDDEN[field])
              ?.closest(".form-group");
            if (!group) return;
            const error = errors.find((e) => e.field === field);
            group.classList.toggle("is-invalid", !!error);
            let msg = group.querySelector<HTMLElement>(".field-error");
            if (error) {
              if (!msg) {
                msg = document.createElement("p");
                msg.className = "field-error";
                group.appendChild(msg);
              }
              msg.textContent = error.message;
            } else {
              msg?.remove();
            }
          });
        };

        // Validates step 1, shows the errors and focuses the first invalid
        // field. Returns true when the contact details are valid.
        const checkStep1 = (): boolean => {
          step1Attempted = true;
          const errors = validateStep1();
          showStep1Errors(errors);
          if (errors.length === 0) return true;
          const el = document.querySelector<HTMLElement>(
            STEP1_FOCUS[errors[0].field]
          );
          el?.scrollIntoView({ behavior: "smooth", block: "center" });
          el?.focus({ preventScroll: true });
          return false;
        };

        // After the first attempt, errors follow the fields as they change.
        // Delegated: the phone and country islands hydrate after this runs,
        // and their hidden inputs dispatch bubbling "change" events.
        const revalidateStep1 = () => {
          if (step1Attempted) showStep1Errors(validateStep1());
        };
        step1?.addEventListener("input", revalidateStep1);
        step1?.addEventListener("change", revalidateStep1);

        // --- Load PayPal Donate SDK ---
        const loadPayPalSDK = async (): Promise<void> => {
          if (window.PayPal) return;

          return new Promise((resolve) => {
            const script = document.createElement("script");
            script.src =
              "https://www.paypalobjects.com/donate/sdk/donate-sdk.js";
            script.charset = "UTF-8";
            script.onload = () => resolve();
            document.body.appendChild(script);
          });
        };

        // --- Render PayPal Button ---
        const renderPayPalButton = async () => {
          if (paypalButtonRendered) return;

          await loadPayPalSDK();

          const container = document.getElementById("paypal-donate-container");
          if (!container || !window.PayPal) return;

          // Get form data
          const nameInput = document.getElementById("name") as HTMLInputElement;
          const emailInput = document.getElementById(
            "email"
          ) as HTMLInputElement;
          const phoneInput = document.getElementById(
            "phone"
          ) as HTMLInputElement;
          const countryValue = getCountry();

          // Get selected amount
          const selectedAmountEl = form.querySelector(
            'input[name="amount"]:checked'
          ) as HTMLInputElement;
          let amount = selectedAmountEl?.value || "5";

          if (amount === "custom") {
            const customInputEl = document.querySelector(
              ".custom-amount"
            ) as HTMLInputElement;
            // Enforce the minimum contribution (5 USD); clamp and reflect it
            // back into the field so the donor sees what will be charged.
            const typed = Number(customInputEl?.value);
            const finalUsd =
              Number.isFinite(typed) && typed >= MIN_USD ? typed : MIN_USD;
            if (customInputEl) customInputEl.value = String(finalUsd);
            amount = String(finalUsd);
          }

          // Clear container and render button
          container.innerHTML = "";

          window.PayPal.Donation.Button({
            env: "production",
            // Use business email instead of hosted_button_id for dynamic amount control
            business: "afroinsantamarta@gmail.com",
            // Pre-fill amount from form selection
            amount: amount,
            currency_code: "USD",
            item_name: "Aporte AFRO IN - Millón de Corazones",
            image: {
              src: "https://www.paypalobjects.com/es_ES/ES/i/btn/btn_donateCC_LG.gif",
              title: "PayPal - Donar de forma segura",
              alt: "Donar con PayPal",
            },
            onComplete: async function (params: {
              tx: string;
              st: string;
              amt: string;
              cc: string;
              cm: string;
              item_number: string;
              item_name: string;
            }) {
              console.log("PayPal donation completed:", params);

              // Register donor with transaction info
              try {
                const response = await fetch("/api/donante", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({
                    name: nameInput.value,
                    email: emailInput.value,
                    phone: phoneInput.value || null,
                    country: countryValue || null,
                    amount: parseFloat(params.amt || amount),
                    paypal_tx: params.tx,
                    paypal_status: params.st,
                  }),
                });
                if (response.ok) {
                  const data = (await response.json()) as { id: number };
                  sessionStorage.setItem("donor_id", String(data.id));
                }
              } catch (error) {
                console.error("Error registering donor:", error);
              }

              // Redirect to thank you page
              showToast(form.dataset.tToastSuccess || "");
              setTimeout(() => {
                const redirectBase = form.dataset.tRedirectUrl || "/gracias";
                window.location.href = `${redirectBase}?tx=${params.tx}&amt=${params.amt}`;
              }, 1000);
            },
          }).render("#paypal-donate-container");

          paypalButtonRendered = true;
        };

        // --- Load Bold Checkout SDK ---
        const loadBoldSDK = (): Promise<void> => {
          if (window.BoldCheckout) return Promise.resolve();
          if (boldSdkPromise) return boldSdkPromise;
          boldSdkPromise = new Promise<void>((resolve) => {
            const script = document.createElement("script");
            script.src =
              "https://checkout.bold.co/library/boldPaymentButton.js";
            script.onload = () => resolve();
            document.body.appendChild(script);
          });
          return boldSdkPromise;
        };

        // Bold's standard processing fee. When the donor opts in to cover it,
        // we gross up the charge so the foundation nets the chosen amount.
        const BOLD_FEE_PCT = 0.0359;
        const BOLD_FEE_FIXED = 900;
        const grossUpBold = (base: number): number =>
          Math.ceil((base + BOLD_FEE_FIXED) / (1 - BOLD_FEE_PCT));

        // Base Bold amount in COP (before any fee). Fixed options carry the COP
        // value; the custom field is entered in USD and converted to COP.
        const getBoldBase = (): number => {
          const selected = form.querySelector(
            'input[name="amount_bold"]:checked'
          ) as HTMLInputElement | null;
          const value = selected?.value || "20000";
          if (value === "custom") {
            const customEl = document.querySelector(
              ".custom-amount-bold"
            ) as HTMLInputElement | null;
            const usd = Number(customEl?.value);
            if (!Number.isFinite(usd) || usd <= 0) return 0;
            return Math.trunc(usd * COP_PER_USD);
          }
          return Math.trunc(Number(value));
        };

        const isCoveringFee = (): boolean =>
          (document.getElementById("boldCoverFee") as HTMLInputElement | null)
            ?.checked ?? false;

        // Final Bold amount in COP (what we actually charge), including the fee
        // when the donor opted to cover it.
        const getBoldAmount = (): number => {
          const base = getBoldBase();
          if (base <= 0) return 0;
          return isCoveringFee() ? grossUpBold(base) : base;
        };

        // Reflect the fee that would be added next to the checkbox label.
        const boldFeeAmountEl = document.getElementById("boldFeeAmount");
        const updateBoldFeeLabel = () => {
          if (!boldFeeAmountEl) return;
          const base = getBoldBase();
          if (base <= 0) {
            boldFeeAmountEl.textContent = "";
            return;
          }
          const fee = grossUpBold(base) - base;
          boldFeeAmountEl.textContent = `+ $${fee.toLocaleString("es-CO")} COP`;
        };

        // --- Bold payment flow ---
        const payWithBold = async () => {
          // Re-validate contact details; if invalid, send the donor back to fix them.
          if (validateStep1().length > 0) {
            step2?.classList.remove("active");
            step1?.classList.add("active");
            checkStep1();
            return;
          }

          const nameInput = document.getElementById("name") as HTMLInputElement;
          const emailInput = document.getElementById(
            "email"
          ) as HTMLInputElement;
          const phoneInput = document.getElementById(
            "phone"
          ) as HTMLInputElement;
          const countryValue = getCountry();

          const amount = getBoldAmount();
          if (!Number.isFinite(amount) || amount < MIN_COP) {
            showToast(form.dataset.tAmountMin || "", "error");
            return;
          }

          await loadBoldSDK();

          let res: Response;
          try {
            res = await fetch("/api/bold-firma", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                name: nameInput.value,
                email: emailInput.value,
                phone: phoneInput.value || null,
                country: countryValue || null,
                amount,
              }),
            });
          } catch (error) {
            showToast(form.dataset.tErrorGeneric || "", "error");
            return;
          }

          if (!res.ok) {
            showToast(form.dataset.tErrorGeneric || "", "error");
            return;
          }

          const data = (await res.json()) as {
            orderId: string;
            integritySignature: string;
            apiKey: string;
            amount: string;
            currency: string;
          };

          // Remember the order so /gracias can confirm it server-side.
          sessionStorage.setItem("bold_order_id", data.orderId);

          if (!window.BoldCheckout) {
            showToast(form.dataset.tErrorGeneric || "", "error");
            return;
          }

          const boldConfig: Record<string, string> = {
            orderId: data.orderId,
            currency: data.currency,
            amount: data.amount,
            apiKey: data.apiKey,
            integritySignature: data.integritySignature,
            description: "Aporte AFRO IN - Millón de Corazones",
          };

          // Prefill the Bold checkout with the details we already collected.
          boldConfig.customerData = buildCustomerData({
            name: nameInput.value,
            email: emailInput.value,
            phone: phoneInput.value,
          });

          // Bold only accepts a public HTTPS redirect URL. On localhost (http)
          // we omit it — the payment still processes and is confirmed via the
          // webhook / backup query. In production we redirect back to /gracias.
          const origin = window.location.origin;
          if (origin.startsWith("https://")) {
            boldConfig.redirectionUrl =
              origin + (form.dataset.tRedirectUrl || "/gracias");
          }

          const checkout = new window.BoldCheckout(boldConfig);
          checkout.open();
        };

        // --- Switch active payment method ---
        const activateMethod = async (method: "bold" | "paypal") => {
          currentMethod = method;

          document.querySelectorAll(".method-tab").forEach((tab) => {
            const active = tab.getAttribute("data-method") === method;
            tab.classList.toggle("active", active);
            tab.setAttribute("aria-selected", String(active));
          });

          document.querySelectorAll("[data-method-panel]").forEach((el) => {
            (el as HTMLElement).hidden =
              el.getAttribute("data-method-panel") !== method;
          });

          if (secureNote) {
            secureNote.textContent =
              method === "bold"
                ? form.dataset.tSecureBold || ""
                : form.dataset.tSecurePaypal || "";
          }

          if (method === "paypal") {
            await renderPayPalButton();
          } else {
            await loadBoldSDK();
          }
        };

        // Method tab + Bold button listeners
        document.querySelectorAll(".method-tab").forEach((tab) => {
          tab.addEventListener("click", () => {
            const method = tab.getAttribute("data-method") as "bold" | "paypal";
            activateMethod(method);
          });
        });
        document
          .getElementById("btnBoldPay")
          ?.addEventListener("click", payWithBold);

        // --- Navigation ---
        btnNext?.addEventListener("click", async () => {
          if (!checkStep1()) return;
          step1?.classList.remove("active");
          step2?.classList.add("active");

          // Activate the currently selected method when entering step 2
          await activateMethod(currentMethod);
        });

        btnBack?.addEventListener("click", () => {
          step2?.classList.remove("active");
          step1?.classList.add("active");
        });

        // Update PayPal button when amount changes
        const amountInputs = document.querySelectorAll('input[name="amount"]');
        amountInputs.forEach((input) => {
          input.addEventListener("change", () => {
            if (paypalButtonRendered) {
              paypalButtonRendered = false;
              renderPayPalButton();
            }
          });
        });

        const customInput = document.querySelector(
          ".custom-amount"
        ) as HTMLInputElement;
        customInput?.addEventListener("focus", () => {
          const radio = document.querySelector(
            'input[value="custom"]'
          ) as HTMLInputElement;
          if (radio) radio.checked = true;
        });

        customInput?.addEventListener("blur", () => {
          if (paypalButtonRendered) {
            paypalButtonRendered = false;
            renderPayPalButton();
          }
        });

        // --- Bold custom amount (entered in USD): live COP equivalent ---
        const boldCustomInput = document.querySelector(
          ".custom-amount-bold"
        ) as HTMLInputElement;
        const boldCustomUsd = document.getElementById("boldCustomUsd");
        const updateBoldCustomUsd = () => {
          if (!boldCustomUsd) return;
          const usd = Number(boldCustomInput?.value);
          boldCustomUsd.textContent =
            Number.isFinite(usd) && usd > 0
              ? `≈ $${Math.round(usd * COP_PER_USD).toLocaleString("es-CO")} COP`
              : "";
        };
        boldCustomInput?.addEventListener("focus", () => {
          const radio = document.querySelector(
            'input[name="amount_bold"][value="custom"]'
          ) as HTMLInputElement;
          if (radio) radio.checked = true;
        });
        boldCustomInput?.addEventListener("input", () => {
          updateBoldCustomUsd();
          updateBoldFeeLabel();
        });

        // Recompute the fee when a fixed Bold amount or the cover-fee toggle changes.
        form.querySelectorAll('input[name="amount_bold"]').forEach((input) => {
          input.addEventListener("change", updateBoldFeeLabel);
        });
        document
          .getElementById("boldCoverFee")
          ?.addEventListener("change", updateBoldFeeLabel);
        updateBoldFeeLabel();

        // Focus the custom amount input as soon as its "Otro" option is picked.
        const paypalCustomRadio = document.querySelector(
          'input[name="amount"][value="custom"]'
        ) as HTMLInputElement;
        paypalCustomRadio?.addEventListener("change", () => {
          if (paypalCustomRadio.checked) customInput?.focus();
        });
        const boldCustomRadio = document.querySelector(
          'input[name="amount_bold"][value="custom"]'
        ) as HTMLInputElement;
        boldCustomRadio?.addEventListener("change", () => {
          if (boldCustomRadio.checked) boldCustomInput?.focus();
        });
      });
    </script>
  </div>
</section>
