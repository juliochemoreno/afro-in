---
import MapPin from "lucide-astro/MapPin";
import Mail from "lucide-astro/Mail";
import MessageSquare from "lucide-astro/MessageSquare";
import User from "lucide-astro/User";
import PenLine from "lucide-astro/PenLine";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const contactEmail = "afroinsantamarta@gmail.com";
const mapsLink = "https://maps.app.goo.gl/eRum8SuYxfJy9aL38";
---

<section class="hm-section hm-section--alt contact-section" id="contacto" aria-labelledby="contact-title">
  <div class="fz-wrap">
    <div class="contact-grid">
      <div class="contact-info">
        <p class="fz-display hm-kicker">{t("contact.badge")}</p>
        <h2 id="contact-title" class="fz-display hm-title">{t("contact.title")}</h2>
        <p class="contact-desc">{t("contact.desc")}</p>

        <div class="contact-cards">
          <a
            href={mapsLink}
            target="_blank"
            rel="noopener noreferrer"
            class="contact-row"
            aria-label="Ver ubicación en Google Maps"
          >
            <span class="contact-icon"><MapPin size={22} /></span>
            <span class="contact-text">
              <span class="contact-label">{t("contact.location.label")}</span>
              <span class="contact-value">{t("contact.location.title")}, {t("contact.location.subtitle")}</span>
            </span>
          </a>

          <a href={`mailto:${contactEmail}`} class="contact-row">
            <span class="contact-icon"><Mail size={22} /></span>
            <span class="contact-text">
              <span class="contact-label">{t("contact.email.label")}</span>
              <span class="contact-value"><!--email_off-->{contactEmail}<!--/email_off--></span>
            </span>
          </a>
        </div>
      </div>

      <div class="hm-card contact-form-wrapper">
        <div class="form-header">
          <MessageSquare size={20} class="form-header-icon" />
          <h3 class="fz-display">{t("contact.form.title")}</h3>
        </div>

        <form
          class="contact-form"
          id="dudas-form"
          data-wa-template={t("contact.wa.template")}
        >
          <div class="form-group">
            <label for="contact-name">{t("contact.form.name")}</label>
            <span class="hm-input-icon">
              <User size={18} aria-hidden="true" />
              <input
                type="text"
                id="contact-name"
                placeholder={t("contact.form.name.placeholder")}
                required
                class="form-input"
              />
            </span>
          </div>
          <div class="form-group">
            <label for="contact-message">{t("contact.form.message")}</label>
            <span class="hm-input-icon hm-input-icon--top">
              <PenLine size={18} aria-hidden="true" />
              <textarea
                id="contact-message"
                placeholder={t("contact.form.message.placeholder")}
                rows="4"
                class="form-input"
                required></textarea>
            </span>
          </div>
          <button type="submit" class="contact-submit">
            {t("contact.form.submit")}
          </button>
        </form>

        <script>
          const form = document.getElementById("dudas-form") as HTMLFormElement;
          const WHATSAPP_NUMBER = "41782231433";

          form?.addEventListener("submit", (e) => {
            e.preventDefault();

            const nameInput = document.getElementById(
              "contact-name"
            ) as HTMLInputElement;
            const messageInput = document.getElementById(
              "contact-message"
            ) as HTMLTextAreaElement;

            const name = nameInput.value;
            const messageText = messageInput.value;
            const template = form.dataset.waTemplate || "";

            const fullMessage = template
              .replace("{name}", `*${name}*`)
              .replace("{message}", messageText);

            const waUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(fullMessage)}`;
            window.open(waUrl, "_blank");
          });
        </script>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }

  .contact-desc {
    margin: 0 0 28px;
    font-size: 18px;
    line-height: 1.55;
    color: #e9e2d2;
  }

  .contact-cards {
    display: grid;
  }

  .contact-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    border-top: 1px solid var(--fz-line);
    color: #fff;
    text-decoration: none;
  }

  .contact-row:last-child {
    border-bottom: 1px solid var(--fz-line);
  }

  .contact-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    background: var(--fz-red);
    color: #fff;
  }

  .contact-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .contact-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--fz-gold);
  }

  .contact-value {
    font-size: 17px;
    overflow-wrap: anywhere;
  }

  .contact-row:hover .contact-value,
  .contact-row:focus-visible .contact-value {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .contact-form-wrapper {
    padding: 32px;
  }

  .form-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
  }

  .form-header :global(.form-header-icon) {
    color: var(--fz-red);
  }

  .form-header h3 {
    margin: 0;
    font-size: 26px;
  }

  .form-group {
    margin-bottom: 16px;
  }

  .form-group label {
    display: block;
    margin-bottom: 6px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #cfc8b6;
  }

  .form-input {
    width: 100%;
    min-height: 48px;
    padding: 12px 14px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 0;
    background: rgba(0, 0, 0, 0.3);
    color: #fff;
    font-family: inherit;
    font-size: 16px;
    resize: none;
  }

  .hm-input-icon .form-input {
    padding-left: 42px;
  }

  .form-input::placeholder {
    color: #8f8878;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--fz-gold);
    box-shadow: 0 0 0 3px rgba(242, 193, 78, 0.2);
  }

  .contact-submit {
    width: 100%;
    min-height: 52px;
    border: 0;
    border-radius: 0;
    background: var(--fz-red);
    color: #fff;
    font-family: inherit;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
  }

  .contact-submit:hover,
  .contact-submit:focus-visible {
    filter: brightness(1.1);
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .contact-form-wrapper {
      padding: 24px 18px;
    }
  }
</style>
