---
// A wide photo card linking to another stop of the edition ("Siguiente parada" / "Parada anterior"):
// scrims top and bottom, kicker and dates on top, name and place at the bottom, the whole card is the link.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Pin from "@/components/Pin.astro";

interface Props {
  href: string;
  image: ImageMetadata;
  position?: string;
  kicker: string;
  range: string;
  name: string;
  place: string;
  linkText: string;
}

const { href, image, position = "center", kicker, range, name, place, linkText } = Astro.props;
---

<a class="stop-link-card" href={href}>
  <Image src={image} alt="" widths={[768, 1440, 1920]} sizes="100vw" class="stop-link-photo" style={`object-position: ${position}`} loading="lazy" />
  <span class="stop-link-top">
    <span class="stop-link-kicker">{kicker}</span>
  </span>
  <span class="stop-link-bottom">
    <span class="stop-link-range">{range}</span>
    <span class="stop-link-title">
      <span class="fz-display stop-link-name">{name}</span>
      <span class="stop-link-arrow" aria-hidden="true">→</span>
    </span>
    <span class="stop-link-place"><Pin /><span>{place}</span></span>
  </span>
  <span class="stop-link-sr">{linkText}</span>
</a>

<style>
  .stop-link-card {
    position: relative;
    display: block;
    height: clamp(480px, 60svh, 85svh);
    overflow: hidden;
    background: transparent;
    border: 0;
    box-shadow: none;
    text-decoration: none;
    color: #f3e9d2;
  }

  .stop-link-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(rgba(14, 10, 8, 0.8), transparent 36%, transparent 50%, rgba(14, 10, 8, 0.85));
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 10%, #000 90%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 10%, #000 90%, transparent 100%);
  }

  .stop-link-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 10%, #000 90%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 10%, #000 90%, transparent 100%);
  }

  .stop-link-top,
  .stop-link-bottom {
    position: absolute;
    left: var(--fz-bleed);
    right: var(--fz-bleed);
    z-index: 2;
  }

  .stop-link-top {
    top: 9%;
    font-size: clamp(16px, 1.4vw, 20px);
  }

  .stop-link-kicker {
    color: #d9ccb3;
  }

  .stop-link-bottom {
    bottom: 10%;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stop-link-range {
    color: #e6b84a;
    font-weight: 500;
    font-size: clamp(15px, 1.4vw, 18px);
  }

  .stop-link-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .stop-link-name {
    font-size: clamp(32px, 4vw, 64px);
    line-height: 1.05;
    white-space: nowrap;
  }

  .stop-link-place {
    display: flex;
    align-items: baseline;
    font-size: clamp(14px, 1.25vw, 16px);
    color: #bfb39c;
    min-width: 0;
  }

  .stop-link-place span {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .stop-link-arrow {
    flex: none;
    font-size: clamp(22px, 1.9vw, 24px);
    line-height: 1;
    color: #e6b84a;
    transition: transform 0.2s ease;
  }

  .stop-link-card:hover .stop-link-arrow,
  .stop-link-card:focus-visible .stop-link-arrow {
    transform: translateX(4px);
  }

  .stop-link-card:focus-visible {
    outline: 2px solid #e6b84a;
    outline-offset: 3px;
  }

  .stop-link-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 1023px) {
    .stop-link-card {
      height: auto;
      aspect-ratio: 16 / 10;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stop-link-arrow {
      transition: none;
    }
  }
</style>
