---
// Home allies: this edition's allies first (same logos as the allies page), then every other
// ally, each logo once, in square dark tiles. The full story lives on /aliados.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { allies } from "@/lib/allies";
import laPuertaLogo from "@/assets/img/aliados/la-puerta-dark.png";
import cokoaLogo from "@/assets/img/aliados/cokoa-dark.png";
import masayaLogo from "@/assets/img/aliados/masaya.webp";
import caribeamLogo from "@/assets/img/aliados/caribeam-team-dark.png";
import kombilesaLogo from "@/assets/img/aliados/kombilesa-mi.webp";
import tayrosoftLogo from "@/assets/img/tayrosoft-logo-white.svg";
import { getLangFromUrl, getTranslatedPath, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const edition: { name: string; logo: ImageMetadata }[] = [
  { name: "La Puerta", logo: laPuertaLogo },
  { name: "Co·KoA", logo: cokoaLogo },
  { name: "Masaya", logo: masayaLogo },
  { name: "Caribeam Team", logo: caribeamLogo },
  { name: "Kombilesa Mi", logo: kombilesaLogo },
  { name: "Tayrosoft", logo: tayrosoftLogo },
];
const editionNames = new Set(edition.map((ally) => ally.name));
const logos = [
  ...edition,
  ...allies
    .filter((ally) => !editionNames.has(ally.name))
    .map((ally) => ({ name: ally.name, logo: ally.imageOnDark ?? ally.image })),
];
---

<section class="hm-section hm-section--alt allies" id="aliados" aria-labelledby="allies-title">
  <div class="fz-wrap">
    <header class="hm-head">
      <p class="fz-display hm-kicker">{t("allies.badge")}</p>
      <h2 id="allies-title" class="fz-display hm-title">{t("allies.title")}</h2>
      <p class="hm-sub">{t("allies.subtitle")}</p>
    </header>

    <ul class="allies-grid">
      {
        logos.map((ally) => (
          <li class="hm-card ally-tile" title={ally.name}>
            <Image src={ally.logo} alt={ally.name} width={320} class="ally-logo" loading="lazy" />
          </li>
        ))
      }
    </ul>

    <div class="hm-actions">
      <a class="fz-button fz-button-solid" href={getTranslatedPath("/aliados", lang)}>
        {t("allies.home.all")}
      </a>
    </div>
  </div>
</section>

<style>
  .allies-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ally-tile {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    padding: 14px;
  }

  .ally-tile :global(.ally-logo) {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 72px;
    object-fit: contain;
  }

  @media (max-width: 900px) {
    .allies-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
    }

    .ally-tile {
      padding: 10px;
    }

    .ally-tile :global(.ally-logo) {
      max-height: 48px;
    }
  }
</style>
