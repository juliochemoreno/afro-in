---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hm-section documentary" id="documental" aria-labelledby="doc-title">
  <div class="fz-wrap">
    <header class="hm-head">
      <p class="fz-display hm-kicker">{t("doc.badge")}</p>
      <h2 id="doc-title" class="fz-display hm-title">{t("doc.title")}</h2>
      <p class="hm-sub">
        {t("doc.subtitle.part1")}
        <strong>{t("doc.subtitle.part2")}</strong>.
      </p>
    </header>

    <a
      href="https://www.youtube.com/watch?v=vWgm4qWTN_Y"
      target="_blank"
      rel="noopener noreferrer"
      class="doc-video"
    >
      <img
        src="https://img.youtube.com/vi/vWgm4qWTN_Y/maxresdefault.jpg"
        alt={t("doc.alt")}
        class="doc-video-img"
        loading="lazy"
      />
      <span class="doc-play" aria-hidden="true"></span>
      <span class="doc-label">{t("doc.play")}</span>
    </a>

    <p class="doc-quote">{t("doc.quote")}</p>
  </div>
</section>

<style>
  .doc-video {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #000;
    color: #fff;
    text-decoration: none;
  }

  /* The thumbnail has the video's own caption baked in at the bottom: zoom a little to keep it out. */
  .doc-video-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.18);
    transform-origin: 50% 18%;
  }

  .doc-video::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.5), transparent 50%);
  }

  .doc-play {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 88px;
    height: 88px;
    transform: translate(-50%, -50%);
    background: var(--fz-red);
    transition: transform 0.2s ease;
    isolation: isolate;
  }

  /* Pulse ring behind the square play button (as before, square now). */
  .doc-play::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--fz-red);
    opacity: 0.4;
    animation: doc-pulse 2s infinite ease-out;
    z-index: -1;
  }

  @keyframes doc-pulse {
    0% {
      transform: scale(0.9);
      opacity: 0.6;
    }
    100% {
      transform: scale(1.7);
      opacity: 0;
    }
  }

  .doc-play::after {
    content: "";
    margin-left: 7px;
    border-left: 26px solid #fff;
    border-top: 15px solid transparent;
    border-bottom: 15px solid transparent;
  }

  .doc-video:hover .doc-play,
  .doc-video:focus-visible .doc-play {
    transform: translate(-50%, -50%) scale(1.08);
  }

  .doc-label {
    position: absolute;
    z-index: 2;
    left: 24px;
    bottom: 20px;
    font-weight: 600;
  }

  .doc-quote {
    max-width: 760px;
    margin: 40px auto 0;
    font-size: 22px;
    line-height: 1.5;
    text-align: center;
    color: #e9e2d2;
  }

  @media (max-width: 720px) {
    .doc-play {
      width: 64px;
      height: 64px;
    }

    .doc-play::after {
      border-left-width: 20px;
      border-top-width: 12px;
      border-bottom-width: 12px;
    }

    .doc-quote {
      font-size: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .doc-play {
      transition: none;
    }

    .doc-play::before {
      animation: none;
    }
  }
</style>
