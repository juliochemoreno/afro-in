---
import { getProducts } from "@/lib/products";
import ProductCard from "./ProductCard.astro";

interface Props {
  lang: "es" | "en" | "fr";
}
const { lang } = Astro.props;

// Rendered as a server island (server:defer from Store.astro) so the home page
// stays statically built — and its <Image> assets keep being optimized at build
// — while this section still reads D1 live at request time (respecting CMS
// visibility). Product images come from R2 via /media, which works at runtime.
// `lang` is passed as a prop because inside a server island `Astro.url` is the
// island endpoint URL, not the page URL.
const db = (Astro.locals as any).runtime?.env?.DB;
const featured = db
  ? (await getProducts(db, { visibleOnly: true })).slice(0, 8)
  : [];

// The card is the shared ProductCard (also used by /tienda); the home card has no quick add.
---

<div class="fz-product-grid">
  {
    featured.map((product) => (
      <ProductCard product={product} lang={lang} showQuickAdd={false} />
    ))
  }
</div>
