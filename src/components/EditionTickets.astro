---
// Ticket tiers of an edition stop, as information only (no sale here).
import { useTranslations } from "@/i18n/utils";
import { PRESALE, formatCop, type Lang } from "@/lib/programacion";
import { getTranslatedPath } from "@/i18n/utils";

interface Props {
  tickets: {
    tiers: { period: string; price: number; note?: string }[];
    includes?: string;
  };
  lang: Lang;
  heading?: string;
  // Inside another block (the headliner): no frame of its own.
  bare?: boolean;
  // Adds the presale and Afro Batalla registration blocks (see PRESALE).
  presale?: boolean;
}

const { tickets, lang, heading, bare = false, presale = false } = Astro.props;
const t = useTranslations(lang);
const Heading = bare ? "h3" : "h2";

const offers = presale
  ? [
      {
        title: t("edition.presaleTitle"),
        note: t("edition.presaleNote").replace("{n}", String(PRESALE.presale.capacity)),
        price: PRESALE.presale.price,
        url: PRESALE.presale.url,
        cta: t("edition.presaleCta"),
      },
      {
        title: t("edition.batallaTitle"),
        note: t("edition.batallaNote"),
        price: PRESALE.afroBatalla.price,
        url: PRESALE.afroBatalla.url,
        cta: t("edition.batallaCta"),
      },
    ]
  : [];
---

<section class:list={[{ "fz-frame": !bare }]} aria-label={heading ?? t("edition.ticketsTitle")}>
  <div class:list={["fz-tickets", { "fz-frame-inner": !bare, "fz-tickets-bare": bare }]}>
    <Heading class="fz-display">{heading ?? t("edition.ticketsTitle")}</Heading>
    <ul class="fz-tiers">
      {tickets.tiers.map((tier) => (
        <li>
          <span>{tier.period}</span>
          <span class="fz-display fz-tier-price">{formatCop(tier.price, lang)}</span>
          {tier.note && <span class="fz-muted">{tier.note}</span>}
        </li>
      ))}
    </ul>
    {offers.length > 0 && (
      <ul class="fz-offers">
        {offers.map((offer) => (
          <li>
            <span class="fz-display fz-offer-title">{offer.title}</span>
            <span class="fz-display fz-tier-price">{formatCop(offer.price, lang)}</span>
            <span class="fz-muted">{offer.note}</span>
            {offer.url ? (
              <a class="fz-button fz-button-solid fz-offer-cta" href={getTranslatedPath(offer.url, lang)}>{offer.cta}</a>
            ) : (
              <span class="fz-button fz-offer-cta fz-offer-cta-soon" aria-disabled="true">{t("edition.offerSoon")}</span>
            )}
          </li>
        ))}
      </ul>
    )}
    {tickets.includes && <p class="fz-tickets-foot">{tickets.includes}</p>}
    <p class="fz-muted">{t("edition.ticketsSoon")}</p>
  </div>
</section>
