---
// Price stages of an edition stop: a ladder with every stage, then a pass card
// with the stage in force (its price and the buy button). The stage in force is
// marked in the browser (see the script below), so a prerendered page never
// shows a stale one; its price shows once, in the card, not in the ladder.
import { useTranslations, getTranslatedPath } from "@/i18n/utils";
import { SALES, formatCop, type Lang } from "@/lib/programacion";

interface Props {
  tickets: {
    tiers: { period: string; from?: string; until?: string; price: number; note?: string }[];
    includes?: string;
  };
  lang: Lang;
  heading?: string;
  // The stop the ticket is for: titles the block "Nos vemos en <place>" with
  // "<days> días de festival" under it; the stub shows the dates ("15–17 ene").
  pass?: { place: string; range: string; stub: string; days: number };
  // Inside another block (the headliner): smaller heading, no rule of its own.
  bare?: boolean;
}

const { tickets, lang, heading, pass, bare = false } = Astro.props;
const t = useTranslations(lang);
const Heading = bare ? "h3" : "h2";
const title = pass ? t("edition.passTitle").replace("{place}", pass.place) : (heading ?? t("edition.ticketsTitle"));
const subtitle = pass
  ? t("edition.passSubtitle").replace("{days}", String(pass.days))
  : null;
const buyUrl = SALES.tickets.url ? getTranslatedPath(SALES.tickets.url, lang) : "";
---

<section aria-label={title}>
  <div class:list={["fz-tickets", bare ? "fz-tickets-bare" : "fz-tickets-plain"]}>
    <Heading class="fz-display">{title}</Heading>
    {subtitle && <p class="fz-tickets-sub">{subtitle}</p>}
    <div class="fz-tickets-body" data-tiers-root>
      <div class="fz-tickets-layout">
      <ol class="fz-tiers" data-tiers>
        {tickets.tiers.map((tier, i) => (
          <li data-from={tier.from} data-until={tier.until} data-price={tier.price}>
            <span class="fz-tier-label">{t("edition.stageNumber")} {i + 1}</span>
            <span class="fz-display fz-tier-now" hidden>{t("edition.now")}</span>
            <span class="fz-display fz-tier-price">{formatCop(tier.price, lang)}</span>
            <span class="fz-tier-period">{tier.period}</span>
            <span class="fz-tier-flag fz-tier-done" hidden>{t("edition.stageDone")}</span>
            {tier.note && <span class="fz-tier-note" hidden>{tier.note}</span>}
          </li>
        ))}
      </ol>
      <div class="fz-pass" data-pass hidden>
        {pass && (
          <div class="fz-pass-head">
            <p class="fz-pass-event">AFRO IN 2027</p>
            <p class="fz-display fz-pass-dates" aria-label={pass.range}>{pass.stub}</p>
          </div>
        )}
        <div class="fz-pass-body">
          <p class="fz-pass-kicker" data-pass-note></p>
          <p class="fz-display fz-pass-price" data-pass-price></p>
          {tickets.includes && <p class="fz-pass-foot">{tickets.includes}</p>}
        </div>
        <div class="fz-pass-stub">
          {buyUrl ? (
            <a class="fz-button fz-button-solid fz-pass-buy" href={buyUrl}>{t("edition.ticketCta")}</a>
          ) : (
            <span class="fz-button fz-pass-buy fz-tier-buy-soon" aria-disabled="true">{t("edition.offerSoon")}</span>
          )}
        </div>
      </div>
      </div>
    </div>
  </div>
  {buyUrl && (
    <div class="fz-stickybuy" data-sticky-buy hidden>
      <span class="fz-stickybuy-info">
        <span class="fz-display fz-stickybuy-price" data-sticky-price></span>
        <span class="fz-stickybuy-stage">{pass && `${pass.place} · `}<span data-sticky-stage></span></span>
      </span>
      <a class="fz-button fz-button-solid fz-stickybuy-buy" href={buyUrl}>{t("edition.ticketCta")}</a>
    </div>
  )}
</section>

<script>
  import { bogotaToday, tierStage, tierStagesFromSale } from "@/lib/programacion";

  const SALE_TIMEOUT_MS = 3000;

  function applyStage(item: HTMLLIElement, stage: string) {
    item.dataset.stage = stage;
    item.querySelector<HTMLElement>(".fz-tier-now")!.hidden = stage !== "current";
    item.querySelector<HTMLElement>(".fz-tier-done")!.hidden = stage !== "past";
  }

  // The ticket card shows the stage in force (price and note); no stage in force, no card.
  function fillPass(list: HTMLElement) {
    const card = list.closest("[data-tiers-root]")?.querySelector<HTMLElement>("[data-pass]");
    if (!card) return;
    const current = list.querySelector<HTMLLIElement>(':scope > li[data-stage="current"]');
    card.hidden = !current;
    if (!current) {
      list.closest("section")?.querySelector("[data-sticky-buy]")?.setAttribute("data-off", "");
      return;
    }
    list.closest("section")?.querySelector("[data-sticky-buy]")?.removeAttribute("data-off");
    card.querySelector("[data-pass-price]")!.textContent = current.querySelector(".fz-tier-price")!.textContent;
    card.querySelector("[data-pass-note]")!.textContent = current.querySelector(".fz-tier-note")?.textContent ?? "";
    const bar = list.closest("section")?.querySelector<HTMLElement>("[data-sticky-buy]");
    if (bar) {
      bar.querySelector("[data-sticky-price]")!.textContent = current.querySelector(".fz-tier-price")!.textContent;
      bar.querySelector("[data-sticky-stage]")!.textContent = current.querySelector(".fz-tier-label")!.textContent;
    }
  }

  // The real stage of the pass, or null when the request fails or is slow.
  // no-store: the zone's Browser Cache TTL stretches the endpoint's 60 s to
  // hours in the browser; the edge cache still serves it for 60 s.
  async function fetchSale() {
    try {
      const res = await fetch("/api/tickets/stages", {
        cache: "no-store",
        signal: AbortSignal.timeout(SALE_TIMEOUT_MS),
      });
      if (!res.ok) return null;
      const sale = await res.json();
      return sale && typeof sale.state === "string" ? sale : null;
    } catch {
      return null;
    }
  }

  // Runs on every page load, including client-side navigations (the layout uses ClientRouter).
  // The date decides first, so the page never waits; the pass's real stages (a stage that sold
  // out opens the next one early) refine it when they arrive.
  async function showStages() {
    const today = bogotaToday();
    const lists = [...document.querySelectorAll<HTMLOListElement>("[data-tiers]")];
    lists.forEach((list) => {
      list.querySelectorAll<HTMLLIElement>(":scope > li").forEach((item) => {
        applyStage(item, tierStage(today, item.dataset.from, item.dataset.until));
      });
      fillPass(list);
    });
    if (!lists.length) return;

    const sale = await fetchSale();
    if (!sale) return;
    lists.forEach((list) => {
      if (!list.isConnected) return;
      const items = [...list.querySelectorAll<HTMLLIElement>(":scope > li")];
      const stages = tierStagesFromSale(
        items.map((item) => ({
          from: item.dataset.from,
          until: item.dataset.until,
          price: Number(item.dataset.price),
        })),
        sale,
        today
      );
      items.forEach((item, i) => applyStage(item, stages[i]));
      fillPass(list);
    });
  }

  // Once the ticket block has scrolled up out of view, a bar at the
  // bottom keeps "Quiero ser parte" at hand; it hides again over the block or the footer.
  let stickyObserver: IntersectionObserver | undefined;
  function watchStickyBuy() {
    stickyObserver?.disconnect();
    const bar = document.querySelector<HTMLElement>("[data-sticky-buy]");
    const block = bar?.closest("section");
    if (!bar || !block) return;
    const footer = document.querySelector("footer");
    let pastBlock = false;
    let footerOn = false;
    const update = () => {
      const show = pastBlock && !footerOn && !bar.hasAttribute("data-off");
      bar.hidden = !show;
      document.documentElement.classList.toggle("has-stickybuy", show);
    };
    stickyObserver = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.target === block) pastBlock = !e.isIntersecting && e.boundingClientRect.top < 0;
        else footerOn = e.isIntersecting;
      }
      update();
    });
    stickyObserver.observe(block);
    if (footer) stickyObserver.observe(footer);
  }

  document.addEventListener("astro:page-load", () => {
    showStages();
    watchStickyBuy();
  });
  document.addEventListener("astro:before-swap", () => {
    stickyObserver?.disconnect();
    document.documentElement.classList.remove("has-stickybuy");
  });
</script>
