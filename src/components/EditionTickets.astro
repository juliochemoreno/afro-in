---
// Ticket tiers of an edition stop, as information only (no sale here).
import { useTranslations } from "@/i18n/utils";
import { formatCop, type Lang } from "@/lib/programacion";

interface Props {
  tickets: {
    tiers: { period: string; price: number; note?: string }[];
    includes?: string;
  };
  lang: Lang;
  heading?: string;
}

const { tickets, lang, heading } = Astro.props;
const t = useTranslations(lang);
---

<section class="fz-frame" aria-label={heading ?? t("edition.ticketsTitle")}>
  <div class="fz-frame-inner fz-tickets">
    <h2 class="fz-display">{heading ?? t("edition.ticketsTitle")}</h2>
    <ul class="fz-tiers">
      {tickets.tiers.map((tier) => (
        <li>
          <span>{tier.period}</span>
          <span class="fz-display fz-tier-price">{formatCop(tier.price, lang)}</span>
          {tier.note && <span class="fz-muted">{tier.note}</span>}
        </li>
      ))}
    </ul>
    {tickets.includes && <p class="fz-tickets-foot">{tickets.includes}</p>}
    <p class="fz-muted">{t("edition.ticketsSoon")}</p>
  </div>
</section>
