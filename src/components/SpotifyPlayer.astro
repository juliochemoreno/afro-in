---
// Compact Spotify artist player. The iframe is only created when the block is near the viewport
// (or when the button is pressed), so no request reaches Spotify before that.
import { useTranslations } from "@/i18n/utils";
import { spotifyEmbedUrl } from "@/lib/spotify";
import type { Lang } from "@/lib/programacion";

interface Props {
  artistId: string;
  name: string;
  lang: Lang;
  // `photo` sits over the photo panel on desktop, `text` under the dates on phones and tablets.
  placement: "photo" | "text";
}

const { artistId, name, lang, placement } = Astro.props;
const t = useTranslations(lang);
const src = spotifyEmbedUrl(artistId);
const label = `${t("edition.listen")} ${name}`;
---

{src && (
  <div class={`fz-spotify fz-spotify--${placement}`} data-spotify-src={src} data-spotify-title={name}>
    <button type="button" class="fz-spotify-btn">
      <svg class="fz-spotify-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
      <span class="fz-display">{label}</span>
    </button>
  </div>
)}

<script>
  function loadPlayer(box: HTMLElement) {
    if (box.dataset.ready) return;
    const src = box.dataset.spotifySrc;
    if (!src) return;
    box.dataset.ready = "true";
    const frame = document.createElement("iframe");
    frame.src = src;
    frame.title = box.dataset.spotifyTitle ?? "Spotify";
    frame.height = "152";
    frame.width = "100%";
    frame.loading = "lazy";
    frame.allow = "encrypted-media; clipboard-write; fullscreen";
    frame.className = "fz-spotify-frame";
    box.replaceChildren(frame);
  }

  let observer: IntersectionObserver | undefined;

  document.addEventListener("astro:page-load", () => {
    observer?.disconnect();
    const boxes = document.querySelectorAll<HTMLElement>(".fz-spotify:not([data-ready])");
    if (!boxes.length) return;
    boxes.forEach((box) => {
      box.querySelector("button")?.addEventListener("click", () => loadPlayer(box), { once: true });
    });
    if (!("IntersectionObserver" in window)) return;
    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          loadPlayer(entry.target as HTMLElement);
          observer?.unobserve(entry.target);
        }
      },
      { rootMargin: "400px 0px" }
    );
    boxes.forEach((box) => observer!.observe(box));
  });

  document.addEventListener("astro:before-swap", () => observer?.disconnect());
</script>
