---
import Drama from "lucide-astro/Drama";
import Music from "lucide-astro/Music";
import Shirt from "lucide-astro/Shirt";
import BookOpen from "lucide-astro/BookOpen";

import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const features = [
  {
    Icon: Drama,
    title: t("about.features.art.title"),
    description: t("about.features.art.desc"),
  },
  {
    Icon: Music,
    title: t("about.features.music.title"),
    description: t("about.features.music.desc"),
  },
  {
    Icon: Shirt,
    title: t("about.features.fashion.title"),
    description: t("about.features.fashion.desc"),
  },
  {
    Icon: BookOpen,
    title: t("about.features.education.title"),
    description: t("about.features.education.desc"),
  },
];

const stats = [
  {
    number: 10,
    suffix: "+",
    label: t("about.stats.history"),
  },
  {
    number: 8,
    suffix: "",
    label: t("about.stats.editions"),
  },
  {
    number: 100,
    suffix: "+",
    label: t("about.stats.artists"),
  },
  {
    number: 5000,
    suffix: "+",
    label: t("about.stats.attendees"),
  },
];
---

<section class="hm-section hm-section--alt about" id="sobre" aria-labelledby="about-title">
  <div class="fz-wrap">
    <header class="hm-head">
      <p class="fz-display hm-kicker">{t("about.mission")}</p>
      <h2 id="about-title" class="fz-display hm-title">{t("about.title")}</h2>
      <p class="hm-sub">
        {t("about.subtitle.part1")}
        <strong>{t("about.subtitle.part2")}</strong>
        {t("about.subtitle.part3")}
      </p>
    </header>

    <div class="about-content">
      <div class="about-text">
        <h3 class="fz-display about-h3">{t("about.community.title")}</h3>
        <p>
          {t("about.community.desc.part1")}
          <strong>{t("about.community.desc.part2")}</strong>
          {t("about.community.desc.part3")}
        </p>
        <ul class="hm-list">
          <li>{t("about.impact.school")}</li>
          <li>{t("about.impact.artists")}</li>
          <li>{t("about.impact.festivals")}</li>
          <li>{t("about.impact.education")}</li>
        </ul>
        <a href="#unirse" class="fz-button fz-button-solid">{t("about.cta")}</a>
      </div>

      <div class="about-features">
        {
          features.map((feature) => (
            <article class="hm-card feature-card">
              <feature.Icon size={28} class="feature-icon" />
              <h4 class="fz-display">{feature.title}</h4>
              <p>{feature.description}</p>
            </article>
          ))
        }
      </div>
    </div>

    <div class="about-stats">
      {
        stats.map((stat) => (
          <div class="stat-item">
            <span
              class="fz-display stat-number"
              data-target={stat.number}
              data-suffix={stat.suffix}
            >
              {stat.number}
              {stat.suffix}
            </span>
            <span class="stat-label">{stat.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .about-content {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 56px;
    align-items: start;
  }

  .about-h3 {
    margin: 0 0 12px;
    font-size: 30px;
    line-height: 1.05;
  }

  .about-text p {
    margin: 0 0 18px;
    font-size: 18px;
    line-height: 1.55;
    color: #e9e2d2;
  }

  .about-text strong {
    color: var(--fz-gold);
  }

  .about-features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .feature-card {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 24px;
  }

  .feature-card :global(.feature-icon) {
    color: var(--fz-red);
  }

  .feature-card h4 {
    margin: 4px 0 0;
    font-size: 24px;
  }

  .feature-card p {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: #cfc8b6;
  }

  .about-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 56px;
    padding: 36px 24px;
    background: var(--fz-night);
    text-align: center;
  }

  .stat-item {
    display: grid;
    gap: 6px;
  }

  .stat-number {
    font-size: clamp(40px, 5vw, 68px);
    line-height: 1;
    color: var(--fz-gold);
  }

  .stat-label {
    font-size: 15px;
    color: #cfc8b6;
  }

  @media (max-width: 900px) {
    .about-content {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

    .about-features {
      grid-template-columns: minmax(0, 1fr);
    }

    .about-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 16px;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const statsSection = document.querySelector(".about-stats");
    const statNumbers = document.querySelectorAll(".stat-number");

    const formatNumber = (num: number): string => {
      if (num >= 1000) {
        return (num / 1000).toFixed(0) + "K";
      }
      return num.toString();
    };

    const animateCounter = (element: Element) => {
      const target = parseInt(element.getAttribute("data-target") || "0");
      const suffix = element.getAttribute("data-suffix") || "";
      const duration = 2000;
      const startTime = performance.now();

      function updateCounter(currentTime: number) {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const easeOutExpo = 1 - Math.pow(2, -10 * progress);
        const current = Math.round(target * easeOutExpo);

        element.textContent = formatNumber(current) + suffix;

        if (progress < 1) {
          requestAnimationFrame(updateCounter);
        } else {
          element.textContent = formatNumber(target) + suffix;
        }
      }

      requestAnimationFrame(updateCounter);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            statNumbers.forEach((el) => animateCounter(el));
            observer.disconnect();
          }
        });
      },
      { threshold: 0.5 }
    );

    if (statsSection) {
      observer.observe(statsSection);
    }
  });
</script>
