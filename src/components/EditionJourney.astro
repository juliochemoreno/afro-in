---
// "The journey": the edition day by day, with the photo of each day following
// the scroll (FestivalScrolly).
import type { ImageMetadata } from "astro";
import FestivalScrolly, { type ScrollySlide } from "@/components/FestivalScrolly.astro";
import EditionVenue from "@/components/EditionVenue.astro";
import EditionDayHead from "@/components/EditionDayHead.astro";
import EditionActivities, { type EditionActivity } from "@/components/EditionActivities.astro";
import { useTranslations } from "@/i18n/utils";
import type { Lang } from "@/lib/programacion";

export interface JourneyStep {
  weekdayShort: string;
  weekdayLong: string;
  dayNumber: string;
  dayMonth: string;
  city: string;
  slides: ScrollySlide[];
  // Day (ISO), venue and city for the compact day bar.
  date: string;
  barVenue: string;
  barPlace: string;
  entries: { stopName: string; venue?: string; activities: EditionActivity[] }[];
}

interface Props {
  steps: JourneyStep[];
  lang: Lang;
}

const { steps, lang } = Astro.props;
const t = useTranslations(lang);
const panels = steps.map((step) => ({ slides: step.slides }));
---

<section class="fz-wrap fz-journey" aria-labelledby="fz-journey-title">
  <header class="fz-journey-head">
    <h2 id="fz-journey-title" class="fz-display fz-journey-title">{t("edition.journeyTitle")}</h2>
    <p class="fz-muted fz-journey-lead">{t("edition.journeyText").replace("{n}", String(steps.length))}</p>
  </header>

  <FestivalScrolly panels={panels}>
    <ol class="fz-journey-list">
      {steps.map((step, index) => (
        <li class="fz-scrolly-step fz-journey-day" data-step={String(index)}>
          <EditionDayHead index={index} total={steps.length} weekdayLong={step.weekdayLong} dayMonth={step.dayMonth} date={step.date} venue={step.barVenue} place={step.barPlace} lang={lang} />
          {step.entries.map((entry) => (
            <div class="fz-journey-entry">
              <EditionVenue name={entry.venue ?? entry.stopName} area={entry.venue ? entry.stopName : undefined} />
              <EditionActivities activities={entry.activities} lang={lang} />
            </div>
          ))}
        </li>
      ))}
    </ol>
  </FestivalScrolly>
</section>
