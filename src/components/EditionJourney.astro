---
// "The journey": the edition day by day, with the photo of each day following
// the scroll (FestivalScrolly).
import type { ImageMetadata } from "astro";
import FestivalScrolly from "@/components/FestivalScrolly.astro";
import { useTranslations } from "@/i18n/utils";
import type { Lang } from "@/lib/programacion";

export interface JourneyStep {
  weekdayShort: string;
  dayNumber: string;
  dayMonth: string;
  city: string;
  photo: ImageMetadata;
  photoPosition: string;
  entries: { stopName: string; venue?: string; href: string; items: string[] }[];
}

interface Props {
  steps: JourneyStep[];
  lang: Lang;
}

const { steps, lang } = Astro.props;
const t = useTranslations(lang);
const panels = steps.map((step) => ({
  photo: step.photo,
  photoPosition: step.photoPosition,
  title: `${step.weekdayShort} ${step.dayNumber}`,
  subtitle: step.city,
}));
---

<section class="fz-wrap fz-journey" aria-labelledby="fz-journey-title">
  <header class="fz-journey-head">
    <h2 id="fz-journey-title" class="fz-display fz-journey-title">{t("edition.journeyTitle")}</h2>
    <p class="fz-muted fz-journey-lead">{t("edition.journeyText")}</p>
  </header>

  <FestivalScrolly panels={panels}>
    <ol class="fz-journey-list">
      {steps.map((step, index) => (
        <li class="fz-scrolly-step" data-step={String(index)}>
          <p class="fz-journey-count">{index + 1} / {steps.length}</p>
          <h3 class="fz-display fz-journey-date">{step.dayMonth}</h3>
          {step.entries.map((entry) => (
            <div class="fz-journey-entry">
              <p class="fz-journey-where">
                {[entry.venue, entry.stopName].filter(Boolean).join(", ")}
              </p>
              {entry.items.length ? (
                <ul class="fz-journey-items">
                  {entry.items.map((item) => <li>{item}</li>)}
                </ul>
              ) : (
                <p class="fz-muted">{t("edition.agendaTba")}</p>
              )}
              <a class="fz-journey-link" href={entry.href}>
                {t("edition.journeyDayLink").replace("{name}", entry.stopName)}
              </a>
            </div>
          ))}
        </li>
      ))}
    </ol>
  </FestivalScrolly>
</section>
