---
// Home section of the 2027 edition in the festival language: red kicker, centred title and
// subtitle, two square cards (photo, badge, gold dates and place, highlights, link to the stop)
// and the Santa Marta pass block (price stages + buy), the same one as on the stop page.
import MapPin from "lucide-astro/MapPin";
import Calendar from "lucide-astro/Calendar";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations, getTranslatedPath } from "../i18n/utils";
import EditionTickets from "./EditionTickets.astro";
import { baseSlug, dateRange, dayCount, entryLang, joinList, stopPlace, stubRange } from "../lib/programacion";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const stops = (await getCollection("tour2027"))
  .filter((entry) => entryLang(entry.filePath!) === lang)
  .sort((a, b) => a.data.order - b.data.order);

const destinations = stops.map((stop, index) => {
  const slug = baseSlug(stop.filePath!);
  const key = slug === "santa-marta" ? "sm" : "plk";
  // Venues of the stop (short names) when it has them, else the town.
  const venues = [...new Set(stop.data.days.map((day) => day.venueShort ?? day.venue).filter((v): v is string => !!v))];
  return {
    id: index + 1,
    name: stop.data.name,
    dates: dateRange(stop.data.startDate, stop.data.endDate, lang),
    image: stop.data.cardImage,
    position: stop.data.cardPosition,
    location: venues.length ? joinList(venues, lang) : stopPlace(stop.data.location, stop.data.name),
    // What happens at the stop, without days or places (those are on the stop page).
    highlights: [1, 2, 3, 4, 5].map((n) => t(`events.${key}.h${n}` as never)),
    badge: t(index === 0 ? "events.stop1" : "events.stop2"),
    href: getTranslatedPath(`/programacion/2027/${slug}`, lang),
  };
});

// Stops that sell a pass show the same price-stage block as their own page, under the cards.
const passes = stops
  .filter((stop) => stop.data.tickets)
  .map((stop) => ({
    tickets: stop.data.tickets!,
    pass: {
      place: stop.data.name,
      range: dateRange(stop.data.startDate, stop.data.endDate, lang),
      stub: stubRange(stop.data.startDate, stop.data.endDate, lang),
      days: dayCount(stop.data.startDate, stop.data.endDate),
    },
  }));
---

<section class="hm-section events" id="afrotour" aria-labelledby="events-title">
  <div class="fz-wrap">
    <header class="hm-head">
      <p class="fz-display hm-kicker">{t("events.badge")}</p>
      <h2 id="events-title" class="fz-display hm-title">{t("events.title")}</h2>
      <p class="hm-sub">{t("events.subtitle")}</p>
    </header>

    <div class="stops">
      {
        destinations.map((dest) => (
          <article class="hm-card stop">
            <div class="stop-image">
              <Image
                src={dest.image}
                alt={dest.name}
                class="stop-img"
                style={`object-position: ${dest.position}`}
                loading="lazy"
                width={800}
                height={500}
                format="webp"
              />
              <span class="stop-badge">{dest.badge}</span>
            </div>
            <div class="stop-body">
              <h3 class="fz-display stop-name">{dest.name}</h3>
              <p class="stop-meta"><Calendar size={16} />{dest.dates}</p>
              <p class="stop-meta"><MapPin size={16} />{dest.location}</p>
              <ul class="hm-list stop-list">
                {dest.highlights.map((highlight) => <li>{highlight}</li>)}
              </ul>
              <a href={dest.href} class="fz-button fz-button-solid">{t("events.cta")}</a>
            </div>
          </article>
        ))
      }
    </div>

    {passes.map(({ tickets, pass }) => (
      <div class="events-pass">
        <EditionTickets tickets={tickets} lang={lang} pass={pass} />
      </div>
    ))}
  </div>
</section>

<style>
  .stops {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .stop {
    display: flex;
    flex-direction: column;
  }

  .stop-image {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .stop-image :global(.stop-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent);
    mask-image: linear-gradient(to bottom, #000 70%, transparent);
  }

  .stop-badge {
    position: absolute;
    left: 16px;
    top: 16px;
    padding: 6px 12px;
    background: var(--fz-red);
    color: #fff;
    font-size: 14px;
    font-weight: 600;
  }

  /* Column so the button sits at the bottom of both cards, whatever the list length. */
  .stop-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 8px 28px 32px;
  }

  .stop-body .fz-button {
    margin-top: auto;
  }

  .stop-name {
    margin: 0 0 4px;
    font-size: 34px;
    line-height: 1.05;
  }

  .stop-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: var(--fz-gold);
    font-weight: 600;
  }

  .stop-list {
    margin: 14px 0 20px;
  }

  .stop-list li {
    font-size: 16px;
  }

  .events-pass {
    margin-top: 56px;
  }

  @media (max-width: 900px) {
    .stops {
      grid-template-columns: minmax(0, 1fr);
    }

    .stop-body {
      padding: 4px 20px 28px;
    }
  }
</style>
