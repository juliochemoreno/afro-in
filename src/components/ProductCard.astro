---
import { formatPrice } from "@/lib/products";
import ImagePlaceholder from "./ImagePlaceholder.astro";
import {
  getLangFromUrl,
  getTranslatedPath,
  useTranslations,
} from "@/i18n/utils";

// Image-source agnostic: the store passes D1 products (images as {url}) and the
// home passes static products mapped to {url}. Localization is done inline so
// this card does not depend on either products module's shape.
interface CardProduct {
  slug: string;
  sku: string;
  name: { es: string; en: string; fr: string };
  category: { es: string; en: string; fr: string };
  price: number;
  priceUSD?: number | null;
  badge?: { es: string; en: string; fr: string } | null;
  sizes?: string[];
  images: { url: string }[];
}

interface Props {
  product: CardProduct;
  showQuickAdd?: boolean;
  lang?: "es" | "en" | "fr";
}

const { product, showQuickAdd = true, lang: langProp } = Astro.props;
const lang = langProp ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const safeLang = (lang === "en" || lang === "fr" ? lang : "es") as
  | "es"
  | "en"
  | "fr";
const localizedProduct = {
  name: product.name[safeLang],
  category: product.category[safeLang],
};
const productPath = getTranslatedPath(`/tienda/${product.slug}`, lang);
const mainImage = product.images[0]?.url ?? "";

// Badge = first tag's localized name (taxonomy), shown directly.
const translatedBadge = product.badge ? product.badge[safeLang] : null;
---

<div class="product-card" data-category={localizedProduct.category}>
  {translatedBadge && <span class="product-badge">{translatedBadge}</span>}
  <a href={productPath} class="product-link">
    <div class="product-image">
      {
        mainImage ? (
          <img
            src={mainImage}
            alt={localizedProduct.name}
            class="product-img"
            loading="lazy"
          />
        ) : (
          <ImagePlaceholder />
        )
      }
    </div>
    <h3 class="product-name">{localizedProduct.name}</h3>
  </a>
  <div class="product-info">
    <div class="product-prices">
      <span class="price-cop">{formatPrice(product.price)}</span>
      {
        product.priceUSD ? (
          <span class="price-usd">~${product.priceUSD} USD</span>
        ) : null
      }
    </div>
    <div class="product-actions">
      {
        product.sizes && product.sizes.length > 0 ? (
          <a href={productPath} class="btn btn-primary product-btn">
            {t("store.btn.viewOptions")}
          </a>
        ) : showQuickAdd ? (
          <button
            class="btn btn-primary product-btn quick-add"
            data-id={product.slug}
            data-slug={product.slug}
            data-sku={product.sku}
            data-name={localizedProduct.name}
            data-price={product.price}
            data-image={mainImage}
          >
            {t("store.btn.add")}
          </button>
        ) : (
          <a href={productPath} class="btn btn-primary product-btn">
            {t("store.btn.viewDetails")}
          </a>
        )
      }
    </div>
  </div>
</div>

<style>
  .product-card {
    position: relative;
    text-align: center;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .product-card.hidden {
    display: none;
  }

  .product-badge {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    z-index: 1;
    background: var(--color-primary);
    color: var(--color-white);
  }

  .product-image {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-sm);
  }

  .product-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .product-name {
    font-size: 1rem;
    color: var(--color-secondary);
    min-height: 2.4em; /* Ensure consistent height for titles */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-prices {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .price-cop {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .price-usd {
    font-size: 0.85rem;
    color: var(--color-text-light);
  }

  .product-btn {
    margin-top: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    font-size: 0.9rem;
    width: 100%;
    display: block;
  }

  .product-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .product-actions {
    margin-top: var(--space-sm);
  }

  @media (max-width: 600px) {
    .product-card {
      padding: var(--space-sm);
    }

    .price-cop {
      font-size: 1rem;
    }

    .product-name {
      font-size: 0.9rem;
    }

    .product-badge {
      font-size: 0.65rem;
      padding: 0.15rem 0.4rem;
      top: 0.5rem;
      right: 0.5rem;
    }
  }
</style>
