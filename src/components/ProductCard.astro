---
import { formatPrice } from "@/lib/products";
import ImagePlaceholder from "./ImagePlaceholder.astro";
import {
  getLangFromUrl,
  getTranslatedPath,
  useTranslations,
} from "@/i18n/utils";

// Image-source agnostic: the store passes D1 products (images as {url}) and the
// home passes static products mapped to {url}. Localization is done inline so
// this card does not depend on either products module's shape.
interface CardProduct {
  slug: string;
  sku: string;
  name: { es: string; en: string; fr: string };
  category: { es: string; en: string; fr: string };
  price: number;
  priceUSD?: number | null;
  badge?: { es: string; en: string; fr: string } | null;
  sizes?: string[];
  images: { url: string }[];
}

interface Props {
  product: CardProduct;
  showQuickAdd?: boolean;
  lang?: "es" | "en" | "fr";
}

const { product, showQuickAdd = true, lang: langProp } = Astro.props;
const lang = langProp ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const safeLang = (lang === "en" || lang === "fr" ? lang : "es") as
  | "es"
  | "en"
  | "fr";
const localizedProduct = {
  name: product.name[safeLang],
  category: product.category[safeLang],
};
const productPath = getTranslatedPath(`/tienda/${product.slug}`, lang);
const mainImage = product.images[0]?.url ?? "";

// Badge = first tag's localized name (taxonomy), shown directly.
const translatedBadge = product.badge ? product.badge[safeLang] : null;
---

<article
  class="hm-card product-card"
  data-category={localizedProduct.category}
>
  {translatedBadge && <span class="product-badge">{translatedBadge}</span>}
  <a href={productPath} class="product-image" tabindex="-1" aria-hidden="true">
    {
      mainImage ? (
        <img src={mainImage} alt="" class="product-img" loading="lazy" />
      ) : (
        <ImagePlaceholder />
      )
    }
  </a>
  <h3 class="fz-display product-name">
    <a href={productPath}>{localizedProduct.name}</a>
  </h3>
  <p class="product-prices">
    <span class="price-cop">{formatPrice(product.price)}</span>
    {
      product.priceUSD ? (
        <span class="price-usd">~${product.priceUSD} USD</span>
      ) : null
    }
  </p>
  {
    product.sizes && product.sizes.length > 0 ? (
      <a href={productPath} class="fz-button fz-button-solid product-btn">
        {t("store.btn.viewOptions")}
      </a>
    ) : showQuickAdd ? (
      <button
        type="button"
        class="fz-button fz-button-solid product-btn quick-add"
        data-id={product.slug}
        data-slug={product.slug}
        data-sku={product.sku}
        data-name={localizedProduct.name}
        data-price={product.price}
        data-image={mainImage}
      >
        {t("store.btn.add")}
      </button>
    ) : (
      <a href={productPath} class="fz-button fz-button-solid product-btn">
        {t("store.btn.viewDetails")}
      </a>
    )
  }
</article>

<style>
  /* The festival product card, shared by the home (FeaturedProducts) and the store.
     Dark square card, the photo on its own white panel, red square button. */
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 12px;
    text-align: center;
  }

  .product-card.hidden {
    display: none;
  }

  .product-badge {
    position: absolute;
    z-index: 1;
    top: 20px;
    right: 20px;
    padding: 3px 10px;
    background: var(--fz-red);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
  }

  .product-image {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    overflow: hidden;
    background: #fff;
  }

  .product-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.4s ease;
  }

  .product-card:hover .product-img {
    transform: scale(1.04);
  }

  .product-name {
    margin: 14px 0 6px;
    font-size: 22px;
    line-height: 1.05;
  }

  .product-name a {
    color: #fff;
    text-decoration: none;
  }

  .product-prices {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 2px 8px;
    margin: 0 0 14px;
  }

  .price-cop {
    color: var(--fz-gold);
    font-weight: 600;
  }

  .price-usd {
    font-size: 13px;
    color: #cfc8b6;
  }

  .product-btn {
    justify-content: center;
    margin-top: auto;
    min-height: 44px;
    padding: 0 12px;
    font: inherit;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }

  @media (max-width: 900px) {
    .product-card {
      padding: 8px;
    }

    .product-badge {
      top: 14px;
      right: 14px;
    }

    .product-name {
      font-size: 18px;
    }

    .product-btn {
      font-size: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-img {
      transition: none;
    }
  }
</style>
