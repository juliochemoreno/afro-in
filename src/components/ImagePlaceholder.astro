---
// Neutral placeholder shown when a product has no image, so the layout keeps
// its shape (fills the parent's aspect box).
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div class={`image-placeholder ${className}`} aria-label="Sin imagen">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width="40"
    height="40"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
    <circle cx="9" cy="9" r="2"></circle>
    <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
  </svg>
</div>

<style>
  .image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-cream-dark, #e8e5df);
    color: var(--color-text-light, #9a958c);
  }
</style>
