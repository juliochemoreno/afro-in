---
export const prerender = false;
import AdminLayout from "@/layouts/AdminLayout.astro";
import DonorsDashboard from "@/components/DonorsDashboard";
import { countries } from "@/data/countries";

// Access is protected via a session cookie set on /admin/login
// (see src/middleware.ts and src/lib/adminAuth.ts).

let donors: any[] = [];
let error: string | null = null;

try {
  const runtime = Astro.locals.runtime;
  if (runtime && runtime.env.DB) {
    const result = await runtime.env.DB.prepare(
      "SELECT * FROM donors ORDER BY created_at DESC"
    ).all();
    donors = result.results || [];
  } else {
    donors = [
      {
        id: 1,
        created_at: new Date().toISOString(),
        completed_at: new Date().toISOString(),
        name: "Donante de Prueba",
        email: "test@example.com",
        phone: "+57 300 123 4567",
        country: "CO",
        amount: 50000,
        status: "completed",
        provider: "bold",
        currency: "COP",
        provider_status: "APPROVED",
        message: "¡Mucha fuerza con el proyecto!",
      },
      {
        id: 2,
        created_at: new Date(Date.now() - 86400000).toISOString(),
        name: "Otro Donante",
        email: "otro@example.com",
        country: "ES",
        amount: 10,
        status: "pending",
        provider: "paypal",
        currency: "USD",
      },
    ];
    error = "Modo Desarrollo: Mostrando datos de prueba.";
  }
} catch (e: any) {
  console.error("Error fetching donors:", e);
  error = e.message;
}

// Enrich each donor with country flag + localized name for the UI.
const countryMap = new Map(countries.map((c) => [c.code, c]));
donors = donors.map((d) => {
  const c = d.country ? countryMap.get(String(d.country).toUpperCase()) : null;
  return { ...d, countryName: c?.name, countryEmoji: c?.emoji };
});

const generatedAt = new Date().toISOString();
---

<AdminLayout title="Aportes | AFRO IN Admin">
  <main class="flex h-full flex-col overflow-hidden">
    {
      error && (
        <div class="mx-6 mt-4 shrink-0 rounded-xl bg-amber-100 px-5 py-3 font-medium text-amber-800 dark:bg-amber-900/30 dark:text-amber-200">
          ⚠️ {error}
        </div>
      )
    }
    <DonorsDashboard
      client:only="react"
      donors={donors}
      generatedAt={generatedAt}
    />
  </main>
</AdminLayout>
