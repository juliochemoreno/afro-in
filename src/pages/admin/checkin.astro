---
export const prerender = false;
import DoorLayout from "@/layouts/DoorLayout.astro";
import CheckinScanner from "@/components/CheckinScanner";
import { isDoorHost } from "@/lib/doorHost";

// Access is protected via the session cookie (middleware guards /admin).
// Full-screen door on every host; the way back to the admin panel only on
// the main host.
const exitHref = isDoorHost(Astro.url.hostname) ? null : "/admin";
---

<DoorLayout title="Puerta | AFRO IN">
  <CheckinScanner client:only="react" exitHref={exitHref} />
</DoorLayout>
