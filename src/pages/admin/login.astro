---
export const prerender = false;
import Layout from "@/layouts/Layout.astro";
import DoorLayout from "@/layouts/DoorLayout.astro";
import Lock from "lucide-astro/Lock";
import { DOOR_PATH, isDoorHost } from "@/lib/doorHost";

// If already authenticated, bounce straight to the dashboard.
import { ADMIN_COOKIE, verifyAdminSession } from "@/lib/adminAuth";
// On the door host (checkin.afroin.org) the login leads to the door and
// shows no public-site chrome.
const door = isDoorHost(Astro.url.hostname);
const home = door ? DOOR_PATH : "/admin/donadores";
const env = (Astro.locals as any).runtime?.env ?? {};
const cookie = Astro.cookies.get(ADMIN_COOKIE)?.value;
const admin = await verifyAdminSession(env, cookie);
if (admin) {
  // Door accounts (D26) only ever land on the door.
  return Astro.redirect(admin.role === "door" ? DOOR_PATH : home, 302);
}

// Only same-site admin paths: `next` ends up in window.location after login.
const rawNext = Astro.url.searchParams.get("next") || "";
const nextParam = /^\/admin(\/|$)/.test(rawNext) ? rawNext : home;
const Shell = door ? DoorLayout : Layout;
const title = door ? "Puerta | AFRO IN" : "Acceso Admin | AFRO IN";
---

<Shell title={title}>
  <main class:list={["login-page", { door }]}>
    <div class="login-card">
      <div class="login-icon">
        <Lock size={26} />
      </div>
      <h1>{door ? "Puerta" : "Panel de Administración"}</h1>
      <p class="login-sub">Ingresa tus credenciales para continuar</p>

      <form id="loginForm" data-next={nextParam}>
        <div class="form-group">
          <label for="user">Usuario</label>
          <input
            type="text"
            id="user"
            name="user"
            autocomplete="username"
            required
          />
        </div>
        <div class="form-group">
          <label for="password">Contraseña</label>
          <input
            type="password"
            id="password"
            name="password"
            autocomplete="current-password"
            required
          />
        </div>

        <p class="login-error" id="loginError" hidden></p>

        <button type="submit" class="btn btn-primary btn-block" id="loginBtn">
          Ingresar
        </button>
      </form>
    </div>
  </main>
</Shell>

<style>
  .login-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 100px 1rem 40px;
    background: var(--color-cream);
  }

  .login-card {
    width: 100%;
    max-width: 400px;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 2.5rem 2rem;
    text-align: center;
  }

  .login-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--gradient-gold);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem;
  }

  .login-card h1 {
    font-size: 1.5rem;
    color: var(--color-secondary);
    margin-bottom: 0.25rem;
  }

  .login-sub {
    font-size: 0.95rem;
    color: var(--color-text-light);
    margin-bottom: 1.75rem;
  }

  .form-group {
    margin-bottom: 1rem;
    text-align: left;
  }

  .form-group label {
    display: block;
    font-weight: 500;
    font-size: 0.9rem;
    margin-bottom: 0.35rem;
    color: var(--color-text);
  }

  .form-group input {
    width: 100%;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--color-cream-dark);
    border-radius: var(--radius-md);
    font-family: inherit;
    font-size: 1rem;
    transition: all var(--transition-fast);
  }

  .form-group input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(227, 28, 37, 0.1);
  }

  .login-error {
    background: #fee2e2;
    color: #dc2626;
    border: 1px solid rgba(220, 38, 38, 0.2);
    padding: 0.6rem 0.85rem;
    border-radius: var(--radius-md);
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .btn-block {
    width: 100%;
    margin-top: 0.5rem;
  }

  /* Door host: dark, square, no public chrome (DoorLayout). */
  .login-page.door {
    min-height: 100dvh;
    padding: 1.5rem 1rem;
    background: #161616;
  }

  .door .login-card {
    background: transparent;
    box-shadow: none;
    border-radius: 0;
    padding: 0;
    color: #f3e9d2;
  }

  .door .login-icon {
    border-radius: 0;
    background: #d0342c;
  }

  .door h1 {
    font-family: "Anton", "Outfit", sans-serif;
    font-size: 2.5rem;
    font-weight: 400;
    text-transform: uppercase;
    color: #f3e9d2;
  }

  .door .login-sub,
  .door .form-group label {
    color: rgba(243, 233, 210, 0.7);
  }

  .door .form-group input {
    border-radius: 0;
    border: 1px solid rgba(243, 233, 210, 0.3);
    background: rgba(243, 233, 210, 0.06);
    color: #f3e9d2;
    padding: 0.85rem;
    font-size: 1.05rem;
  }

  .door .form-group input:focus {
    border-color: #f3e9d2;
    box-shadow: none;
  }

  .door .login-error {
    border-radius: 0;
  }

  .door .btn-block {
    border: 0;
    border-radius: 0;
    background: #d0342c;
    color: #fff;
    padding: 0.95rem;
    font-size: 1.05rem;
    font-weight: 700;
    cursor: pointer;
  }
</style>

<script>
  // The public Layout has the ClientRouter (astro:page-load); DoorLayout does
  // not, so also run once now. The flag keeps it from binding twice.
  const init = () => {
    const form = document.getElementById("loginForm") as HTMLFormElement | null;
    if (!form || form.dataset.bound) return;
    form.dataset.bound = "1";

    const errorEl = document.getElementById("loginError");
    const btn = document.getElementById("loginBtn") as HTMLButtonElement | null;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (errorEl) errorEl.hidden = true;

      const user = (document.getElementById("user") as HTMLInputElement).value;
      const password = (
        document.getElementById("password") as HTMLInputElement
      ).value;

      if (btn) {
        btn.disabled = true;
        btn.textContent = "Ingresando…";
      }

      try {
        const res = await fetch("/api/admin-login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ user, password }),
        });

        if (res.ok) {
          window.location.href = form.dataset.next || "/admin/donadores";
          return;
        }

        if (errorEl) {
          errorEl.textContent =
            res.status === 401
              ? "Usuario o contraseña incorrectos."
              : "No se pudo iniciar sesión. Inténtalo de nuevo.";
          errorEl.hidden = false;
        }
      } catch {
        if (errorEl) {
          errorEl.textContent = "Error de conexión. Inténtalo de nuevo.";
          errorEl.hidden = false;
        }
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.textContent = "Ingresar";
        }
      }
    });
  };
  document.addEventListener("astro:page-load", init);
  init();
</script>
