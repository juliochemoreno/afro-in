---
export const prerender = false;
import { getProductBySlug } from "@/lib/products";
import TiendaSlugTemplate from "@/templates/TiendaSlugTemplate.astro";

const { slug } = Astro.params;
const db = (Astro.locals as any).runtime?.env?.DB;
const product = db && slug ? await getProductBySlug(db, slug) : null;
if (!product) return Astro.redirect("/en/store", 302);
---

<TiendaSlugTemplate product={product} lang="en" />
