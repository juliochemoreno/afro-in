---
export const prerender = false;
import { getTicketOrderByToken } from "@/lib/tickets";
import EntradasTemplate from "@/templates/EntradasTemplate.astro";

const { token } = Astro.params;
const db = (Astro.locals as any).runtime?.env?.DB;
const view = db && token ? await getTicketOrderByToken(db, token) : null;
if (!view || !view.order) return Astro.redirect("/eventos", 302);
// Bearer page (the token is the only credential): never cache it, never leak
// the URL through the Referer header.
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
---

<EntradasTemplate lang="es" tokenOrder={view} permalink={Astro.url.href} />
