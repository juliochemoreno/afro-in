---
// Event page in the 2027 look (D18, option A "poster"): the photo on the left,
// facts, price stages and the buy box on the right, the description last.
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import FestivalFont from "@/components/FestivalFont.astro";
import Pin from "@/components/Pin.astro";
import Clock from "lucide-astro/Clock";
import TicketCheckoutForm from "@/components/TicketCheckoutForm";
import "@/styles/checkout-fields.css";
import "@/styles/festival.css";
import "@/styles/tickets-theme.css";
import { formatPrice } from "@/lib/cart";
import { countries } from "@/data/countries";
import type { PublicEvent } from "@/lib/tickets";
import { stageName, type StageStatus } from "@/lib/ticketStages";
import { calParts, eventTime, localeTag } from "@/lib/eventDisplay";
import { getTranslatedPath, useTranslations } from "@/i18n/utils";

interface Props {
  event: PublicEvent;
  lang?: string;
}

const { event, lang = "es" } = Astro.props;
const t = useTranslations(lang as any);

const tag = localeTag(lang);
const year = event.event_date.slice(0, 4);
const time = eventTime(event.event_date, lang);
const cal = calParts(event.event_date, lang);
// Short date over the title: "Dom 20 Dic 2026" (Julio: weekday and month abbreviated).
const cap = (w: string) => w.replace(/^./, (c) => c.toUpperCase());
const dateShort = [cap(cal.weekday), cal.day, cap(cal.month), year].filter(Boolean).join(" ");


const name =
  (lang === "en" ? event.name_en : lang === "fr" ? event.name_fr : event.name_es) ||
  event.name_es;
// Long event names step the title down so they still fit in a few lines.
const titleSize = name.length > 40 ? "is-long" : name.length > 24 ? "is-mid" : "";
const description =
  (lang === "en"
    ? event.description_en
    : lang === "fr"
      ? event.description_fr
      : event.description_es) || event.description_es || "";

const navLinks = [
  { href: getTranslatedPath("/", lang), label: t("nav.home") },
  { href: getTranslatedPath("/tienda", lang), label: t("nav.store") },
  { href: getTranslatedPath("/eventos", lang), label: t("nav.events") },
];

const successPath = getTranslatedPath("/entradas", lang);
const sale = event.sale;
const staged = event.stages.length > 0;
const notOpenYet = sale?.state === "upcoming";
const showRemaining = !event.soldOut && !notOpenYet && event.remaining <= 20;
const place = [event.city, event.department].filter(Boolean).join(" · ");

// Stage dates are whole Bogotá days; noon UTC keeps the day in any zone.
const fmtDay = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString(tag, {
    day: "numeric",
    month: "short",
    timeZone: "UTC",
  });
const fmtDayLong = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString(tag, {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });
const stageDates = (s: { starts_on: string; ends_on: string | null }) =>
  s.ends_on
    ? `${fmtDay(s.starts_on)} – ${fmtDay(s.ends_on)}`
    : t("tix.stages.from").replace("{date}", fmtDay(s.starts_on));
const STAGE_LABEL: Record<StageStatus, string> = {
  current: t("tix.stages.now"),
  soldout: t("tix.stages.soldout"),
  past: t("tix.stages.ended"),
  upcoming: t("tix.stages.upcoming"),
};
const priceLabel = (price: number) => (price === 0 ? t("tix.price.free") : formatPrice(price));

const T_KEYS = [
  "tix.form.quantity",
  "tix.form.qty.less",
  "tix.form.qty.more",
  "tix.form.name",
  "tix.form.name.ph",
  "tix.form.email",
  "tix.form.email.ph",
  "tix.form.phone",
  "tix.form.phone.ph",
  "phone.err",
  "phone.ph",
  "phone.dial.label",
  "phone.dial.search",
  "phone.dial.empty",
  "tix.form.total",
  "tix.form.total.free",
  "tix.form.pay",
  "tix.form.reserve",
  "tix.form.processing",
  "tix.form.securenote",
  "tix.form.err.name",
  "tix.form.err.email",
  "tix.form.err.generic",
  "tix.form.err.pricechanged",
  "tix.form.err.notopen",
  "tix.form.err.soldout",
  "tix.form.err.left",
  "tix.form.err.left.stage",
  "tix.form.err.taken",
  "tix.form.err.pending",
  "tix.price.free",
  "tix.detail.soldout.title",
  "tix.detail.soldout.text",
];
const strings = Object.fromEntries(T_KEYS.map((k) => [k, t(k as any)]));
---

<Layout title={name}>
  <FestivalFont slot="head" />
  <Header navLinks={navLinks} variant="festival" />
  <main class="fz tx-page evento-page">
    <div class="fz-wrap">
      {/* No "back to events" link: the menu's "Eventos" does it (Julio). */}
      <div class="evento-grid">
        <div class="evento-media">
          {
            /* The panel sits under the photo, so a missing or broken photo shows it. */
            <>
              <span class="evento-fallback fz-display" aria-hidden="true">AFRO IN</span>
              {event.image_r2_key && (
                <img class="evento-photo" src={`/media/${event.image_r2_key}`} alt={name} onerror="this.hidden=true" />
              )}
            </>
          }
        </div>

        <div class="evento-side">
          {/* Option B (Julio): the date over the title, then time and venue on one line. */}
          <p class="fz-display evento-kicker">{dateShort}</p>
          <h1 class:list={["fz-display evento-title", titleSize]}>{name}</h1>
          <p class="evento-meta">
            {time && (
              <span class="evento-meta-item">
                <Clock class="evento-meta-icon" size={20} aria-hidden="true" />
                {time}
              </span>
            )}
            {(event.venue || place) && (
              <span class="evento-meta-item">
                <Pin heavy />
                <span>
                  {event.venue || place}
                  {event.venue && place && <><span class="evento-sep" aria-hidden="true">·</span>{place}</>}
                </span>
              </span>
            )}
          </p>

          <section class="evento-tickets" aria-labelledby="evento-tickets-title">
            <div class="fz-tickets evento-tickets-inner">
              <h2 id="evento-tickets-title" class="fz-display">
                {staged ? t("tix.stages.title") : event.price === 0 ? t("tix.detail.reserve") : t("tix.detail.buy")}
              </h2>
              {
                staged ? (
                  <ul class="fz-tiers evento-tiers">
                    {event.stages.map((s) => (
                      <li data-stage={s.status}>
                        <span class:list={["fz-tier-flag", { "fz-tier-current": s.status === "current" }]}>
                          {STAGE_LABEL[s.status]}
                        </span>
                        <span class="evento-tier-name">{stageName(s, lang)}</span>
                        <span class="fz-display fz-tier-price">
                          {priceLabel(s.price)}
                        </span>
                        <span class="fz-muted evento-tier-dates">{stageDates(s)}</span>
                        {s.status === "current" && showRemaining && (
                          <span class="evento-tier-left">
                            {t("tix.detail.remaining.stage").replace("{n}", String(event.remaining))}
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="evento-single">
                    <span class="evento-price-row">
                      <span class="fz-display fz-tier-price">
                        {priceLabel(event.price)}
                      </span>
                      {event.price > 0 && <span class="evento-per">{t("tix.detail.perTicket")}</span>}
                    </span>
                    {showRemaining && (
                      <span class="evento-tier-left">
                        {t("tix.detail.remaining").replace("{n}", String(event.remaining))}
                      </span>
                    )}
                  </p>
                )
              }

              <div class="evento-buy">
                {staged && (
                  <h3 class="fz-display">
                    {event.price === 0 ? t("tix.detail.reserve") : t("tix.detail.buy")}
                  </h3>
                )}
                {notOpenYet && sale?.state === "upcoming" ? (
                  <div class="tix-soldout">
                    <p class="tix-soldout-title">{t("tix.stages.opens.title")}</p>
                    <p>{t("tix.stages.opens.text").replace("{date}", fmtDayLong(sale.opensOn))}</p>
                  </div>
                ) : (
                  <TicketCheckoutForm
                    client:load
                    lang={lang as any}
                    eventSlug={event.slug}
                    eventName={name}
                    countries={countries}
                    price={event.price}
                    remaining={event.remaining}
                    successPath={successPath}
                    t={strings}
                  />
                )}
              </div>
            </div>
          </section>

          {
            description && (
              <section class="evento-about" aria-labelledby="evento-about-title">
                <h2 id="evento-about-title" class="fz-display">{t("tix.detail.about")}</h2>
                <p class="evento-desc">{description}</p>
              </section>
            )
          }
        </div>
      </div>
    </div>
  </main>
  <Footer variant="festival" />
</Layout>

<style is:global>
  .evento-page {
    min-height: 100vh;
    padding-bottom: 80px;
  }
  /* The space the old "back" link used to give above the event. */
  .evento-page .evento-grid {
    margin-top: 40px;
  }

  /* Like the 2027 headliner: the photo stays in view on the left and melts
     into the page (mask, no frame); the text scrolls on the right. */
  .evento-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px;
    align-items: start;
  }
  .evento-media {
    position: sticky;
    top: 92px;
    height: clamp(480px, calc(100svh - 92px - 24px), 85svh);
    overflow: hidden;
    background: transparent;
  }
  .evento-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 14%, #000 86%, transparent 100%), linear-gradient(to bottom, transparent 0, #000 10%, #000 90%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 14%, #000 86%, transparent 100%), linear-gradient(to bottom, transparent 0, #000 10%, #000 90%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
  .evento-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 72px;
    color: var(--tx-line);
    background: radial-gradient(closest-side, var(--tx-soft), transparent);
  }
  .evento-kicker {
    margin: 0;
    font-size: 26px;
    color: var(--tx-accent);
  }
  .evento-title {
    margin: 6px 0 0;
    font-size: clamp(48px, 6vw, 84px);
    line-height: 0.95;
    color: var(--tx-fg);
    overflow-wrap: break-word;
  }
  .evento-title.is-mid {
    font-size: clamp(40px, 4.6vw, 64px);
  }
  .evento-title.is-long {
    font-size: clamp(32px, 3.6vw, 48px);
    line-height: 1;
  }
  .evento-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 20px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--tx-line);
    font-size: 18px;
    font-weight: 600;
    color: var(--tx-fg);
  }
  .evento-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .evento-meta .evento-meta-icon,
  .evento-meta .fz-pin {
    flex: none;
    width: 20px;
    height: 20px;
    margin: 0;
    color: var(--tx-accent);
  }
  .evento-sep {
    margin: 0 0.45em;
    color: var(--tx-muted);
  }
  /* Tickets: the 2027 block (gold double frame, stages with a gold top line,
     price in Anton), then the buy form inside the same frame. */
  /* A soft panel groups the purchase form; no gold frame (Julio). */
  .evento-tickets {
    margin-top: 32px;
    background: var(--tx-surface);
  }
  .evento-price-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 10px;
  }
  .evento-per {
    font-size: 15px;
    color: var(--tx-muted);
  }
  .fz-tickets.evento-tickets-inner h2 {
    color: var(--tx-fg);
  }
  .fz-tiers.evento-tiers {
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
  }
  .evento-tiers li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 4px 16px;
    padding: 14px 0;
  }
  .evento-tiers .fz-tier-flag {
    grid-column: 1 / -1;
    justify-self: start;
  }
  .evento-tier-name {
    font-weight: 600;
    font-size: 17px;
  }
  .evento-tiers .fz-tier-price {
    grid-row: span 2;
    text-align: right;
    white-space: nowrap;
  }
  .evento-tier-dates {
    font-size: 14px;
  }
  .evento-tier-left {
    grid-column: 1 / -1;
    font-size: 14px;
    font-weight: 600;
    color: var(--tx-accent);
  }
  .evento-tiers li[data-stage="soldout"] > :not(.fz-tier-flag) {
    opacity: 0.45;
  }
  .evento-tiers li[data-stage="past"] .fz-tier-price,
  .evento-tiers li[data-stage="soldout"] .fz-tier-price {
    text-decoration: line-through;
  }
  .evento-tiers li[data-stage="upcoming"] .fz-tier-price {
    color: var(--tx-fg);
  }
  .evento-single {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
  }
  .evento-page .fz-tier-price {
    color: var(--tx-accent);
  }
  .evento-buy {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--tx-line);
  }
  .fz-tickets .evento-buy h3 {
    margin: 0 0 4px;
    font-size: 28px;
    line-height: 1;
    color: var(--tx-fg);
  }
  .evento-about {
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--tx-line);
  }
  .evento-about h2 {
    margin: 0 0 14px;
    font-size: 40px;
    line-height: 1;
    color: var(--tx-fg);
  }
  .evento-desc {
    margin: 0;
    max-width: 62ch;
    font-size: 17px;
    line-height: 1.7;
    white-space: pre-line;
    color: var(--tx-fg);
  }

  /* Checkout form, dark. Selectors are as specific as the shared
     checkout-fields.css rules they override; the store and donation forms
     keep their light look. */
  .evento-page .tix-form {
    color: var(--tx-fg);
  }
  .evento-page .tix-form .ck-field {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .evento-page .tix-form .ck-field > label,
  .evento-page .tix-qty label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--tx-muted);
  }
  .evento-page .tix-form .ck-field input {
    width: 100%;
    min-height: 48px;
    padding: 0 14px;
    border: 1px solid var(--tx-field-line);
    border-radius: 0;
    background: var(--tx-field);
    color: var(--tx-fg);
    font-family: inherit;
    font-size: 16px;
  }
  /* Fields that have a fitting icon show it on the left (Julio's general rule). */
  .evento-page .tix-input-icon {
    position: relative;
    display: block;
  }
  .evento-page .tix-input-icon svg {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--tx-muted);
    pointer-events: none;
  }
  .evento-page .tix-form .tix-input-icon input {
    padding-left: 42px;
  }
  .evento-page .tix-form .ck-field input::placeholder {
    color: var(--tx-placeholder);
  }
  .evento-page .tix-form .ck-field input:focus,
  .evento-page .tix-form .ph-field:focus-within {
    outline: none;
    border-color: var(--tx-accent);
    box-shadow: 0 0 0 3px var(--tx-line);
  }
  .evento-page .tix-form .ph-field {
    min-height: 48px;
    border: 1px solid var(--tx-field-line);
    border-radius: 0;
    background: var(--tx-field);
  }
  .evento-page .tix-form .ph-field .cc-trigger.ph-dial {
    background: transparent;
    color: var(--tx-fg);
    border-right: 1px solid var(--tx-field-line);
    border-radius: 0;
  }
  .evento-page .tix-form .ph-field .cc-trigger.ph-dial:hover,
  .evento-page .tix-form .ph-field .cc-trigger.ph-dial[aria-expanded="true"] {
    background: var(--tx-soft);
  }
  .evento-page .tix-form .ck-field .ph-field input.ph-number {
    min-height: 46px;
    border: none;
    background: transparent;
    color: var(--tx-fg);
    box-shadow: none;
  }
  .evento-page .tix-form .ck-field.is-invalid input:not([type="hidden"]):not(.ph-number),
  .evento-page .tix-form .is-invalid .ph-field {
    border-color: var(--tx-error);
    background-color: var(--tx-error-bg);
  }
  .evento-page .tix-form .ck-field-error {
    margin: 0;
    color: var(--tx-error);
    font-weight: 500;
  }
  .evento-page .tix-qty {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .evento-page .tix-stepper {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .evento-page .tix-stepper button {
    width: 40px;
    height: 40px;
    border: 1px solid var(--tx-line);
    border-radius: 0;
    background: transparent;
    color: var(--tx-accent);
    font-size: 20px;
    cursor: pointer;
  }
  .evento-page .tix-stepper button:hover:not(:disabled) {
    border-color: var(--tx-accent);
  }
  .evento-page .tix-stepper button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .evento-page .tix-stepper span {
    min-width: 2ch;
    text-align: center;
    font-family: "Anton", sans-serif;
    font-size: 24px;
    color: var(--tx-fg);
  }
  .evento-page .tix-total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-top: 22px;
    padding-top: 16px;
    border-top: 1px solid var(--tx-line);
    color: var(--tx-fg);
  }
  .evento-page .tix-total strong {
    font-family: "Anton", sans-serif;
    font-weight: 400;
    font-size: 32px;
    line-height: 1;
    color: var(--tx-accent);
    text-align: right;
  }
  .evento-page .tix-form .ck-error {
    margin: 16px 0 0;
    padding: 10px 12px;
    border-left: 4px solid var(--fz-red);
    background: var(--tx-error-bg);
    color: var(--tx-fg);
    font-size: 15px;
    font-weight: 500;
  }
  .evento-page .tix-pay {
    width: 100%;
    min-height: 54px;
    margin-top: 16px;
    border-radius: 0;
    background: var(--fz-red);
    border-color: var(--fz-red);
    color: #fff;
    font-size: 17px;
  }
  .evento-page .tix-pay:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .evento-page .tix-pay:focus-visible,
  .evento-page .tix-stepper button:focus-visible {
    outline: 2px solid var(--tx-accent);
    outline-offset: 3px;
  }
  .evento-page .tix-secure {
    margin: 10px 0 0;
    text-align: center;
    font-size: 13px;
    color: var(--tx-muted);
  }
  .evento-page .tix-soldout {
    padding: 8px 0;
  }
  .evento-page .tix-soldout p {
    margin: 0;
    color: var(--tx-muted);
  }
  .evento-page .tix-soldout .tix-soldout-title {
    margin-bottom: 6px;
    font-weight: 600;
    color: var(--tx-fg);
  }

  /* Below 1024px the photo is a 16:10 band on top, edge to edge, fading at the bottom. */
  @media (max-width: 1023px) {
    .evento-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
    .evento-media {
      position: relative;
      top: auto;
      height: auto;
      aspect-ratio: 16 / 10;
      margin-inline: calc(-1 * var(--fz-bleed));
    }
    .evento-photo {
      -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 62%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 0, #000 62%, transparent 100%);
    }
    .evento-page .evento-grid {
      margin-top: 20px;
    }
  }
  @media (max-width: 720px) {
    .evento-kicker {
      font-size: 20px;
    }
    .evento-meta {
      font-size: 16px;
    }
    .evento-about h2 {
      font-size: 32px;
    }
  }
  @media (max-width: 480px) {
    .fz-tickets.evento-tickets-inner {
      padding: 20px 14px;
    }
    .evento-page .tix-total strong {
      font-size: 26px;
    }
  }
</style>
