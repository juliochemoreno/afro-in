---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ImagePlaceholder from "@/components/ImagePlaceholder.astro";
import { getVisibleEvents } from "@/lib/tickets";
import { formatPrice } from "@/lib/cart";
import { getTranslatedPath, useTranslations } from "@/i18n/utils";

interface Props {
  lang?: string;
}

const { lang = "es" } = Astro.props;
const t = useTranslations(lang as any);

const db = (Astro.locals as any).runtime?.env?.DB;
const events = db ? await getVisibleEvents(db) : [];

const localeTag = lang === "en" ? "en-US" : lang === "fr" ? "fr-FR" : "es-CO";
const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString(localeTag, {
    day: "numeric",
    month: "long",
    year: "numeric",
  });

const localizedName = (e: (typeof events)[number]) =>
  (lang === "en" ? e.name_en : lang === "fr" ? e.name_fr : e.name_es) ||
  e.name_es;

const navLinks = [
  { href: getTranslatedPath("/", lang), label: t("nav.home") },
  { href: getTranslatedPath("/tienda", lang), label: t("nav.store") },
  { href: getTranslatedPath("/eventos", lang), label: t("nav.events") },
];
const eventPath = (slug: string) =>
  getTranslatedPath(`/eventos/${slug}`, lang);
---

<Layout title={`${t("tix.list.title")} | AFRO IN`}>
  <Header navLinks={navLinks} />
  <main class="events-page">
    <div class="container">
      <div class="events-hero">
        <h1>{t("tix.list.title")}</h1>
        <p>{t("tix.list.subtitle")}</p>
      </div>

      {
        events.length === 0 ? (
          <p class="events-empty">{t("tix.list.empty")}</p>
        ) : (
          <div class="events-grid">
            {events.map((e) => (
              <a href={eventPath(e.slug)} class="event-card">
                <div class="event-image">
                  {e.image_r2_key ? (
                    <img src={`/media/${e.image_r2_key}`} alt={localizedName(e)} />
                  ) : (
                    <ImagePlaceholder />
                  )}
                  {e.soldOut && (
                    <span class="event-soldout">{t("tix.list.soldout")}</span>
                  )}
                </div>
                <div class="event-body">
                  <h2>{localizedName(e)}</h2>
                  <p class="event-date">{fmtDate(e.event_date)}</p>
                  {(e.venue || e.city) && (
                    <p class="event-venue">
                      {[e.venue, e.city].filter(Boolean).join(" · ")}
                    </p>
                  )}
                  <span class="event-price">{formatPrice(e.price)}</span>
                </div>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .events-page {
    padding: var(--space-xl) 0;
    padding-top: 120px;
    min-height: 100vh;
    background: var(--color-cream);
  }
  .events-hero {
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  .events-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--color-secondary);
    margin-bottom: var(--space-md);
  }
  .events-hero p {
    font-size: 1.2rem;
    color: var(--color-text-light);
    max-width: 600px;
    margin: 0 auto;
  }
  .events-empty {
    text-align: center;
    color: var(--color-text-light);
    padding: var(--space-xl) 0;
  }
  .events-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }
  .event-card {
    background: var(--color-white);
    border: 1px solid var(--color-cream-dark);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }
  .event-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  .event-image {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--color-cream);
    overflow: hidden;
  }
  .event-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .event-soldout {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-secondary);
    color: var(--color-white);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }
  .event-body {
    padding: var(--space-lg);
  }
  .event-body h2 {
    font-size: 1.25rem;
    color: var(--color-secondary);
    margin-bottom: var(--space-xs);
  }
  .event-date {
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.95rem;
    text-transform: capitalize;
  }
  .event-venue {
    color: var(--color-text-light);
    font-size: 0.9rem;
    margin-top: 2px;
  }
  .event-price {
    display: inline-block;
    margin-top: var(--space-sm);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--color-secondary);
  }
  @media (max-width: 968px) {
    .events-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .events-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
