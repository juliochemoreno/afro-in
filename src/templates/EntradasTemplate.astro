---
// "Tus entradas" in the 2027 look (D18, option A "paper ticket"): the stubs
// are cream paper with a dark band, the QR always sits on pure white, and the
// page prints as plain black on white.
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import FestivalFont from "@/components/FestivalFont.astro";
import TicketReceipt from "@/components/TicketReceipt";
import TicketList from "@/components/TicketList";
import type { TicketOrderView } from "@/lib/tickets";
import { shortDate } from "@/lib/eventDisplay";
import { getTranslatedPath, useTranslations } from "@/i18n/utils";
// Static asset (no astro:assets optimizing: SSR page, rule 4).
import heroPhoto from "@/assets/img/2017/2017-afroin-img-1.jpg";
import "@/styles/festival.css";
import "@/styles/tickets-theme.css";

interface Props {
  lang?: string;
  /** Provided only by the permanent /entradas/[token] page. */
  tokenOrder?: TicketOrderView;
  /** Canonical permalink for the token page. */
  permalink?: string;
}

const { lang = "es", tokenOrder, permalink } = Astro.props;
const t = useTranslations(lang as any);

const navLinks = [
  { href: getTranslatedPath("/", lang), label: t("nav.home") },
  { href: getTranslatedPath("/eventos", lang), label: t("nav.events") },
];

const T_KEYS = [
  "tix.receipt.loading",
  "tix.receipt.success.title",
  "tix.receipt.success.text",
  "tix.receipt.pending.title",
  "tix.receipt.pending.text",
  "tix.receipt.failed.title",
  "tix.receipt.failed.text",
  "tix.receipt.event",
  "tix.receipt.number",
  "tix.receipt.yourtickets",
  "tix.receipt.savelink.title",
  "tix.receipt.savelink.text",
  "tix.receipt.copy",
  "tix.receipt.copied",
  "tix.receipt.continue",
  "tix.receipt.print",
  "tix.receipt.prev",
  "tix.receipt.next",
  "tix.receipt.ticketn",
  "tix.ticket.code",
  "tix.ticket.used",
  "tix.ticket.kind",
];
const strings = Object.fromEntries(T_KEYS.map((k) => [k, t(k as any)]));

const eventsPath = getTranslatedPath("/eventos", lang);
const ticketsPath = getTranslatedPath("/entradas", lang);

const tokenCompleted =
  tokenOrder?.order && tokenOrder.order.status === "completed";

// Build "date · venue, city" subtitle for the ticket stubs (token page).
function buildSubtitle(ev: any): string | null {
  if (!ev) return null;
  const parts: string[] = [];
  const day = ev.event_date ? shortDate(ev.event_date, lang) : null;
  if (day) parts.push(day);
  const place = [ev.venue, ev.city].filter(Boolean).join(", ");
  if (place) parts.push(place);
  return parts.join(" · ") || null;
}
const tokenSubtitle = tokenOrder ? buildSubtitle(tokenOrder.event) : null;
const tokenImage = tokenOrder?.event?.image_r2_key
  ? `/media/${tokenOrder.event.image_r2_key}`
  : null;
---

<Layout title={t("tix.receipt.yourtickets")} noindex={true}>
  <FestivalFont slot="head" />
  <Header navLinks={navLinks} variant="festival" />
  <main class="fz tx-page tix-page">
    <section class="fz-photo-hero tx-hero tix-hero">
      <img src={heroPhoto.src} alt="" class="fz-photo-hero-img" decoding="async" />
      <div class="fz-wrap fz-photo-hero-content">
        <p class="fz-display fz-gold tx-hero-kicker">AFRO IN</p>
        <h1 class="fz-display tx-hero-title">{t("tix.receipt.yourtickets")}</h1>
      </div>
    </section>
    <div class="tix-wrap">
      {
        tokenOrder ? (
          tokenCompleted ? (
            <div class="tix-success">
              <div class="tix-success-head">
                <div class="receipt-badge ok" aria-hidden="true">
                  ✓
                </div>
                <h2>{t("tix.receipt.success.title")}</h2>
              </div>
              <TicketList
                client:load
                eventName={tokenOrder.order!.event_name}
                eventSubtitle={tokenSubtitle}
                eventImage={tokenImage}
                eventDate={tokenOrder.event?.event_date ?? null}
                lang={lang}
                orderNumber={tokenOrder.order!.id}
                tickets={tokenOrder.tickets}
                permalink={permalink ?? null}
                t={strings}
              />
              <a href={eventsPath} class="btn btn-primary tix-continue">
                {t("tix.receipt.continue")}
              </a>
            </div>
          ) : (
            <TicketReceipt
              client:load
              t={strings}
              eventsPath={eventsPath}
              ticketsPath={ticketsPath}
              initialOrderId={tokenOrder.order!.bold_order_id}
              lang={lang}
            />
          )
        ) : (
          <TicketReceipt
            client:only="react"
            t={strings}
            eventsPath={eventsPath}
            ticketsPath={ticketsPath}
            lang={lang}
          />
        )
      }
    </div>
  </main>
  <Footer variant="festival" />
</Layout>

<style is:global>
  .tix-page {
    /* The stub is paper in both themes; it only gets an edge on a light page. */
    --tx-paper: #f3e9d2;
    --tx-paper-ink: #1b1714;
    --tx-paper-muted: #6b6458;
    --tx-band: #1f1f1f;
    --tx-stub-shadow: 0 14px 34px rgba(0, 0, 0, 0.5);
    min-height: 70vh;
    padding-bottom: 72px;
  }
  @media (prefers-color-scheme: light) {
    .tix-page {
      --tx-paper: #fffdf8;
      --tx-stub-shadow: 0 0 0 1px rgba(27, 23, 20, 0.12), 0 12px 28px rgba(27, 23, 20, 0.14);
    }
  }
  .fz.tx-page .tix-hero {
    min-height: 260px;
  }
  .tix-hero .fz-photo-hero-img {
    object-position: 50% 30%;
  }
  .tix-hero .tx-hero-title {
    font-size: clamp(44px, 7vw, 80px);
  }
  .tix-wrap {
    max-width: 640px;
    margin: 0 auto;
    padding: 40px 16px 0;
  }

  /* Pending / failed / loading */
  .tix-page .receipt {
    border: 1px solid var(--tx-accent);
    text-align: center;
  }
  .tix-page .receipt > * {
    margin-left: auto;
    margin-right: auto;
  }
  .tix-page .receipt h2,
  .tix-success-head h2 {
    margin: 0 0 10px;
    font-family: "Anton", var(--font-heading, "Outfit"), sans-serif;
    font-weight: 400;
    font-size: clamp(34px, 6vw, 48px);
    line-height: 1.05;
    color: var(--tx-fg);
  }
  .tix-page .receipt {
    padding: clamp(24px, 6vw, 40px) clamp(16px, 5vw, 40px);
    outline: 1px solid var(--tx-line);
    outline-offset: -9px;
  }
  .tix-page .receipt-text {
    margin: 0 auto 24px;
    max-width: 44ch;
    color: var(--tx-muted);
  }
  .tix-page .receipt-badge {
    width: 60px;
    height: 60px;
    margin: 0 auto 14px;
    border: 2px solid currentColor;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    background: transparent;
  }
  .tix-page .receipt-badge.ok {
    color: var(--tx-accent);
  }
  .tix-page .receipt-badge.pending {
    color: var(--tx-accent);
  }
  .tix-page .receipt-badge.fail {
    color: var(--fz-red);
  }
  .tix-page .receipt-status {
    text-align: center;
    padding: 48px 0;
    color: var(--tx-muted);
  }
  .tix-page .receipt-spinner {
    width: 38px;
    height: 38px;
    margin: 0 auto 16px;
    border: 3px solid var(--tx-line);
    border-top-color: var(--tx-accent);
    border-radius: 50%;
    animation: receipt-spin 0.8s linear infinite;
  }
  @keyframes receipt-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tix-page .receipt-spinner {
      animation-duration: 2.4s;
    }
  }
  .fz.tix-page .btn,
  .tix-page .btn.btn-primary {
    border-radius: 0;
    background: var(--fz-red);
    border-color: var(--fz-red);
    color: #fff;
  }

  /* Success */
  .tix-success {
    text-align: center;
  }
  .tix-success-head {
    margin-bottom: 20px;
  }
  .tix-success .receipt-text {
    color: var(--tx-muted);
  }

  /* Order line */
  .tix-list {
    text-align: left;
  }
  .tix-list-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 28px;
    max-width: 440px;
    margin: 0 auto 28px;
    padding: 10px 0;
    border-top: 1px solid var(--tx-line);
    border-bottom: 1px solid var(--tx-line);
  }
  .tix-list-row {
    display: flex;
    gap: 8px;
    align-items: baseline;
    min-width: 0;
    font-size: 14px;
    color: var(--tx-muted);
  }
  .tix-list-row strong {
    color: var(--tx-fg);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .tix-list-title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .tix-single,
  .tix-slider {
    margin-bottom: 20px;
  }
  .tix-single {
    display: flex;
    justify-content: center;
  }
  .tix-single .tix-stub {
    width: 340px;
    max-width: 100%;
  }
  .tix-slider {
    position: relative;
  }
  .tix-slider-track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding: 6px 4px 18px;
    scrollbar-width: none;
  }
  .tix-slider-track::-webkit-scrollbar {
    display: none;
  }
  .tix-slide {
    flex: 0 0 min(340px, 86%);
    scroll-snap-align: center;
    display: flex;
    justify-content: center;
  }
  .tix-slide .tix-stub {
    width: 100%;
  }
  .tix-slider-arrow {
    position: absolute;
    top: 42%;
    transform: translateY(-50%);
    z-index: 3;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--tx-accent);
    border-radius: 0;
    background: var(--tx-bg);
    color: var(--tx-accent);
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  .tix-slider-arrow.prev {
    left: -6px;
  }
  .tix-slider-arrow.next {
    right: -6px;
  }
  .tix-slider-arrow:disabled {
    opacity: 0;
    pointer-events: none;
  }
  .tix-dots {
    display: flex;
    justify-content: center;
    gap: 6px;
  }
  .tix-dot {
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    position: relative;
  }
  .tix-dot::after {
    content: "";
    position: absolute;
    inset: 8px;
    border-radius: 50%;
    background: var(--tx-line);
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .tix-dot.on::after {
    background: var(--tx-accent);
    transform: scale(1.3);
  }
  @media (max-width: 640px) {
    .tix-slider-arrow {
      display: none;
    }
  }

  /* Ticket stub: dark band, perforation, paper body */
  .tix-stub {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--tx-paper);
    color: var(--tx-paper-ink);
    box-shadow: var(--tx-stub-shadow);
    text-align: left;
  }
  .tix-stub.used {
    filter: grayscale(0.85);
    opacity: 0.8;
  }
  .tix-stub-banner {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 18px 18px;
    background: var(--tx-band);
    color: #f3e9d2;
    border-bottom: 3px solid #e6b84a;
  }
  .tix-stub-top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #e6b84a;
  }
  .tix-stub-name {
    font-family: "Anton", var(--font-heading, "Outfit"), sans-serif;
    font-size: 30px;
    line-height: 1.05;
    overflow-wrap: anywhere;
  }
  .tix-stub-meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .tix-stub-cal {
    flex: none;
    width: 46px;
    padding: 4px 0 5px;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #e6b84a;
    color: #161616;
  }
  .tix-stub-cal-wd {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.2;
  }
  .tix-stub-cal-num {
    font-family: "Anton", sans-serif;
    font-size: 22px;
    line-height: 1;
  }
  .tix-stub-sub {
    font-size: 13px;
    color: #c9bfa8;
  }
  .tix-stub-perf {
    position: relative;
    height: 0;
    margin: 0 16px;
    border-top: 2px dashed rgba(27, 23, 20, 0.25);
  }
  /* Notches cut out of the paper show the page behind it. */
  .tix-stub-perf::before,
  .tix-stub-perf::after {
    content: "";
    position: absolute;
    top: -12px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--tx-bg);
  }
  .tix-stub-perf::before {
    left: -28px;
  }
  .tix-stub-perf::after {
    right: -28px;
  }
  .tix-stub-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 22px 18px 20px;
  }
  .tix-stub-qr {
    position: relative;
  }
  .tix-stub-qr-box {
    padding: 14px;
    background: #fff;
    line-height: 0;
  }
  .tix-stub-qr img {
    display: block;
    width: 200px;
    max-width: 100%;
    height: auto;
    aspect-ratio: 1;
    image-rendering: pixelated;
  }
  .tix-stub-qr-ph {
    width: 200px;
    max-width: 100%;
    aspect-ratio: 1;
    background: #eee;
  }
  .tix-stub-used {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-14deg);
    padding: 6px 18px;
    background: var(--fz-red);
    color: #fff;
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .tix-stub-code {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }
  .tix-stub-code-label {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tx-paper-muted);
  }
  .tix-stub-code-value {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--tx-paper-ink);
  }

  /* Print + save link + continue */
  .tix-print {
    display: block;
    margin: 4px auto 28px;
    padding: 10px 18px;
    border: 1px solid var(--tx-accent);
    background: transparent;
    color: var(--tx-accent);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .tix-print:hover {
    color: var(--tx-fg);
  }
  .tix-savelink {
    max-width: 460px;
    margin: 0 auto;
    padding-top: 16px;
    border-top: 1px solid var(--tx-line);
    text-align: left;
  }
  .tix-savelink-title {
    margin: 0 0 4px;
    font-weight: 600;
    color: var(--tx-fg);
  }
  .tix-savelink-text {
    margin: 0 0 12px;
    font-size: 14px;
    color: var(--tx-muted);
  }
  .tix-savelink-row {
    display: flex;
    gap: 8px;
  }
  .tix-savelink-row input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid var(--tx-field-line);
    background: var(--tx-field);
    color: var(--tx-fg);
    font-size: 13px;
  }
  .tix-page .tix-savelink-row .btn {
    white-space: nowrap;
    padding: 0 16px;
    min-height: 44px;
    background: transparent;
    border: 1px solid var(--tx-accent);
    color: var(--tx-accent);
  }
  @media (max-width: 480px) {
    .tix-savelink-row {
      flex-direction: column;
    }
    .tix-page .tix-savelink-row .btn {
      width: 100%;
    }
  }
  .tix-page .tix-continue {
    display: inline-block;
    margin-top: 28px;
  }
  .tix-page :focus-visible {
    outline: 2px solid var(--tx-accent);
    outline-offset: 3px;
  }

  /* Printing: black on white, every ticket stacked, nothing else. */
  @media print {
    @page {
      margin: 12mm;
    }
    body,
    .fz.tx-page {
      background: #fff !important;
      color: #000 !important;
      padding-top: 0 !important;
    }
    /* Site header and footer (the stub's own <header> stays). */
    header:not(.tix-stub-banner),
    footer,
    .tix-hero,
    .whatsapp-float,
    .tix-success-head,
    .tix-list-head,
    .tix-print,
    .tix-savelink,
    .tix-continue,
    .tix-slider-arrow,
    .tix-dots {
      display: none !important;
    }
    .tix-wrap {
      max-width: none;
      padding: 0;
    }
    .tix-slider-track {
      display: block;
      overflow: visible;
      padding: 0;
    }
    .tix-slide,
    .tix-single {
      display: block;
      margin: 0 auto 10mm;
    }
    .tix-stub {
      width: 90mm !important;
      margin: 0 auto 10mm;
      break-inside: avoid;
      box-shadow: none;
      border: 1px solid #000;
      background: #fff;
      color: #000;
    }
    .tix-stub-banner {
      background: #fff;
      color: #000;
      border-bottom: 1px solid #000;
    }
    .tix-stub-top,
    .tix-stub-sub,
    .tix-stub-code-label {
      color: #000;
    }
    .tix-stub-cal {
      background: #fff;
      border: 1px solid #000;
    }
    .tix-stub-perf {
      border-top-color: #000;
    }
    .tix-stub-perf::before,
    .tix-stub-perf::after {
      display: none;
    }
    /* Background fills don't print: the "used" stamp gets ink of its own. */
    .tix-stub.used {
      filter: none;
      opacity: 1;
    }
    .tix-stub-used {
      background: #fff;
      color: #000;
      border: 2px solid #000;
    }
  }
</style>
