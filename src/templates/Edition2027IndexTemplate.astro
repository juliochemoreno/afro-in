---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import FestivalFont from "@/components/FestivalFont.astro";
import { artistPhoto, artistPhotoMobile, daySlides } from "@/lib/artistPhotos";
import { resolveSignup } from "@/lib/activitySignup";
import Pin from "@/components/Pin.astro";
import Flag from "@/components/Flag.astro";
import EditionPartners from "@/components/EditionPartners.astro";
import EditionTickets from "@/components/EditionTickets.astro";
import EditionCountries from "@/components/EditionCountries.astro";
import EditionHeadliner from "@/components/EditionHeadliner.astro";
import EditionJourney, { type JourneyStep } from "@/components/EditionJourney.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { getTranslatedPath, useTranslations } from "@/i18n/utils";
import {
  baseSlug,
  dateRange,
  dayAnchor,
  dayLabel,
  shortDateList,
  entryLang,
  activityArtistIds,
  stopPlace,
  artistLines,
  artistAppearances,
  isComingSoon,
  joinList,
  journeyDays,
  type Lang,
} from "@/lib/programacion";
import heroPhoto from "@/assets/img/2017/2017-afroin-img-7.jpg";
import { editionNav } from "@/lib/editionNav";
import "@/styles/festival.css";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const t = useTranslations(lang);

const stops = (await getCollection("tour2027"))
  .filter((entry) => entryLang(entry.filePath!) === lang)
  .sort((a, b) => a.data.order - b.data.order);

const artists = (await getCollection("artists2027")).sort((a, b) => a.data.order - b.data.order);

const stopCards = stops.map((stop) => {
  return {
    id: stop.id,
    name: stop.data.name,
    range: dateRange(stop.data.startDate, stop.data.endDate, lang),
    place: `${stopPlace(stop.data.location, stop.data.name)}, ${t("edition.stopCountry")}`,
    comingSoon: isComingSoon(stop.data.days),
    href: getTranslatedPath(`/programacion/2027/${baseSlug(stop.filePath!)}`, lang),
    tickets: stop.data.tickets,
    cardImage: stop.data.cardImage,
    cardPosition: stop.data.cardPosition,
  };
});


const artistsById = new Map(artists.map((artist) => [artist.id, artist.data]));
const journey: JourneyStep[] = journeyDays(
  stops.map((stop) => ({ ...stop.data, slug: baseSlug(stop.filePath!) }))
).map(({ date, entries }) => {
  const label = dayLabel(date, lang);
  const withPhoto = entries.find((entry) => entry.day.photo);
  const dayArtists = entries
    .flatMap((entry) => entry.day.activities)
    .filter((activity) => !activity.appearanceOnly)
    .flatMap((activity) =>
      activityArtistIds(activity).map((id) => ({ id, ...artistsById.get(id)!, time: activity.time }))
    );
  // One time per artist for the day: the first one the agenda gives.
  const timeByArtist = new Map<string, string>();
  for (const artist of dayArtists) if (artist.time && !timeByArtist.has(artist.id)) timeByArtist.set(artist.id, artist.time);
  const placeOf = (stop: { name: string; location: string }) =>
    `${stop.location.split(",")[0].trim()}, ${t("edition.stopCountry")}`;
  const venueEntry = withPhoto ?? entries[0];
  return {
    ...label,
    city: joinList([...new Set(entries.map((entry) => entry.stop.name))], lang),
    date,
    barVenue: joinList([...new Set(entries.map((entry) => entry.day.venue ?? entry.stop.name))], lang),
    barPlace: joinList([...new Set(entries.map((entry) => entry.stop.location.split(",")[0].trim()))], lang),
    slides: daySlides(
      withPhoto?.day.photo
        ? {
            photos: [withPhoto.day.photo, ...withPhoto.day.morePhotos],
            position: withPhoto.day.photoPosition,
            positions: withPhoto.day.photoPositions,
            name: venueEntry.day.venue ?? venueEntry.stop.name,
            place: placeOf(venueEntry.stop),
          }
        : undefined,
      dayArtists.map((artist) => ({ ...artist, time: timeByArtist.get(artist.id) })),
      { photo: entries[0].stop.cardImage, name: entries[0].day.venue ?? entries[0].stop.name, place: placeOf(entries[0].stop) },
      lang
    ),
    entries: entries.map(({ stop, day }) => ({
      stopName: stop.name,
      venue: day.venue,
      activities: day.activities.filter((activity) => !activity.appearanceOnly).map((activity) => ({
        ...activity,
        ...resolveSignup(activity, lang, t),
        artistLines: artistLines(activity.title, activityArtistIds(activity).map((id) => artistsById.get(id)), lang),
      })),
    })),
  };
});
const headliner = artists.find((artist) => artist.data.featured);
const headlinerAppearances = headliner
  ? artistAppearances(
      headliner.id,
      stops.map((stop) => ({ slug: baseSlug(stop.filePath!), name: stop.data.name, days: stop.data.days }))
    ).map((a) => {
      const label = dayLabel(a.date, lang);
      return {
        when: `${label.weekdayShort} ${label.dayMonth}`,
        where: [a.venue, a.stopName].filter(Boolean).join(", "),
        title: a.title,
        href: `${getTranslatedPath(`/programacion/2027/${a.stopSlug}`, lang)}#${dayAnchor(a.date)}`,
      };
    })
  : [];
// Dates and short venue names of each artist across both stops, from the agenda.
const whenByArtist = new Map<string, { dates: string[]; venues: string[] }>();
for (const stop of stops) {
  for (const day of stop.data.days) {
    for (const activity of day.activities) {
      for (const id of activityArtistIds(activity)) {
        const entry = whenByArtist.get(id) ?? { dates: [], venues: [] };
        const venue = day.venueShort ?? day.venue ?? stop.data.name;
        if (!entry.dates.includes(day.date)) entry.dates.push(day.date);
        if (!entry.venues.includes(venue)) entry.venues.push(venue);
        whenByArtist.set(id, entry);
      }
    }
  }
}
const artistCards = artists.map((artist) => {
  const when = whenByArtist.get(artist.id);
  return {
    ...artist.data,
    photo: artistPhoto(artist.id, artist.data.photo),
    dates: when ? shortDateList(when.dates, lang) : undefined,
    venues: when ? when.venues.join(", ") : undefined,
  };
});

const { navLinks, ctaLink } = editionNav(lang);
---

<Layout title={t("edition.pageTitle")} description={t("edition.tagline")}>
  <FestivalFont slot="head" />
  <Header navLinks={navLinks} ctaLink={ctaLink} variant="festival" />

  <main class="fz edition">
    <section class="fz-photo-hero edition-hero">
      <Image src={heroPhoto} alt="" widths={[768, 1296]} sizes="100vw" loading="eager" class="fz-photo-hero-img" />
      <div class="fz-wrap fz-photo-hero-content">
        <p class="edition-tagline">{t("edition.tagline")}</p>
        <h1 class="edition-title">
          <span class="fz-display edition-title-red">AFRO IN</span>
          <span class="fz-display fz-gold">2027</span>
        </h1>
        <EditionCountries artists={artists.map((a) => a.data)} lang={lang} />
      </div>
    </section>

    <section class="fz-wrap edition-intro">
      <h2 class="fz-display edition-intro-title">{t("edition.introTitle")}</h2>
      <p class="edition-intro-text">{t("edition.introText")}</p>
    </section>

    {headliner && (
      <div class="fz-wrap edition-headliner">
        <EditionHeadliner
          artist={{ ...headliner.data, photo: artistPhoto(headliner.id, headliner.data.photo), photoMobile: artistPhotoMobile(headliner.id) }}
          appearances={headlinerAppearances}
          lang={lang}
        >
          {stopCards.filter((stop) => stop.tickets).map((stop) => (
            <EditionTickets
              tickets={stop.tickets!}
              lang={lang}
              heading={`${t("edition.ticketsTitle")} · ${stop.name}`}
              bare
            />
          ))}
        </EditionHeadliner>
      </div>
    )}


    <section class="edition-stops-section" aria-labelledby="edition-stops-title">
      <header class="fz-wrap edition-section-head">
        <h2 id="edition-stops-title" class="fz-display edition-h2">{t("edition.stopsTitle")}</h2>
        <p class="fz-muted edition-lead">{t("edition.stopsText")}</p>
      </header>
      <div class="edition-stops">
        {stopCards.map((stop) => (
          <a class="edition-stop" href={stop.href}>
            <Image src={stop.cardImage} alt="" widths={[480, 960]} sizes="(max-width: 1023px) 100vw, 50vw" class="edition-stop-photo" style={`object-position: ${stop.cardPosition}`} />
            <span class="edition-stop-bottom">
              <span class="edition-stop-range">{stop.range}</span>
              <span class="edition-stop-title">
                <span class="fz-display edition-stop-name">{stop.name}</span>
                <span class="edition-stop-arrow" aria-hidden="true">→</span>
              </span>
              <span class="edition-stop-place"><Pin /><span>{stop.place}</span></span>
            </span>
            <span class="edition-stop-sr">{stop.comingSoon ? t("edition.comingSoon") : t("edition.viewProgram")}</span>
          </a>
        ))}
      </div>
    </section>

    <EditionJourney steps={journey} lang={lang} />



    <section class="fz-wrap edition-block" aria-labelledby="edition-artists">
      <h2 id="edition-artists" class="fz-display edition-h2">{t("edition.artistsTitle")}</h2>
      <p class="fz-muted edition-lead">{t("edition.artistsText").replace("{n}", String(new Set(artists.map((a) => a.data.countryCode).filter(Boolean)).size))}</p>
      <div class="edition-artists">
        {artistCards.map((artist) => (
          <article class="edition-artist">
            <Image
              src={artist.photo}
              alt={artist.name}
              widths={[320, 640]}
              sizes="(max-width: 720px) 50vw, 380px"
              class="edition-artist-photo"
              style={`object-position: ${artist.photoPosition}`}
            />
            <div class="edition-artist-top">
              <p class="edition-artist-country">{artist.countryCode && artist.country && <Flag code={artist.countryCode} name={artist.country[lang]} />}{artist.country?.[lang]}</p>
              {artist.dates && <p class="edition-artist-dates">{artist.dates}</p>}
            </div>
            <div class="edition-artist-bottom">
              <h3 class="fz-display edition-artist-name">{artist.name}</h3>
              {artist.venues && <p class="edition-artist-venues" title={artist.venues}>{artist.venues}</p>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <EditionPartners lang={lang} />
  </main>

  <Footer variant="festival" />
</Layout>

<style>
  .edition-hero .fz-photo-hero-content {
    padding-top: 160px;
    padding-bottom: 48px;
  }

  .edition-tagline {
    margin: 0 0 12px;
    font-size: 18px;
    color: var(--fz-cream);
  }

  .edition-intro {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 48px;
    align-items: start;
  }

  .edition-intro-title {
    margin: 0;
    font-size: clamp(48px, 6vw, 88px);
    line-height: 0.95;
    color: var(--fz-gold);
  }

  .edition-intro-text {
    margin: 0;
    font-size: clamp(19px, 1.6vw, 24px);
    line-height: 1.55;
    max-width: 52ch;
  }

  /* Stop card: a wide photo fills it; department and dates on top, name and places at the bottom. */
  .edition-stop-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 10%, #000 90%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 10%, #000 90%, transparent 100%);
  }

  .edition-title {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
    align-items: baseline;
    font-weight: 400;
    line-height: 0.9;
    font-size: clamp(72px, 13vw, 184px);
  }

  .edition-title-red {
    color: var(--fz-red);
  }

  .edition-stops {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  /* Full screen width: two photos side by side with a small gap, faded only at the top and the
     bottom; the outer screen edges stay sharp. Text scales with the cards. */
  .edition-stop {
    position: relative;
    display: block;
    height: clamp(480px, 70svh, 85svh);
    overflow: hidden;
    background: transparent;
    border: 0;
    box-shadow: none;
    text-decoration: none;
  }

  .fz .edition-stop {
    color: var(--fz-cream);
  }

  .edition-stop::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(transparent 45%, rgba(14, 10, 8, 0.85));
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 10%, #000 90%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 10%, #000 90%, transparent 100%);
  }

  .edition-stop-bottom {
    position: absolute;
    z-index: 2;
    bottom: 10%;
    left: var(--fz-bleed);
    right: 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .edition-stop:last-child .edition-stop-bottom {
    left: clamp(24px, 4vw, 64px);
    right: clamp(24px, 3vw, 48px);
  }

  .edition-stop-range {
    color: #e6b84a;
    font-weight: 500;
    font-size: clamp(15px, 1.4vw, 18px);
  }

  .edition-stop-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .edition-stop-name {
    font-size: clamp(32px, 4vw, 64px);
    line-height: 1.05;
    white-space: nowrap;
    color: #f3e9d2;
  }

  .edition-stop-place {
    display: flex;
    align-items: center;
    font-size: clamp(14px, 1.25vw, 16px);
    color: #bfb39c;
    min-width: 0;
  }

  .edition-stop-place span {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .edition-stop-arrow {
    flex: none;
    font-size: clamp(22px, 1.9vw, 24px);
    line-height: 1;
    color: #e6b84a;
    transition: transform 0.2s ease;
  }

  .edition-stop:hover .edition-stop-arrow,
  .edition-stop:focus-visible .edition-stop-arrow {
    transform: translateX(4px);
  }

  .edition-stop:focus-visible {
    outline: 2px solid #e6b84a;
    outline-offset: 3px;
  }

  .edition-stop-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .edition-stop-arrow {
      transition: none;
    }
  }

  .edition-h2 {
    margin: 0 0 8px;
    font-size: 64px;
    line-height: 1;
  }

  .edition-lead {
    margin: 0 0 32px;
    font-size: 18px;
    max-width: 60ch;
  }

  .edition-artists {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  /* Guest card: the photo fills it; country and dates on top, name and venues at the bottom, over soft scrims. */
  .edition-artist {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #2a2018;
  }

  .edition-artist::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(rgba(14, 10, 8, 0.85), transparent 30%, transparent 55%, rgba(14, 10, 8, 0.92));
  }

  .edition-artist-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .edition-artist-top,
  .edition-artist-bottom {
    position: absolute;
    left: 10px;
    right: 10px;
    z-index: 2;
  }

  .edition-artist-top {
    top: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .edition-artist-top p {
    margin: 0;
    font-size: 14px;
    white-space: nowrap;
  }

  .edition-artist-country {
    display: flex;
    align-items: center;
    color: #d9ccb3;
    min-width: 0;
  }

  .edition-artist-dates {
    color: #e6b84a;
    font-weight: 500;
  }

  .edition-artist-bottom {
    bottom: 12px;
    left: 12px;
    right: 12px;
  }

  .edition-artist-name {
    margin: 0;
    font-size: 24px;
    line-height: 1.05;
    color: #f3e9d2;
  }

  .edition-artist-venues {
    margin: 4px 0 0;
    font-size: 13px;
    color: #bfb39c;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* 9 artists: 3 x 3 on desktop and tablets; 2 columns on small tablets and phones, where the odd
     last card spans both columns as a wide card. */
  @media (max-width: 900px) {
    .edition-artists {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }

    .edition-artist:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      aspect-ratio: 16 / 10;
    }
  }

  /* Stacked, edge to edge, below 1024px (side by side the halves would be too narrow and tall). */
  @media (max-width: 1023px) {
    .edition-stops {
      grid-template-columns: minmax(0, 1fr);
    }

    .edition-stop {
      height: auto;
      aspect-ratio: 16 / 10;
    }

    .edition-stop .edition-stop-bottom,
    .edition-stop:last-child .edition-stop-bottom {
      left: var(--fz-bleed);
      right: var(--fz-bleed);
    }
  }

  @media (max-width: 720px) {
    .edition-hero .fz-photo-hero-content {
      padding-top: 96px;
    }


    .edition-intro {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }

    .edition-h2 {
      font-size: 40px;
    }

    .edition-artists {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .edition-artist-name {
      font-size: 19px;
    }

    .edition-artist-top p {
      font-size: 12px;
    }
  }
</style>
