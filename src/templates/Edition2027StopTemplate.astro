---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import FestivalFont from "@/components/FestivalFont.astro";
import { daySlides } from "@/lib/artistPhotos";
import { resolveSignup } from "@/lib/activitySignup";
import StopLinkCard from "@/components/StopLinkCard.astro";
import DayCalendar from "@/components/DayCalendar.astro";
import EditionVenue from "@/components/EditionVenue.astro";
import EditionTickets from "@/components/EditionTickets.astro";
import FestivalScrolly from "@/components/FestivalScrolly.astro";
import EditionDayHead from "@/components/EditionDayHead.astro";
import EditionActivities from "@/components/EditionActivities.astro";
import { getEntries, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { getTranslatedPath, useTranslations } from "@/i18n/utils";
import { activityArtistIds, artistLines, baseSlug, dateRange, dayAnchor, dayLabel, isComingSoon, stopPlace, type Lang } from "@/lib/programacion";
import { editionNav } from "@/lib/editionNav";
import "@/styles/festival.css";

interface Props {
  entry: CollectionEntry<"tour2027">;
  allStops: CollectionEntry<"tour2027">[];
  lang?: Lang;
}

const { entry, allStops, lang = "es" } = Astro.props;
const { data } = entry;
const t = useTranslations(lang);

const year = data.startDate.slice(0, 4);
const range = dateRange(data.startDate, data.endDate, lang, { withYear: true });
const comingSoon = isComingSoon(data.days);

const artistRefs = data.days.flatMap((day) =>
  day.activities.flatMap((activity) => [activity.artist, activity.coArtist].filter((ref) => !!ref))
);
const artistEntries = await getEntries(artistRefs);
const artistsById = new Map(artistEntries.map((artist) => [artist.id, artist.data]));

const days = data.days.map((day) => {
  const label = dayLabel(day.date, lang);
  return {
    ...day,
    ...label,
    anchor: dayAnchor(day.date),
    activities: day.activities.filter((activity) => !activity.appearanceOnly).map((activity) => ({
      ...activity,
      ...resolveSignup(activity, lang, t),
      artistLines: artistLines(activity.title, activityArtistIds(activity).map((id) => artistsById.get(id)), lang),
    })),
  };
});

// Photos following each day: the venue's, then the artists of its agenda.
// The day links name the venue only when the days differ in it (Palenque is one place all along).
const distinctVenues = new Set(days.map((day) => day.venue ?? data.name)).size > 1;
const place = `${data.location.split(",")[0].trim()}, ${t("edition.stopCountry")}`;
const panels = days.map((day) => {
  const name = day.venue ?? data.name;
  return {
    slides: daySlides(
      day.photo
        ? { photos: [day.photo, ...day.morePhotos], position: day.photoPosition, positions: day.photoPositions, name, place }
        : undefined,
      day.activities.flatMap((activity) =>
        activityArtistIds(activity).map((id) => ({ id, ...artistsById.get(id)!, time: activity.time }))
      ),
      { photo: data.cardImage, name, place },
      lang
    ),
  };
});

const nextStop = allStops
  .filter((stop) => stop.data.order > data.order)
  .sort((a, b) => a.data.order - b.data.order)[0];
const prevStop = allStops
  .filter((stop) => stop.data.order < data.order)
  .sort((a, b) => b.data.order - a.data.order)[0];
// The neighbouring stop shown as a wide card: the next one, else the previous one.
const linkedStop = nextStop ?? prevStop;
const linkedStopCard = linkedStop && {
  href: getTranslatedPath(`/programacion/2027/${baseSlug(linkedStop.filePath!)}`, lang),
  image: linkedStop.data.cardImage,
  position: linkedStop.data.cardPosition,
  kicker: t(nextStop ? "edition.nextStop" : "edition.prevStop"),
  range: dateRange(linkedStop.data.startDate, linkedStop.data.endDate, lang),
  name: linkedStop.data.name,
  place: `${stopPlace(linkedStop.data.location, linkedStop.data.name)}, ${t("edition.stopCountry")}`,
  linkText: t("edition.viewStop").replace("{name}", linkedStop.data.name),
};

// "<" escaped so content can never close the JSON-LD script tag.
const eventSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Event",
  name: `AFRO IN ${year} – ${data.name}`,
  description: data.intro,
  startDate: data.startDate,
  endDate: data.endDate,
  eventStatus: "https://schema.org/EventScheduled",
  location: {
    "@type": "Place",
    name: data.location,
    address: { "@type": "PostalAddress", addressLocality: data.name, addressCountry: "CO" },
  },
  performer: [...artistsById.values()].map((artist) => ({ "@type": "Person", name: artist.name })),
  organizer: { "@type": "Organization", name: "AFRO IN", url: "https://afroin.org" },
}).replace(/</g, "\\u003c");

const { navLinks, ctaLink } = editionNav(lang);
---

<Layout title={`${data.name} · AFRO IN ${year}`} description={data.intro}>
  <FestivalFont slot="head" />
  <script type="application/ld+json" set:html={eventSchema} />
  <Header navLinks={navLinks} ctaLink={ctaLink} variant="festival" />

  <main class="fz stop">
    <section class="fz-photo-hero stop-hero">
      <Image
        src={data.heroImage}
        alt=""
        widths={[768, 1440]}
        sizes="100vw"
        loading="eager"
        class="fz-photo-hero-img"
        style={`object-position: ${data.heroPosition}`}
      />
      <div class="fz-wrap fz-photo-hero-content">
        <div class="stop-hero-text">
        <a class="stop-back" href={getTranslatedPath("/programacion", lang)}>{t("edition.backToEdition")}</a>
        <p class="fz-display fz-gold stop-range">{range}</p>
        <h1 class="fz-display stop-name">{data.name}</h1>
        <p class="stop-intro">{data.intro}</p>
        {!comingSoon && (
          <nav class="stop-daynav" aria-label={t("edition.days")}>
            {days.map((day) => (
              <a class="stop-daylink" href={`#${day.anchor}`}>
                <DayCalendar weekday={day.weekdayShort} number={day.dayNumber} />
                <span class="stop-daylink-text">
                  {distinctVenues && <span class="stop-daylink-venue">{day.venue ?? data.name}</span>}
                  {day.hint && <span class="stop-daylink-hint">{day.hint}</span>}
                </span>
              </a>
            ))}
          </nav>
        )}
        </div>
      </div>
    </section>

    <div class="fz-wrap stop-days">
      {comingSoon ? (
        <div class="fz-tba">
          <p class="fz-display fz-tba-title">{t("edition.agendaTba")}</p>
          <p class="fz-muted">{t("edition.agendaTbaText")}</p>
        </div>
      ) : (
        <FestivalScrolly panels={panels}>
          {days.map((day, index) => (
            <section id={day.anchor} class="fz-scrolly-step stop-day" data-step={String(index)}>
              <EditionDayHead
                index={index}
                total={days.length}
                weekdayLong={day.weekdayLong}
                dayMonth={day.dayMonth}
                date={day.date}
                venue={day.venue ?? data.name}
                place={data.location.split(",")[0].trim()}
                lang={lang}
                headingLevel="h2"
              />
              {day.venue && <EditionVenue name={day.venue} area={day.venueArea} />}
              <EditionActivities activities={day.activities} lang={lang} headingLevel="h3" />
            </section>
          ))}
        </FestivalScrolly>
      )}
    </div>

    {data.tickets && (
      <div class="fz-wrap stop-tickets">
        <EditionTickets tickets={data.tickets} lang={lang} />
      </div>
    )}

    {linkedStopCard && (
      <div class="stop-link-wrap">
        <StopLinkCard {...linkedStopCard} />
      </div>
    )}
  </main>

  <Footer variant="festival" />
</Layout>

<style>
  .stop-hero .fz-photo-hero-content {
    padding-top: 120px;
    padding-bottom: 48px;
  }

  .stop-back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 15px;
  }

  /* One fluid scale for both stop pages: small on phones, up to 96px / 32px / 18px on desktop. */
  .stop-range {
    margin: 12px 0 0;
    font-size: clamp(20px, 5.4vw, 32px);
  }

  .stop-name {
    margin: 4px 0 0;
    font-size: clamp(40px, 11vw, 96px);
    line-height: 0.95;
  }

  .stop-intro {
    margin: 20px 0 0;
    font-size: clamp(16px, 1.4vw + 5px, 18px);
    line-height: 1.5;
    max-width: 60ch;
  }

  .stop-daynav {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
  }

  .fz .stop-daylink {
    --fz-cal-num: 28px;
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--fz-cream);
    text-decoration: none;
  }

  .stop-daylink-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .stop-daylink-venue {
    font-size: 15px;
  }

  .stop-daylink-hint {
    font-size: 13px;
    color: var(--fz-muted);
  }

  .fz .stop-daylink:hover .stop-daylink-venue,
  .fz .stop-daylink:focus-visible .stop-daylink-venue {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .stop-day {
    justify-content: flex-start;
    padding: 48px 0;
    scroll-margin-top: 96px;
  }

  @media (max-width: 720px) {
    /* Two columns, small type: the hint may take two lines but is never cut. */
    .stop-daynav {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin-top: 24px;
    }

    .stop-intro {
      margin-top: 16px;
    }

    .fz .stop-daylink {
      --fz-cal-num: 22px;
      gap: 10px;
      min-height: 44px;
      align-items: center;
    }

    .stop-daylink .fz-cal {
      width: 40px;
    }

    .stop-daylink-venue {
      font-size: 13px;
    }

    .stop-daylink-hint {
      font-size: 12px;
      line-height: 1.3;
    }

    .stop-hero .fz-photo-hero-content {
      padding-top: 96px;
    }

    .stop-day {
      padding: 24px 0;
      /* Below the header and the pinned photo when jumping to a day. */
      scroll-margin-top: calc(120px + 38vh);
    }

  }
</style>
