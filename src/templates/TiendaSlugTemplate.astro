---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import FestivalFont from "@/components/FestivalFont.astro";
import ProductCard from "@/components/ProductCard.astro";
import "@/styles/festival.css";
import ImagePlaceholder from "@/components/ImagePlaceholder.astro";
import {
  getRelatedProducts,
  formatPrice,
  type DbProduct,
  getLocalizedProduct,
} from "@/lib/products";
import { getTranslatedPath, useTranslations } from "@/i18n/utils";

interface Props {
  product: DbProduct;
  lang?: string;
}

const { product, lang = "es" } = Astro.props;
const localizedProduct = getLocalizedProduct(product, lang);
const db = (Astro.locals as any).runtime?.env?.DB;
const relatedProducts = db ? await getRelatedProducts(db, product.slug, 4) : [];
const mainImage = product.images[0]?.url ?? "";

const t = useTranslations(lang as any);
---

<Layout title={`${localizedProduct.name} | Tienda AFRO IN`}>
  <FestivalFont slot="head" />
  <Header variant="festival" />
  <main class="fz product-page">
    <div class="fz-wrap">
      <!-- Breadcrumb -->
      <nav class="breadcrumb">
        <a href={getTranslatedPath("/tienda", lang)}
          >{t("store.product.back")}</a
        >
      </nav>

      <!-- Product Content -->
      <div class="product-grid">
        <!-- Gallery -->
        <div class="product-gallery">
          <div class="main-image">
            {
              mainImage ? (
                <img
                  src={mainImage}
                  alt={localizedProduct.name}
                  class="gallery-img"
                  loading="eager"
                />
              ) : (
                <ImagePlaceholder class="gallery-img" />
              )
            }
            {
              localizedProduct.badge && (
                <span class="product-badge">{localizedProduct.badge}</span>
              )
            }
          </div>
          {
            product.images.length > 1 && (
              <div class="thumbnail-strip">
                {product.images.map((img, i) => (
                  <button
                    class={`thumb ${i === 0 ? "active" : ""}`}
                    data-index={i}
                  >
                    <img src={img.url} alt={`${localizedProduct.name} ${i + 1}`} />
                  </button>
                ))}
              </div>
            )
          }
        </div>

        <!-- Details -->
        <div class="product-details">
          <div class="product-info-header">
            <span class="fz-display category-badge">{localizedProduct.category}</span>
          </div>
          <h1 class="fz-display product-name">{localizedProduct.name}</h1>

          <div class="product-prices">
            <span class="price-cop">{formatPrice(product.price)}</span>
            <span class="price-usd">~${product.priceUSD} USD</span>
          </div>

          <p class="product-description">{localizedProduct.description}</p>

          <!-- Product Actions: Size/Color Selection + Add to Cart -->
          <div
            class="product-actions"
            id="product-actions"
            data-product-id={product.id}
            data-product-slug={product.slug}
            data-product-sku={product.sku}
            data-product-name={localizedProduct.name}
            data-product-price={product.price}
            data-product-image={mainImage}
            data-product-instock={product.inStock}
            data-product-sizes={product.sizes?.join(",") || ""}
            data-product-colors={localizedProduct.colors
              .map((c) => c.name)
              .join(",")}
          >
            {
              product.sizes && product.sizes.length > 0 && (
                <div class="variant-selector">
                  <label>{t("store.product.size")}</label>
                  <div class="variant-options size-options">
                    {product.sizes.map((size) => (
                      <button
                        class="variant-btn"
                        data-size={size}
                        type="button"
                      >
                        {size}
                      </button>
                    ))}
                  </div>
                  <span
                    class="size-error"
                    id="size-error"
                    style="display: none;"
                  >
                    {t("store.product.sizeError")}
                  </span>
                </div>
              )
            }

            {
              localizedProduct.colors.length > 0 && (
                <div class="variant-selector">
                  <label>{t("store.product.color")}</label>
                  <div class="variant-options color-options">
                    {localizedProduct.colors.map((color) => (
                      <button
                        class="variant-btn"
                        data-color={color.name}
                        type="button"
                      >
                        {color.hex && (
                          <span
                            class="color-swatch"
                            style={`background:${color.hex}`}
                          />
                        )}
                        {color.name}
                      </button>
                    ))}
                  </div>
                </div>
              )
            }

            <button
              class="fz-button fz-button-solid btn-add-cart"
              id="add-to-cart-btn"
              disabled={!product.inStock}
              data-added-text={t("store.product.added")}
            >
              {t("store.product.addToCart")}
            </button>

            {
              !product.inStock && (
                <p class="stock-status">{t("store.product.stock.out")}</p>
              )
            }
          </div>

          <ul class="hm-list product-meta">
            <li>{t("store.product.shipping.colombia")}</li>
            <li>{t("store.product.shipping.whatsapp")}</li>
            <li>{t("store.product.shipping.return")}</li>
          </ul>
        </div>
      </div>

      <!-- Related Products -->
      {
        relatedProducts.length > 0 && (
          <section class="related-products">
            <h2 class="fz-display">{t("store.product.related")}</h2>
            <div class="fz-product-grid">
              {relatedProducts.map((related) => (
                <ProductCard product={related} lang={lang as any} showQuickAdd={false} />
              ))}
            </div>
          </section>
        )
      }
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .product-page {
    padding-bottom: 88px;
  }

  .breadcrumb {
    padding: 32px 0 20px;
  }

  .breadcrumb a {
    color: #cfc8b6;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--fz-gold);
  }

  .product-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    margin-bottom: 64px;
  }

  .product-gallery {
    position: sticky;
    top: 100px;
    align-self: start;
  }

  .main-image {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    overflow: hidden;
    background: #fff;
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 24px;
  }

  .product-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    padding: 3px 10px;
    background: var(--fz-red);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
  }

  .thumbnail-strip {
    display: flex;
    gap: 10px;
    margin-top: 12px;
    overflow-x: auto;
  }

  .thumb {
    flex: none;
    width: 76px;
    height: 76px;
    padding: 0;
    border: 0;
    background: #fff;
    cursor: pointer;
  }

  .thumb.active,
  .thumb:hover {
    outline: 2px solid var(--fz-red);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product-details {
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-self: start;
  }

  .product-info-header {
    margin: 0;
  }

  .category-badge {
    font-size: 20px;
    color: var(--fz-red);
  }

  .product-name {
    margin: 0;
    font-size: clamp(34px, 4vw, 52px);
    line-height: 1.02;
    color: #fff;
  }

  .product-prices {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .price-cop {
    font-size: 34px;
    font-weight: 600;
    color: var(--fz-gold);
  }

  .price-usd {
    font-size: 14px;
    color: #cfc8b6;
  }

  .product-description {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: #e9e2d2;
  }

  .variant-selector {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .variant-selector label {
    font-weight: 600;
    color: #fff;
  }

  .variant-options {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .variant-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 52px;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 0;
    background: transparent;
    color: #fff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .variant-btn:hover {
    border-color: var(--fz-gold);
  }

  .variant-btn.selected {
    border-color: var(--fz-red);
    background: var(--fz-red);
  }

  .variant-btn:focus-visible {
    outline: 2px solid var(--fz-gold);
    outline-offset: 3px;
  }

  .color-swatch {
    display: inline-block;
    width: 14px;
    height: 14px;
    border: 1px solid #777;
    flex-shrink: 0;
  }

  .btn-add-cart {
    justify-content: center;
    width: 100%;
    min-height: 52px;
    margin-top: 10px;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .btn-add-cart.added {
    background: #25d366;
    border-color: #25d366;
  }

  .btn-add-cart:disabled {
    background: #3a3a3a;
    border-color: #3a3a3a;
    color: #999;
    cursor: not-allowed;
  }

  .size-error {
    display: block;
    color: #ff8a8a;
    font-size: 14px;
  }

  .stock-status {
    margin: 0;
    color: #cfc8b6;
  }

  .product-meta {
    margin: 14px 0 0;
    font-size: 16px;
    color: #e9e2d2;
  }

  .related-products {
    padding-top: 56px;
    border-top: 1px solid #2e2e2e;
  }

  .related-products h2 {
    margin: 0 0 24px;
    font-size: clamp(30px, 3.4vw, 46px);
    color: #fff;
  }

  @media (max-width: 968px) {
    .product-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .product-gallery {
      position: static;
    }
  }
</style>

<script>
  import { addToCart, showToast, openCart } from "@/lib/cart";

  document.addEventListener("astro:page-load", () => {
    // Thumbnail gallery click
    document.querySelectorAll(".thumb").forEach((thumb) => {
      thumb.addEventListener("click", () => {
        document
          .querySelectorAll(".thumb")
          .forEach((t) => t.classList.remove("active"));
        thumb.classList.add("active");
      });
    });

    // Variant selection
    let selectedSize: string | null = null;
    let selectedColor: string | null = null;

    document.querySelectorAll(".size-options .variant-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        document
          .querySelectorAll(".size-options .variant-btn")
          .forEach((b) => b.classList.remove("selected"));
        btn.classList.add("selected");
        selectedSize = btn.getAttribute("data-size");
        const sizeError = document.getElementById("size-error");
        if (sizeError) sizeError.style.display = "none";
      });
    });

    document.querySelectorAll(".color-options .variant-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        document
          .querySelectorAll(".color-options .variant-btn")
          .forEach((b) => b.classList.remove("selected"));
        btn.classList.add("selected");
        selectedColor = btn.getAttribute("data-color");
      });
    });

    // Add to cart
    const addBtn = document.getElementById("add-to-cart-btn");
    const productEl = document.getElementById("product-actions");

    addBtn?.addEventListener("click", () => {
      if (!productEl) return;

      const hasSizes =
        productEl.dataset.productSizes &&
        productEl.dataset.productSizes.length > 0;

      // Validate size if product has sizes
      if (hasSizes && !selectedSize) {
        const sizeError = document.getElementById("size-error");
        if (sizeError) sizeError.style.display = "block";
        return;
      }

      // Build cart item
      const slug = productEl.dataset.productSlug || "";
      const sku = productEl.dataset.productSku || "";
      let id = slug;
      if (selectedSize) id += `-${selectedSize}`;
      if (selectedColor) id += `-${selectedColor}`;

      const item = {
        id,
        slug,
        sku,
        name: productEl.dataset.productName || "",
        price: parseInt(productEl.dataset.productPrice || "0"),
        image: productEl.dataset.productImage || "",
        size: selectedSize || undefined,
        color: selectedColor || undefined,
      };

      addToCart(item);
      showToast(`${item.name} agregado al carrito`);

      // Open cart after short delay
      setTimeout(() => openCart(), 300);

      // Success feedback
      if (addBtn) {
        const originalText = addBtn.textContent || "";
        const addedText = addBtn.dataset.addedText || "✓ ¡Agregado!";
        addBtn.textContent = addedText;
        addBtn.classList.add("added");
        setTimeout(() => {
          addBtn.textContent = originalText;
          addBtn.classList.remove("added");
        }, 2000);
      }
    });
  });
</script>
