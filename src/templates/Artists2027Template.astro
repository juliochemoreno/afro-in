---
import { artistPhoto, artistPhotoMobile } from "@/lib/artistPhotos";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import FestivalFont from "@/components/FestivalFont.astro";
import EditionCountries from "@/components/EditionCountries.astro";
import EditionHeadliner from "@/components/EditionHeadliner.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { getTranslatedPath, useTranslations } from "@/i18n/utils";
import { artistAppearances, baseSlug, dayAnchor, dayLabel, entryLang, type Lang } from "@/lib/programacion";
import { editionNav } from "@/lib/editionNav";
import heroPhoto from "@/assets/img/2017/2017-afroin-img-7.jpg";
import "@/styles/festival.css";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const t = useTranslations(lang);
const { navLinks, ctaLink } = editionNav(lang);

const stops = (await getCollection("tour2027"))
  .filter((entry) => entryLang(entry.filePath!) === lang)
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({ slug: baseSlug(entry.filePath!), name: entry.data.name, days: entry.data.days }));

const whenOf = (date: string) => {
  const label = dayLabel(date, lang);
  return `${label.weekdayShort} ${label.dayMonth}`;
};

const artists = (await getCollection("artists2027"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((artist) => ({
    ...artist.data,
    id: artist.id,
    photo: artistPhoto(artist.id, artist.data.photo),
    photoMobile: artistPhotoMobile(artist.id),
    appearances: artistAppearances(artist.id, stops).map((appearance) => ({
      ...appearance,
      when: whenOf(appearance.date),
      where: [appearance.venue, appearance.stopName].filter(Boolean).join(", "),
      href: `${getTranslatedPath(`/programacion/2027/${appearance.stopSlug}`, lang)}#${dayAnchor(appearance.date)}`,
    })),
  }));

const headliner = artists.find((artist) => artist.featured);
const others = artists.filter((artist) => !artist.featured);
const artistsText = t("edition.artistsText").replace("{n}", String(new Set(artists.map((a) => a.countryCode).filter(Boolean)).size));

---

<Layout title={t("edition.artistsMetaTitle")} description={artistsText}>
  <FestivalFont slot="head" />
  <Header navLinks={navLinks} ctaLink={ctaLink} variant="festival" />

  <main class="fz artists">
    <section class="fz-photo-hero artists-hero">
      <Image src={heroPhoto} alt="" widths={[768, 1296]} sizes="100vw" loading="eager" class="fz-photo-hero-img" />
      <div class="fz-wrap fz-photo-hero-content">
        <p class="fz-display fz-gold artists-kicker">AFRO IN 2027</p>
        <h1 class="fz-display artists-title">{t("edition.artistsTitle")}</h1>
        <p class="artists-lead">{artistsText}</p>
        <EditionCountries artists={artists} lang={lang} />
      </div>
    </section>

    {headliner && (
      <div class="artist-panel" style="--i: 0">
        <div class="fz-wrap edition-headliner">
          <EditionHeadliner artist={headliner} appearances={headliner.appearances} lang={lang} center portrait />
        </div>
      </div>
    )}

    {others.map((artist, index) => (
      <div class:list={["artist-panel", { "artist-panel--last": index === others.length - 1 }]} style={`--i: ${index + 1}`}>
        <div class="fz-wrap edition-headliner">
          <EditionHeadliner artist={artist} appearances={artist.appearances} lang={lang} star={false} reverse={index % 2 === 0} center portrait id={`artist-${artist.id}`} />
        </div>
      </div>
    ))}

  </main>

  <Footer variant="festival" />
</Layout>

<style is:global>
  /* Desktop: stacking panels. Each artist is a full-height opaque panel stuck under the header, so
     the next one slides up over it. Off on tablets and phones, on short windows (the panel's content
     must fit) and for reduced motion. The last panel is not sticky: it scrolls away normally. */
  @media (min-width: 1024px) and (min-height: 600px) and (prefers-reduced-motion: no-preference) {
    .artists .artist-panel {
      position: sticky;
      top: 80px;
      z-index: calc(var(--i) + 1);
      min-height: calc(100svh - 80px);
      display: flex;
      align-items: center;
      background: var(--fz-night);
    }

    .artists .artist-panel > .fz-wrap {
      width: 100%;
      padding-top: 0;
      padding-bottom: 0;
    }

    .artists .artist-panel--last {
      position: relative;
    }
  }

  /* Phones and tablets: each artist's photo stays pinned under the header while that artist's text
     slides up over it (sticky is scoped to the artist's own block, so photos never overlap). */
  @media (max-width: 1023px) {
    .artists .fz-headliner-media {
      aspect-ratio: auto;
      height: 55svh;
      min-height: 320px;
    }

    .artists .fz-headliner-side {
      position: relative;
      z-index: 1;
      background: var(--fz-night);
      padding-top: 8px;
    }

    /* Soft edge where the text starts, so it never sits abruptly on the bright photo. */
    .artists .fz-headliner-side::before {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: 100%;
      height: 72px;
      pointer-events: none;
      background: linear-gradient(transparent, var(--fz-night));
    }
  }

  @media (max-width: 1023px) and (prefers-reduced-motion: no-preference) {
    .artists .fz-headliner-media {
      position: sticky;
      top: 81px; /* the fixed header */
    }
  }
</style>

<style>
  .artists-hero .fz-photo-hero-content {
    padding-top: 160px;
    padding-bottom: 48px;
  }

  .artists-kicker {
    margin: 0;
    font-size: 26px;
  }

  .artists-title {
    margin: 4px 0 0;
    font-size: clamp(56px, 9vw, 128px);
    line-height: 0.95;
  }

  .artists-lead {
    margin: 20px 0 0;
    font-size: 19px;
    max-width: 56ch;
    color: var(--fz-cream);
  }

  @media (max-width: 720px) {
    .artists-hero .fz-photo-hero-content {
      padding-top: 96px;
    }

  }
</style>
