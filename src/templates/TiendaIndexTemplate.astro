---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import FestivalFont from "@/components/FestivalFont.astro";
import "@/styles/festival.css";
import { getProducts, getLocalizedProduct } from "@/lib/products";
import ProductCard from "@/components/ProductCard.astro";
import { getTranslatedPath, useTranslations } from "@/i18n/utils";

interface Props {
  lang?: string;
}

const { lang = "es" } = Astro.props;

// Read the catalog from D1 (ordered featured first, then sort_order).
const db = (Astro.locals as any).runtime?.env?.DB;
const sortedProducts = db ? await getProducts(db) : [];

// Get unique categories
const categories = [
  ...new Set(sortedProducts.map((p) => getLocalizedProduct(p, lang).category)),
];

const t = useTranslations(lang as any);
---

<Layout title="Tienda | AFRO IN">
  <FestivalFont slot="head" />
  <Header variant="festival" />
  <main class="fz store-page">
    <section class="hm-section">
      <div class="fz-wrap">
        <header class="hm-head">
          <p class="fz-display hm-kicker">{t("store.hero.badge")}</p>
          <h1 class="fz-display hm-title">{t("store.hero.title")}</h1>
          <p class="hm-sub">{t("store.hero.description")}</p>
        </header>

        <div class="store-filters" data-toast-added={t("store.toast.added")}>
          <button class="filter-btn active" data-category="all"
            >{t("store.filters.all")}</button
          >
          {
            categories.map((cat) => (
              <button class="filter-btn" data-category={cat}>
                {cat}
              </button>
            ))
          }
        </div>

        <div class="fz-product-grid">
          {
            sortedProducts.map((product) => (
              <ProductCard product={product} lang={lang as any} showQuickAdd={true} />
            ))
          }
        </div>

        <p class="store-note">
          <strong>{t("store.note.title")}</strong>
          {t("store.note.description")}
          <a class="hm-textlink" href={getTranslatedPath("/#contacto", lang)}
            >{t("store.note.contact")}</a
          >
        </p>
      </div>
    </section>
  </main>
  <Footer variant="festival" />
</Layout>

<style>
  .store-filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-bottom: 36px;
  }

  .filter-btn {
    min-height: 44px;
    padding: 0 22px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 0;
    background: transparent;
    color: #fff;
    font: inherit;
    font-weight: 600;
    text-transform: capitalize;
    cursor: pointer;
  }

  .filter-btn:hover {
    border-color: var(--fz-gold);
    color: var(--fz-gold);
  }

  .filter-btn.active {
    border-color: var(--fz-red);
    background: var(--fz-red);
    color: #fff;
  }

  .filter-btn:focus-visible {
    outline: 2px solid var(--fz-gold);
    outline-offset: 3px;
  }

  .store-note {
    max-width: 640px;
    margin: 48px auto 0;
    font-size: 15px;
    line-height: 1.55;
    text-align: center;
    color: #cfc8b6;
  }

  .store-note strong {
    color: #fff;
  }
</style>

<script>
  import { addToCart, showToast, openCart } from "@/lib/cart";

  document.addEventListener("astro:page-load", () => {
    const filterBtns = document.querySelectorAll(".filter-btn");
    const productCards = document.querySelectorAll(".product-card");

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        // Update active button
        filterBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");

        const category = btn.getAttribute("data-category");

        // Filter products
        productCards.forEach((card) => {
          if (
            category === "all" ||
            card.getAttribute("data-category") === category
          ) {
            card.classList.remove("hidden");
          } else {
            card.classList.add("hidden");
          }
        });
      });
    });

    // Quick add to cart buttons
    document.querySelectorAll(".quick-add").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();

        const button = e.currentTarget as HTMLButtonElement;
        const id = button.dataset.id || "";
        const slug = button.dataset.slug || button.dataset.id || "";
        const sku = button.dataset.sku || "";
        const name = button.dataset.name || "";
        const price = parseInt(button.dataset.price || "0");
        const image = button.dataset.image || "";

        addToCart({ id, slug, sku, name, price, image });

        // Get translated toast message
        const filtersEl = document.querySelector(".store-filters");
        const toastTemplate =
          filtersEl?.getAttribute("data-toast-added") || "{name} added to cart";
        showToast(toastTemplate.replace("{name}", name));

        // Open cart after a short delay
        setTimeout(() => openCart(), 300);
      });
    });
  });
</script>
