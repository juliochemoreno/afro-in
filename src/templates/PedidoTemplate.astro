---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import FestivalFont from "@/components/FestivalFont.astro";
import "@/styles/festival.css";
import OrderReceipt from "@/components/OrderReceipt";
import { getTranslatedPath, useTranslations } from "@/i18n/utils";

interface Props {
  lang?: string;
}
const { lang = "es" } = Astro.props;
const t = useTranslations(lang as any);

const OK_KEYS = [
  "order.loading",
  "order.success.title",
  "order.success.text",
  "order.pending.title",
  "order.pending.text",
  "order.failed.title",
  "order.failed.text",
  "order.number",
  "order.total",
  "order.continue",
];
const strings = Object.fromEntries(OK_KEYS.map((k) => [k, t(k as any)]));
const storePath = getTranslatedPath("/tienda", lang);
---

<Layout title={`${t("order.success.title")} | AFRO IN`}>
  <FestivalFont slot="head" />
  <Header variant="festival" />

  <main class="fz pedido-page">
    <div class="fz-wrap">
      <OrderReceipt client:only="react" t={strings} storePath={storePath} />
    </div>
  </main>

  <Footer variant="festival" />
</Layout>

<style is:global>
  .pedido-page {
    min-height: 70vh;
    padding-top: 128px;
    padding-bottom: 88px;
  }
  .pedido-page .fz-wrap {
    max-width: 656px;
  }

  .receipt {
    background: #222;
    border: 1px solid #2e2e2e;
    padding: 40px 32px;
    text-align: center;
  }
  .receipt h1 {
    margin: 0 0 12px;
    font-family: "Anton", var(--font-heading), sans-serif;
    font-weight: 400;
    font-size: clamp(34px, 5vw, 48px);
    line-height: 1.05;
    color: #fff;
  }
  .receipt-text {
    margin: 0 0 28px;
    font-size: 18px;
    line-height: 1.55;
    color: #e9e2d2;
  }
  .receipt-badge {
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    margin: 0 auto 20px;
    color: #fff;
  }
  .receipt-badge.ok {
    background: #16a34a;
  }
  .receipt-badge.pending {
    background: #d97706;
  }
  .receipt-badge.fail {
    background: var(--fz-red);
  }

  .receipt-card {
    text-align: left;
    background: #161616;
    border: 1px solid #2e2e2e;
    padding: 16px 20px;
    margin-bottom: 28px;
  }
  .receipt-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #fff;
  }
  .receipt-items {
    list-style: none;
    margin: 12px 0;
    padding: 12px 0;
    border-top: 1px solid #3a3a3a;
    border-bottom: 1px solid #3a3a3a;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .receipt-items li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 15px;
    color: #e9e2d2;
  }
  .receipt-total {
    margin-top: 12px;
    font-size: 18px;
  }
  .receipt-total strong {
    color: var(--fz-gold);
    font-size: 26px;
    font-weight: 600;
  }

  .receipt .fz-button {
    justify-content: center;
    min-height: 52px;
    text-decoration: none;
  }

  .receipt-status {
    text-align: center;
    padding: 48px;
    color: #cfc8b6;
  }
  .receipt-spinner {
    width: 38px;
    height: 38px;
    margin: 0 auto 16px;
    border: 3px solid #3a3a3a;
    border-top-color: var(--fz-red);
    border-radius: 50%;
    animation: receipt-spin 0.8s linear infinite;
  }
  @keyframes receipt-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
