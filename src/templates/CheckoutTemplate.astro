---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import FestivalFont from "@/components/FestivalFont.astro";
import "@/styles/festival.css";
import CheckoutForm from "@/components/CheckoutForm";
import "@/styles/checkout-fields.css";
import { countries } from "@/data/countries";
import { getTranslatedPath, useTranslations } from "@/i18n/utils";

interface Props {
  lang?: string;
}
const { lang = "es" } = Astro.props;
const t = useTranslations(lang as any);

// Plain strings object for the React island.
const CK_KEYS = [
  "checkout.contact.title",
  "checkout.name",
  "checkout.name.ph",
  "checkout.email",
  "checkout.email.ph",
  "checkout.phone",
  "checkout.phone.ph",
  "checkout.country",
  "checkout.shipping.title",
  "checkout.department",
  "checkout.department.ph",
  "checkout.city",
  "checkout.city.ph",
  "checkout.address",
  "checkout.address.ph",
  "checkout.notes",
  "checkout.notes.ph",
  "checkout.summary.title",
  "checkout.total",
  "checkout.pay",
  "checkout.securenote",
  "checkout.empty.title",
  "checkout.empty.cta",
  "checkout.processing",
  "checkout.err.name",
  "checkout.err.email",
  "checkout.err.city",
  "checkout.err.address",
  "checkout.err.generic",
  "checkout.err.country",
  "checkout.err.department",
  "checkout.department.select",
  "checkout.state.select",
  "checkout.city.select",
  "checkout.city.pickDepartmentFirst",
  "checkout.list.search",
  "checkout.list.empty",
  "phone.err",
  "phone.ph",
  "phone.dial.label",
  "phone.dial.search",
  "phone.dial.empty",
];
const strings = Object.fromEntries(CK_KEYS.map((k) => [k, t(k as any)]));

const countryStrings = {
  placeholder: t("join.form.country.select"),
  search: t("join.country.search"),
  empty: t("join.country.error"),
};

const successPath = getTranslatedPath("/pedido", lang);
const storePath = getTranslatedPath("/tienda", lang);
---

<Layout title={`${t("checkout.title")} | AFRO IN`}>
  <FestivalFont slot="head" />
  <Header variant="festival" />

  <main class="fz checkout-page">
    <div class="fz-wrap">
      <header class="hm-head">
        <h1 class="fz-display hm-title">{t("checkout.title")}</h1>
        <p class="hm-sub">{t("checkout.subtitle")}</p>
      </header>

      <CheckoutForm
        client:only="react"
        lang={lang as any}
        countries={countries}
        successPath={successPath}
        storePath={storePath}
        countryStrings={countryStrings}
        t={strings}
      />
    </div>
  </main>

  <Footer variant="festival" />
</Layout>

<style is:global>
  .checkout-page {
    min-height: 70vh;
    padding-bottom: 88px;
  }
  .checkout-page .hm-head {
    padding-top: 40px;
    margin-bottom: 36px;
  }

  .checkout-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }
  @media (max-width: 880px) {
    .checkout-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .checkout-main {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .checkout-card {
    /* Fieldsets default to min-inline-size: min-content, which lets long
       combobox labels push the card over the order summary. */
    min-inline-size: 0;
    margin: 0;
    background: #222;
    border: 1px solid #2e2e2e;
    border-radius: 0;
    padding: 24px;
  }
  .checkout-card legend {
    font-family: "Anton", var(--font-heading), sans-serif;
    font-weight: 400;
    font-size: 24px;
    color: #fff;
    padding: 0 8px;
  }

  .ck-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  @media (max-width: 520px) {
    .ck-row {
      grid-template-columns: 1fr;
    }
  }

  .ck-field {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
  }
  .checkout-page .ck-field > label {
    font-weight: 600;
    font-size: 14px;
    margin-bottom: 6px;
    color: #fff;
  }
  .checkout-page .ck-field input,
  .checkout-page .ck-field textarea {
    width: 100%;
    box-sizing: border-box;
    min-height: 48px;
    padding: 12px 14px;
    border: 1px solid #3a3a3a;
    border-radius: 0;
    font-family: inherit;
    font-size: 16px;
    background: #161616;
    color: #fff;
  }
  .checkout-page .hm-input-icon input,
  .checkout-page .hm-input-icon textarea {
    padding-left: 44px;
  }
  .checkout-page .ck-field textarea {
    resize: vertical;
  }
  .checkout-page .ck-field input::placeholder,
  .checkout-page .ck-field textarea::placeholder {
    color: #8f8878;
  }
  .checkout-page .ck-field input:focus,
  .checkout-page .ck-field textarea:focus,
  .checkout-page .ph-field:focus-within,
  .checkout-page .cc-trigger:focus-visible,
  .checkout-page .cc-trigger[aria-expanded="true"] {
    outline: none;
    border-color: var(--fz-gold);
    box-shadow: 0 0 0 3px rgba(242, 193, 78, 0.25);
  }
  .checkout-page .cc-trigger {
    border: 1px solid #3a3a3a;
    border-radius: 0;
    background: #161616;
    color: #fff;
  }
  .checkout-page .cc-trigger:hover {
    border-color: var(--fz-gold);
  }
  .checkout-page .cc-trigger:disabled {
    background: #1b1b1b;
    border-color: #2e2e2e;
    color: #777;
  }
  .checkout-page .cc-trigger .cc-placeholder {
    color: #8f8878;
  }
  .checkout-page .ph-field {
    border: 1px solid #3a3a3a;
    border-radius: 0;
    background: #161616;
  }
  .checkout-page .ph-field .cc-trigger.ph-dial {
    background: transparent;
    color: #fff;
    border-right: 1px solid #3a3a3a;
    border-radius: 0;
  }
  .checkout-page .ph-field .cc-trigger.ph-dial:hover,
  .checkout-page .ph-field .cc-trigger.ph-dial[aria-expanded="true"] {
    background: #2a2a2a;
  }
  .checkout-page .ck-field .ph-field input.ph-number {
    min-height: 46px;
    border: none;
    background: transparent;
    color: #fff;
    box-shadow: none;
  }
  .checkout-page .ck-field.is-invalid input:not([type="hidden"]):not(.ph-number),
  .checkout-page .is-invalid .ph-field,
  .checkout-page .is-invalid .cc-trigger {
    border-color: #ff8a8a;
    background-color: rgba(227, 28, 37, 0.1);
  }
  .checkout-page .ck-field-error {
    margin: 6px 0 0;
    color: #ff8a8a;
    font-weight: 500;
  }

  .checkout-summary {
    background: #222;
    border: 1px solid #2e2e2e;
    padding: 24px;
    position: sticky;
    top: 100px;
  }
  .checkout-summary h3 {
    margin: 0 0 16px;
    font-family: "Anton", var(--font-heading), sans-serif;
    font-weight: 400;
    font-size: 24px;
    color: #fff;
  }
  .ck-items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0 0 16px;
    padding: 0;
  }
  .ck-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ck-item-img {
    width: 56px;
    height: 56px;
    object-fit: contain;
    flex-shrink: 0;
    background: #fff;
  }
  .ck-item-info {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }
  .ck-item-name {
    font-weight: 600;
    font-size: 15px;
    color: #fff;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ck-item-meta {
    font-size: 13px;
    color: #cfc8b6;
  }
  .ck-item-price {
    font-weight: 600;
    font-size: 15px;
    color: var(--fz-gold);
    white-space: nowrap;
  }
  .ck-total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-top: 16px;
    border-top: 1px solid #3a3a3a;
    font-size: 18px;
    font-weight: 600;
    color: #fff;
  }
  .ck-total strong {
    color: var(--fz-gold);
    font-size: 28px;
    font-weight: 600;
  }
  .ck-pay {
    justify-content: center;
    width: 100%;
    margin-top: 16px;
    min-height: 52px;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .ck-pay:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .ck-secure {
    text-align: center;
    font-size: 13px;
    color: #cfc8b6;
    margin: 12px 0 0;
  }
  .ck-error {
    margin: 12px 0 0;
    color: #ff8a8a;
    font-size: 15px;
    font-weight: 600;
  }
  .checkout-empty {
    text-align: center;
    padding: 48px 0;
  }
  .checkout-empty p {
    color: #cfc8b6;
    margin-bottom: 16px;
  }
  .checkout-loading {
    text-align: center;
    padding: 48px;
    color: #cfc8b6;
  }
</style>
