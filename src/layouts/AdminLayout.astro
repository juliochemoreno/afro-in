---
// Admin shell: fixed sidebar + dark-mode aware. Loads Tailwind v4 + shadcn
// tokens (global.css) without the public site's reset. Uses semantic color
// tokens (bg-background/bg-card/bg-sidebar/...) so light & dark both work.
import "@/styles/global.css";
import afroinLogo from "@/assets/img/logos/afroin.png";
import LayoutDashboard from "lucide-astro/LayoutDashboard";
import Users from "lucide-astro/Users";
import Package from "lucide-astro/Package";
import ShoppingBag from "lucide-astro/ShoppingBag";
import Tags from "lucide-astro/Tags";
import CalendarDays from "lucide-astro/CalendarDays";
import ScanLine from "lucide-astro/ScanLine";
import ShieldCheck from "lucide-astro/ShieldCheck";
import LogOut from "lucide-astro/LogOut";
import Sun from "lucide-astro/Sun";
import Moon from "lucide-astro/Moon";
import Menu from "lucide-astro/Menu";
import X from "lucide-astro/X";

interface Props {
  title?: string;
}
const { title = "Admin | AFRO IN" } = Astro.props;

const path = Astro.url.pathname;
// Grouped menu (Julio): events, store and community apart; "Puerta" is the
// door scanner used from the phone on event days.
const navGroups = [
  { label: null, items: [{ href: "/admin", label: "Resumen", icon: LayoutDashboard }] },
  {
    label: "Eventos",
    items: [
      { href: "/admin/eventos", label: "Eventos", icon: CalendarDays },
      { href: "/admin/checkin", label: "Puerta", icon: ScanLine },
    ],
  },
  {
    label: "Tienda",
    items: [
      { href: "/admin/productos", label: "Productos", icon: Package },
      { href: "/admin/pedidos", label: "Pedidos", icon: ShoppingBag },
      { href: "/admin/atributos", label: "Atributos", icon: Tags },
    ],
  },
  { label: "Comunidad", items: [{ href: "/admin/donadores", label: "Aportes", icon: Users }] },
  { label: "Ajustes", items: [{ href: "/admin/administradores", label: "Administradores", icon: ShieldCheck }] },
];
const isActive = (href: string) =>
  href === "/admin"
    ? path === "/admin" || path === "/admin/"
    : path.startsWith(href);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <style is:global>
      /* Let client:only islands participate in the parent flex/height chain so
         full-height grids can fill the content area. */
      astro-island {
        display: contents;
      }
    </style>
    <script is:inline>
      // Pre-paint: apply saved theme before first paint to avoid a flash.
      (function () {
        try {
          var t = localStorage.getItem("admin-theme");
          var prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)"
          ).matches;
          if (t === "dark" || (!t && prefersDark)) {
            document.documentElement.classList.add("dark");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body
    class="bg-background text-foreground min-h-dvh overflow-x-hidden lg:h-dvh lg:overflow-hidden antialiased"
    style="font-family: 'Inter', system-ui, sans-serif;"
  >
    <div class="flex min-h-dvh lg:h-full">
      <!-- Sidebar (desktop) -->
      <aside
        class="bg-sidebar border-sidebar-border hidden h-full w-60 shrink-0 flex-col border-r lg:flex"
      >
        <div class="border-sidebar-border flex h-16 items-center gap-2 border-b px-5">
          <img src={afroinLogo.src} alt="AFRO IN" class="h-7 w-auto" loading="eager" />
          <span class="text-muted-foreground text-xs font-semibold">Admin</span>
        </div>
        <nav class="flex-1 space-y-4 overflow-y-auto p-3">
          {
            navGroups.map((group) => (
              <div class="space-y-1">
                {group.label && (
                  <p class="text-muted-foreground/70 px-3 pb-1 text-[11px] font-semibold tracking-wider uppercase">
                    {group.label}
                  </p>
                )}
                {group.items.map((item) => (
                  <a
                    href={item.href}
                    class:list={[
                      "flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors",
                      isActive(item.href)
                        ? "bg-primary/10 text-primary"
                        : "text-muted-foreground hover:bg-sidebar-accent hover:text-foreground",
                    ]}
                  >
                    <item.icon size={18} />
                    {item.label}
                  </a>
                ))}
              </div>
            ))
          }
        </nav>
        <div class="border-sidebar-border space-y-1 border-t p-3">
          <button
            id="theme-toggle"
            type="button"
            class="text-muted-foreground hover:bg-sidebar-accent hover:text-foreground flex w-full items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors"
          >
            <Moon size={18} class="dark:hidden" />
            <Sun size={18} class="hidden dark:block" />
            <span class="dark:hidden">Modo oscuro</span>
            <span class="hidden dark:block">Modo claro</span>
          </button>
          <a
            href="/api/admin-logout"
            class="text-muted-foreground hover:bg-sidebar-accent hover:text-foreground flex w-full items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors"
          >
            <LogOut size={18} /> Salir
          </a>
        </div>
      </aside>

      <!-- Content -->
      <div class="flex min-w-0 flex-1 flex-col lg:h-full lg:overflow-hidden">
        <!-- Mobile top bar -->
        <header
          class="border-border bg-background/85 sticky top-0 z-30 flex items-center justify-between gap-3 border-b px-4 py-3 backdrop-blur-md lg:hidden"
        >
          <img src={afroinLogo.src} alt="AFRO IN" class="h-7 w-auto" />
          {/* The door scanner always one tap away on the phone. */}
          <a
            href="/admin/checkin"
            class:list={[
              "ml-auto flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-semibold",
              isActive("/admin/checkin") ? "bg-primary text-primary-foreground" : "bg-primary/10 text-primary",
            ]}
          >
            <ScanLine size={18} /> Puerta
          </a>
          <button
            id="mobile-menu-toggle"
            type="button"
            class="text-foreground -mr-1 p-1.5"
            aria-label="Menú"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <Menu id="mm-icon-open" size={24} />
            <X id="mm-icon-close" size={24} class="hidden" />
          </button>

          <!-- Collapsible menu (drops down from the sticky header) -->
          <div
            id="mobile-menu"
            class="border-border bg-background absolute inset-x-0 top-full hidden border-b shadow-lg"
          >
            <nav class="max-h-[75vh] space-y-3 overflow-y-auto p-3">
              {
                navGroups.map((group) => (
                  <div class="space-y-1">
                    {group.label && (
                      <p class="text-muted-foreground/70 px-3 pb-1 text-[11px] font-semibold tracking-wider uppercase">
                        {group.label}
                      </p>
                    )}
                    {group.items.map((item) => (
                      <a
                        href={item.href}
                        class:list={[
                          "flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium",
                          isActive(item.href)
                            ? "bg-primary/10 text-primary"
                            : "text-muted-foreground",
                        ]}
                      >
                        <item.icon size={18} />
                        {item.label}
                      </a>
                    ))}
                  </div>
                ))
              }
              <div class="border-border my-1 border-t"></div>
              <button
                id="theme-toggle-mobile"
                type="button"
                class="text-muted-foreground flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium"
              >
                <Moon size={18} class="dark:hidden" />
                <Sun size={18} class="hidden dark:block" />
                <span class="dark:hidden">Modo oscuro</span>
                <span class="hidden dark:block">Modo claro</span>
              </button>
              <a
                href="/api/admin-logout"
                class="text-muted-foreground flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium"
              >
                <LogOut size={18} /> Salir
              </a>
            </nav>
          </div>
        </header>

        <div class="flex-1 lg:min-h-0 lg:overflow-hidden"><slot /></div>
      </div>
    </div>

    <script is:inline>
      function toggleTheme() {
        var isDark = document.documentElement.classList.toggle("dark");
        try {
          localStorage.setItem("admin-theme", isDark ? "dark" : "light");
        } catch (e) {}
      }
      document
        .getElementById("theme-toggle")
        ?.addEventListener("click", toggleTheme);
      document
        .getElementById("theme-toggle-mobile")
        ?.addEventListener("click", toggleTheme);

      // Collapsible mobile menu
      (function () {
        var mt = document.getElementById("mobile-menu-toggle");
        var mm = document.getElementById("mobile-menu");
        var oi = document.getElementById("mm-icon-open");
        var ci = document.getElementById("mm-icon-close");
        if (!mt || !mm) return;
        function setOpen(open) {
          mm.classList.toggle("hidden", !open);
          if (oi) oi.classList.toggle("hidden", open);
          if (ci) ci.classList.toggle("hidden", !open);
          mt.setAttribute("aria-expanded", String(open));
        }
        mt.addEventListener("click", function (e) {
          e.stopPropagation();
          setOpen(mm.classList.contains("hidden"));
        });
        document.addEventListener("click", function (e) {
          if (
            !mm.classList.contains("hidden") &&
            !mm.contains(e.target) &&
            !mt.contains(e.target)
          ) {
            setOpen(false);
          }
        });
      })();
    </script>
  </body>
</html>
