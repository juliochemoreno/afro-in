---
// Door shell (D26): full screen, always dark, installable as an app (PWA).
// Used by the check-in screen on every host and by the login page on the
// door host (checkin.afroin.org). Loads Tailwind (global.css) without the
// admin chrome.
import "@/styles/global.css";

interface Props {
  title?: string;
}
const { title = "Puerta | AFRO IN" } = Astro.props;
const fonts =
  "https://fonts.googleapis.com/css2?family=Anton&family=Outfit:wght@400;600;700;800&display=swap";
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#161616" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Puerta" />
    <link rel="manifest" href="/checkin.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/checkin-180.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />
    <title>{title}</title>
    <style is:global>
      astro-island {
        display: contents;
      }
      .door-display {
        font-family: "Anton", "Outfit", sans-serif;
        letter-spacing: 0.01em;
      }
    </style>
  </head>
  <body
    class="h-dvh overflow-hidden antialiased"
    style="background: #161616; color: #f3e9d2; font-family: 'Outfit', system-ui, sans-serif;"
  >
    <slot />
    <script is:inline>
      // The service worker only caches the app shell; scans always hit the server.
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker
          .register("/checkin-sw.js", { scope: "/admin/checkin" })
          .catch(function () {});
      }
    </script>
  </body>
</html>
