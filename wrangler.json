{
  "name": "afro-in",
  "account_id": "5d061cd2e8e41dd336d678070802ffaf",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afroin",
      "database_id": "1a752558-2271-40d7-8553-28f7a622eb20"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "afroin-media"
    }
  ],
  "preview_urls": true,
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "afroin-preview",
        "database_id": "e41ea281-e1e4-49b8-90f3-893fbf9463c1"
      }
    ],
    "r2_buckets": [
      {
        "binding": "MEDIA",
        "bucket_name": "afroin-media-preview"
      }
    ]
  }
}